{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/defs.schema.json",
 "title": "Gemeinsame Bausteine (SCHNITTSTELLEN.md §1, §16.2)",
 "$defs": {
  "material_id": {"description": "§1.4: 16 Hex-Zeichen, Kleinbuchstaben", "type": "string", "pattern": "^[0-9a-f]{16}$"},
  "plan_id": {"description": "§1.4 plan", "type": "string", "pattern": "^[a-z0-9_-]{1,24}$"},
  "hs_id": {"description": "§1.4 hs_id", "type": "string", "pattern": "^[a-z0-9_-]{1,24}$"},
  "auftrag_id": {"description": "§1.4 auftrag_id", "type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
  "kurz_id": {"description": "Wahl, Vorschlag, Urteil, Zug (§14.2, §14.3, §14.9, §9.3); Form wie auftrag_id", "type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
  "quelle": {"description": "§1.4", "enum": ["andreas", "cypher", "leitstand", "erzeuger", "werkstatt", "pruefstand"]},
  "kanal": {"description": "§1.5", "type": "string", "pattern": "^(deck/[1-4]|erz/[1-8]|pad/[12]|bus/[1-4]|master|cue)$"},
  "hoer_kanal": {"description": "§4.5: Kanäle mit Hörschein", "type": "string", "pattern": "^(deck/[1-4]|erz/[1-8]|pad/[12])$"},
  "deck_nr": {"type": "integer", "minimum": 1, "maximum": 4},
  "regler_pfad": {
   "description": "§1.5 Regler-Pfade (ein Bus hat keinen ziel-Regler; rueckkopplung nur fx/1, fx/2)",
   "type": "string",
   "pattern": "^((deck/[1-4]|erz/[1-8]|pad/[12])/(fader|trim|eq/(tief|mitte|hoch)|kill/(tief|mitte|hoch)|filter|send/[1-4]|ziel|xseite|pfl)|bus/[1-4]/(fader|trim|eq/(tief|mitte|hoch)|kill/(tief|mitte|hoch)|filter|send/[1-4]|xseite|pfl)|deck/[1-4]/stem/(drums|bass|vocals|other)|duck/(tiefe|release)|keylock|xfader|master/(pegel|kleber)|cue/(mix|pegel|split)|fx/[12]/(notenwert|rueckkopplung)|fx/[1-4]/rueckweg)$"
  },
  "fassung_name": {"description": "§4.5, §13.1: <bpm·1000>_r<n>", "type": "string", "pattern": "^[1-9][0-9]*_r[1-9][0-9]*$"},
  "inhalt": {"description": "§4.5: Deck <material_id>/<bpm·1000>_r<n>, Pad .../s<nr>, Erzeuger muster/<m>", "type": "string",
   "pattern": "^([0-9a-f]{16}/[1-9][0-9]*_r[1-9][0-9]*(/s[1-9][0-9]*)?|muster/[0-9]+)$"},
  "hoerschein_feld": {"description": "§4.3 Feld 12, §4.4: \"\", eine hs_id oder annahme:<vorschlag_id>", "type": "string",
   "pattern": "^(|[a-z0-9_-]{1,24}|annahme:[a-z0-9_-]{1,32})$"},
  "gruppe": {"description": "§4.3 Feld 11: Kopplungsgruppe oder \"\"", "type": "string", "pattern": "^[a-z0-9_-]{0,24}$"},
  "beat": {"description": "§1.1: Viertel seit Beat 0 der Zeitachse", "type": "number"},
  "dauer_beats": {"description": "§1.1", "type": "number", "minimum": 0},
  "sample": {"description": "§1.1 int64", "type": "integer"},
  "bpm": {"type": "number", "exclusiveMinimum": 0},
  "db": {"description": "§1.2: stumm = -200", "type": "number", "minimum": -200},
  "anteil": {"type": "number", "minimum": 0, "maximum": 1},
  "camelot": {"type": "string", "pattern": "^(1[0-2]|[1-9])[AB]$"},
  "zeit_iso": {"description": "ISO 8601 wie im Beispiel §13.3 (Zeitzone optional)", "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "baender_db": {"description": "§6.2, §14.8: sechs Bänder in dB, Reihenfolge sub, tief, tiefmitte, mitte, praesenz, hoch",
   "type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
  "ueberdeckung": {"description": "§14.6, §14.8: je Band 0 bis 1 (null: Band ohne Anteil)", "type": "object",
   "required": ["sub", "tief", "tiefmitte", "mitte", "praesenz", "hoch"],
   "properties": {"sub": {"$ref": "#/$defs/anteil_oder_null"}, "tief": {"$ref": "#/$defs/anteil_oder_null"},
    "tiefmitte": {"$ref": "#/$defs/anteil_oder_null"}, "mitte": {"$ref": "#/$defs/anteil_oder_null"},
    "praesenz": {"$ref": "#/$defs/anteil_oder_null"}, "hoch": {"$ref": "#/$defs/anteil_oder_null"}}},
  "anteil_oder_null": {"anyOf": [{"$ref": "#/$defs/anteil"}, {"type": "null"}]},
  "zahl_oder_null": {"type": ["number", "null"]},
  "grund": {
   "description": "§16.2 Codes; dazu \"neustart\" aus §16.3 (teil_abgebrochen nach Kern-Neustart, fehlt in der Tabelle §16.2)",
   "enum": ["zu_spaet", "regler_beim_menschen", "regler_verplant", "ueberlappung", "nur_hand", "unbekannter_regler",
    "unbekanntes_deck", "ausserhalb_bereich", "kein_hoerschein", "hoerschein_anderer_kanal", "hoerschein_anderer_inhalt",
    "hoerschein_anderes_tempo", "hoerschein_abgelaufen", "hoerschein_anderer_abschnitt", "ziel_ungehoert", "keine_stems",
    "hoerschein_nicht_sync", "hoerschein_pegel", "invariante_sub_doppelt", "invariante_master_leer", "deck_beruehrt",
    "deck_hoerbar", "deck_laeuft", "nicht_geladen", "material_fehlt", "pruefung", "budget_speicher", "budget_stretcher",
    "karte_voll", "ki_gestoppt", "rechner_fehlt", "kein_stretcher", "autonomie", "form", "hand", "abbruch", "ki_stopp",
    "unbekannte_adresse", "falsche_typen", "protokoll", "neustart", "grenze_sub"]
  },
  "zeit": {"description": "§9.1 zeit: Kern-Zeitpunkt", "type": "object", "required": ["sample", "beat", "takt", "phrase"],
   "properties": {"sample": {"$ref": "#/$defs/sample"}, "beat": {"$ref": "#/$defs/beat"},
    "takt": {"type": "integer", "minimum": 1}, "phrase": {"type": "integer", "minimum": 1}}},
  "tore": {
   "description": "§13.2 fassung.json tore; §12.2 material_fertig tore",
   "type": "object", "required": ["raster", "headroom", "klarheit", "streckfaktor", "eins"],
   "properties": {
    "raster": {"type": "object", "required": ["ok", "wert_ms", "grenze_ms", "anschlaege"],
     "properties": {"ok": {"type": "boolean"}, "wert_ms": {"type": ["number", "null"]}, "grenze_ms": {"type": "number"}, "anschlaege": {"type": "integer", "minimum": 0}}},
    "headroom": {"type": "object", "required": ["ok", "wert_dbtp", "grenze_dbtp"],
     "properties": {"ok": {"type": "boolean"}, "wert_dbtp": {"type": "number"}, "grenze_dbtp": {"type": "number"}}},
    "klarheit": {"type": "object", "required": ["ok", "wert", "grenze"],
     "properties": {"ok": {"type": "boolean"}, "wert": {"type": "number"}, "grenze": {"type": "number"}}},
    "streckfaktor": {"type": "object", "required": ["ok", "wert", "grenze"],
     "properties": {"ok": {"type": "boolean"}, "wert": {"type": "number"}, "grenze": {"type": "number"}}},
    "eins": {"type": "object", "required": ["ok", "beat_this", "zweitverfahren"],
     "properties": {"ok": {"type": "boolean"}, "beat_this": {"type": ["integer", "null"]}, "zweitverfahren": {"type": ["integer", "null"]}}}
   }
  }
 }
}
