{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/mcp.schema.json",
 "title": "MCP-Werkzeuge für Cypher (SCHNITTSTELLEN.md §10); Pflicht = Felder ohne ? in der Signatur",
 "$defs": {
  "jetzt": {"description": "§10: jede Rückgabe enthält jetzt", "type": "object", "required": ["takt", "schlag", "beat", "seq"],
   "properties": {"takt": {"type": "integer", "minimum": 1}, "schlag": {"type": "integer", "minimum": 1, "maximum": 4},
    "beat": {"$ref": "defs.schema.json#/$defs/beat"}, "seq": {"type": "integer", "minimum": 0}}},
  "mit_jetzt": {"type": "object", "required": ["jetzt"], "properties": {"jetzt": {"$ref": "#/$defs/jetzt"}}},
  "lage_eingabe": {"type": "object"},
  "warte_eingabe": {"type": "object", "required": ["max_s"],
   "properties": {"bis_takt": {"type": "integer", "minimum": 1},
    "auf": {"type": "array", "items": {"$ref": "ws_daten.schema.json#/$defs/ereignis/properties/art"}},
    "max_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 30}}},
  "waehle_eingabe": {"type": "object", "required": ["material_id", "spielart", "start_takt", "hoerschein"],
   "properties": {"material_id": {"$ref": "defs.schema.json#/$defs/material_id"}, "spielart": {"type": "string", "minLength": 1},
    "start_takt": {"type": "integer", "minimum": 1}, "hoerschein": {"$ref": "defs.schema.json#/$defs/hs_id"},
    "einstieg_quell_beat": {"type": "number", "minimum": 0}, "deck": {"$ref": "defs.schema.json#/$defs/deck_nr"},
    "laenge_takte": {"type": "integer", "minimum": 1}, "absicht": {"type": "string", "maxLength": 200}}},
  "waehle_ergebnis": {"description": "Rückgabe von waehle und plan_einreichen ohne jetzt", "type": "object",
   "required": ["status", "plan_id", "gruende", "vorhersage", "ansage"],
   "properties": {"status": {"enum": ["angenommen", "vorgeschlagen", "verriegelt", "abgelehnt"]},
    "plan_id": {"$ref": "defs.schema.json#/$defs/plan_id"},
    "gruende": {"type": "array", "items": {"type": "object", "required": ["teil", "grund"],
     "properties": {"teil": {"type": "integer", "minimum": 0}, "grund": {"$ref": "defs.schema.json#/$defs/grund"}}}},
    "vorhersage": {"$ref": "kandidat.schema.json#/$defs/vorhersage_kurz"},
    "ansage": {"type": "string"}}},
  "waehle_rueckgabe": {"allOf": [{"$ref": "#/$defs/waehle_ergebnis"}, {"$ref": "#/$defs/mit_jetzt"}]},
  "plan_einreichen_eingabe": {"type": "object", "required": ["grund", "teile"],
   "properties": {"spielart": {"type": "string"}, "hoerschein": {"$ref": "defs.schema.json#/$defs/hs_id"}, "grund": {"type": "string"},
    "teile": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["regler", "art", "ab_takt", "nach"],
     "properties": {"regler": {"$ref": "defs.schema.json#/$defs/regler_pfad"}, "art": {"enum": ["rampe", "setze"]},
      "ab_takt": {"type": "integer", "minimum": 1}, "ab_schlag": {"type": "integer", "minimum": 1, "maximum": 4},
      "dauer_takte": {"type": "number", "exclusiveMinimum": 0}, "nach": {"type": "number"}}}}}},
  "plan_abbrechen_eingabe": {"type": "object", "required": ["plan_id"],
   "properties": {"plan_id": {"$ref": "defs.schema.json#/$defs/plan_id"}, "teile": {"type": "array", "items": {"type": "integer", "minimum": 0}}}},
  "laden_eingabe": {"type": "object", "required": ["deck", "material_id"],
   "properties": {"deck": {"$ref": "defs.schema.json#/$defs/deck_nr"}, "material_id": {"$ref": "defs.schema.json#/$defs/material_id"}}},
  "vorhoeren_eingabe": {"oneOf": [
   {"type": "object", "required": ["deck"], "not": {"required": ["pad"]},
    "properties": {"deck": {"$ref": "defs.schema.json#/$defs/deck_nr"}, "ab_takt": {"type": "integer", "minimum": 1}, "einstieg_quell_beat": {"type": "number", "minimum": 0}}},
   {"type": "object", "required": ["pad", "material_id", "schuss_nr"], "not": {"required": ["deck"]},
    "properties": {"pad": {"enum": [1, 2]}, "material_id": {"$ref": "defs.schema.json#/$defs/material_id"}, "schuss_nr": {"type": "integer", "minimum": 1}}}]},
  "bestand_eingabe": {"type": "object", "required": ["max"],
   "properties": {"filter": {"type": "object", "properties": {"camelot": {"$ref": "defs.schema.json#/$defs/camelot"},
     "bpm_von": {"type": "number"}, "bpm_bis": {"type": "number"}, "frisch_seit_min": {"type": "number", "minimum": 0}, "nur_tore_ok": {"type": "boolean"}}},
    "max": {"type": "integer", "minimum": 1, "maximum": 20}}},
  "passung_eingabe": {"type": "object", "required": ["a", "b"],
   "properties": {"a": {"$ref": "defs.schema.json#/$defs/material_id"}, "b": {"$ref": "defs.schema.json#/$defs/material_id"}}},
  "erzeuge_eingabe": {"type": "object", "required": ["stil", "text", "dauer_s", "ziel_bpm"],
   "properties": {"stil": {"type": "string"}, "text": {"type": "string"}, "dauer_s": {"type": "integer", "minimum": 1},
    "ziel_bpm": {"$ref": "defs.schema.json#/$defs/bpm"}, "tonart": {"type": "string"}, "anzahl": {"type": "integer", "minimum": 1, "maximum": 4}}},
  "erzeuge_ergebnis": {"type": "object", "required": ["auftrag_id", "erwartet_fertig_takt"],
   "properties": {"auftrag_id": {"$ref": "defs.schema.json#/$defs/auftrag_id"}, "erwartet_fertig_takt": {"type": "integer"}}},
  "spielzettel_eingabe": {"type": "object", "required": ["zeilen"], "properties": {"zeilen": {"type": "string"}}},
  "markieren_eingabe": {"type": "object", "required": ["text", "art"],
   "properties": {"text": {"type": "string"}, "art": {"enum": ["absicht", "hypothese", "urteil_erbeten"]}}}
 }
}
