{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/fassung.schema.json",
 "title": "fassung.json, Schema-Version 1 (SCHNITTSTELLEN.md §13.2); analyse_quelle = stems genau dann, wenn stems nicht leer ist (§13.1)",
 "type": "object",
 "required": ["schema", "material_id", "basis_bpm", "fassung", "korrekturen_bis_zeile", "datei", "frames", "sha256", "erster_schlag_frame",
  "beats", "erste_eins_quell_beat", "analyse_quelle", "stems", "schuesse", "headroom_db", "stimmung_korrektur_cent", "lautheit", "struktur",
  "hotcues", "loops", "tore", "nur_fuer_andreas", "warnungen"],
 "properties": {
  "schema": {"const": 1},
  "material_id": {"$ref": "defs.schema.json#/$defs/material_id"},
  "basis_bpm": {"$ref": "defs.schema.json#/$defs/bpm"},
  "fassung": {"type": "integer", "minimum": 1},
  "korrekturen_bis_zeile": {"type": "integer", "minimum": 0},
  "datei": {"type": "string", "minLength": 1},
  "frames": {"type": "integer", "minimum": 0},
  "sha256": {"$ref": "defs.schema.json#/$defs/sha256"},
  "erster_schlag_frame": {"type": "integer", "minimum": 0},
  "beats": {"type": "number", "minimum": 0},
  "erste_eins_quell_beat": {"type": "integer", "minimum": 0, "maximum": 3},
  "analyse_quelle": {"enum": ["stems", "basis"]},
  "stems": {"type": "object", "propertyNames": {"enum": ["drums", "bass", "vocals", "other"]},
   "additionalProperties": {"type": "object", "required": ["datei", "sha256", "frames"],
    "properties": {"datei": {"type": "string"}, "sha256": {"$ref": "defs.schema.json#/$defs/sha256"}, "frames": {"type": "integer", "minimum": 0}}}},
  "schuesse": {"type": "array", "items": {"type": "object", "required": ["nr", "datei", "frames", "quell_beat", "name"],
   "properties": {"nr": {"type": "integer", "minimum": 1}, "datei": {"type": "string"}, "frames": {"type": "integer", "minimum": 1},
    "quell_beat": {"type": "number"}, "name": {"type": "string"}}}},
  "headroom_db": {"type": "number"},
  "stimmung_korrektur_cent": {"type": "number"},
  "lautheit": {"type": "object", "required": ["lufs_integriert", "echtspitze_dbtp", "crest_db", "lufs_je_takt"],
   "properties": {"lufs_integriert": {"type": "number"}, "echtspitze_dbtp": {"type": "number"}, "crest_db": {"type": "number"},
    "lufs_je_takt": {"type": "array", "items": {"type": ["number", "null"]}}}},
  "struktur": {"type": "object", "required": ["phrasen"], "properties": {"phrasen": {"type": "array", "items": {
   "type": "object", "required": ["ab_beat", "bis_beat", "art"],
   "properties": {"ab_beat": {"type": "number"}, "bis_beat": {"type": "number"}, "art": {"enum": ["intro", "aufbau", "drop", "break", "outro", "unbekannt"]}}}}}},
  "hotcues": {"type": "array", "items": {"type": "object", "required": ["nr", "quell_beat", "name", "von"],
   "properties": {"nr": {"type": "integer", "minimum": 1, "maximum": 8}, "quell_beat": {"type": "number"}, "name": {"type": "string"},
    "von": {"enum": ["werkstatt", "andreas"]}}}},
  "loops": {"type": "array", "items": {"type": "object", "required": ["name", "ab_beat", "laenge_beats"],
   "properties": {"name": {"type": "string"}, "ab_beat": {"type": "number"}, "laenge_beats": {"type": "number", "exclusiveMinimum": 0}}}},
  "tore": {"$ref": "defs.schema.json#/$defs/tore"},
  "nur_fuer_andreas": {"type": "boolean"},
  "warnungen": {"type": "array", "items": {"type": "string"}}
 },
 "allOf": [
  {"if": {"properties": {"stems": {"minProperties": 1}}, "required": ["stems"]}, "then": {"properties": {"analyse_quelle": {"const": "stems"}}}},
  {"if": {"properties": {"stems": {"maxProperties": 0}}, "required": ["stems"]}, "then": {"properties": {"analyse_quelle": {"const": "basis"}}}}
 ]
}
