{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/material.schema.json",
 "title": "material.json, Schema-Version 1 (SCHNITTSTELLEN.md §13.2)",
 "type": "object",
 "required": ["schema", "material_id", "titel", "herkunft", "text", "quelle", "tempo_karte_quelle", "raster", "lautheit_quelle", "tonart"],
 "properties": {
  "schema": {"const": 1},
  "material_id": {"$ref": "defs.schema.json#/$defs/material_id"},
  "titel": {"type": "string"},
  "herkunft": {"type": "object", "required": ["art", "prompt", "stil", "seed", "generator", "erzeugt_am", "auftrag_id"],
   "properties": {"art": {"enum": ["minimax", "datei", "aufnahme"]}, "prompt": {"type": ["string", "null"]}, "stil": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]}, "generator": {"type": ["string", "null"]},
    "erzeugt_am": {"anyOf": [{"$ref": "defs.schema.json#/$defs/zeit_iso"}, {"type": "null"}]},
    "auftrag_id": {"anyOf": [{"$ref": "defs.schema.json#/$defs/auftrag_id"}, {"type": "null"}]}}},
  "text": {"type": "object", "required": ["quelle", "zeilen"],
   "properties": {"quelle": {"enum": ["prompt", "keiner"]}, "zeilen": {"type": "array", "items": {"type": "string"}}}},
  "quelle": {"type": "object", "required": ["datei", "sr", "kanaele", "dauer_s", "sha256"],
   "properties": {"datei": {"type": "string"}, "sr": {"type": "integer", "minimum": 1}, "kanaele": {"type": "integer", "minimum": 1},
    "dauer_s": {"type": "number", "minimum": 0}, "sha256": {"$ref": "defs.schema.json#/$defs/sha256"}}},
  "tempo_karte_quelle": {"description": "[[quell_sekunde, quell_beat], ...] je Schlag", "type": "array",
   "items": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
  "raster": {"type": "object", "required": ["werkzeug", "zweitwerkzeug", "abweichung_ms_p90", "pulsklarheit", "erster_schlag_quelle_s",
    "taktart", "tempo_vielfaches", "erste_eins_quell_beat", "erste_eins_zweitverfahren"],
   "properties": {"werkzeug": {"type": "string"}, "zweitwerkzeug": {"type": "string"}, "abweichung_ms_p90": {"type": ["number", "null"]},
   "versatz_zweitwerkzeug_ms": {"type": ["number", "null"]},
    "pulsklarheit": {"type": ["number", "null"]}, "erster_schlag_quelle_s": {"type": "number", "minimum": 0}, "taktart": {"const": 4},
    "tempo_vielfaches": {"enum": [0.5, 1, 2]}, "erste_eins_quell_beat": {"type": "integer", "minimum": 0, "maximum": 3},
    "erste_eins_zweitverfahren": {"type": ["integer", "null"], "minimum": 0, "maximum": 3}}},
  "lautheit_quelle": {"type": "object", "required": ["lufs_integriert", "echtspitze_dbtp", "crest_db"],
   "properties": {"lufs_integriert": {"type": "number"}, "echtspitze_dbtp": {"type": "number"}, "crest_db": {"type": "number"}}},
  "tonart": {"type": "object", "required": ["camelot", "r", "vorsprung", "stimmung_cent", "stimmung_r", "stimmung_cent_zweitwerkzeug", "aus_stems"],
   "properties": {"camelot": {"anyOf": [{"$ref": "defs.schema.json#/$defs/camelot"}, {"type": "null"}]}, "r": {"type": ["number", "null"]},
    "vorsprung": {"type": ["number", "null"]}, "stimmung_cent": {"type": ["number", "null"]}, "stimmung_r": {"type": ["number", "null"]},
    "stimmung_cent_zweitwerkzeug": {"type": ["number", "null"]}, "aus_stems": {"type": "boolean"}}}
 }
}
