{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/kiste.schema.json",
 "title": "Kiste /dev/shm/cypherdj/kiste.json (SCHNITTSTELLEN.md §6.5)",
 "type": "object",
 "required": ["version", "geaendert_sample", "eintraege"],
 "properties": {
  "version": {"const": 1},
  "geaendert_sample": {"$ref": "defs.schema.json#/$defs/sample"},
  "eintraege": {"type": "array", "items": {"$ref": "#/$defs/eintrag"}}
 },
 "$defs": {
  "eintrag": {
   "type": "object",
   "required": ["material_id", "titel", "quelle_bpm", "fassungen", "dauer_beats", "lufs", "camelot", "tore_ok", "nur_fuer_andreas"],
   "properties": {
    "material_id": {"$ref": "defs.schema.json#/$defs/material_id"},
    "titel": {"type": "string"},
    "quelle_bpm": {"$ref": "defs.schema.json#/$defs/bpm"},
    "fassungen": {"type": "array", "minItems": 1, "items": {
     "type": "object", "required": ["basis_bpm", "fassung", "stems"],
     "properties": {"basis_bpm": {"$ref": "defs.schema.json#/$defs/bpm"}, "fassung": {"type": "integer", "minimum": 1}, "stems": {"type": "boolean"}}}},
    "dauer_beats": {"$ref": "defs.schema.json#/$defs/dauer_beats"},
    "lufs": {"type": "number"},
    "camelot": {"$ref": "defs.schema.json#/$defs/camelot"},
    "tore_ok": {"type": "boolean"},
    "nur_fuer_andreas": {"type": "boolean"}
   }
  }
 }
}
