{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/ws_daten.schema.json",
 "title": "daten je WebSocket-typ (SCHNITTSTELLEN.md §9.2 bis §9.4)",
 "$defs": {
  "rolle": {"enum": ["spieler", "mcp", "analyse", "werkstatt", "ansage", "anzeige", "pruefstand"]},
  "hallo": {"description": "§9.2 Client → Leitstand", "type": "object", "required": ["rolle", "name", "protokoll"],
   "properties": {"rolle": {"$ref": "#/$defs/rolle"}, "name": {"type": "string", "minLength": 1}, "protokoll": {"const": 1}}},
  "willkommen": {"description": "§9.2 Antwort", "type": "object", "required": ["rolle", "set_id", "generation", "autonomie"],
   "properties": {"rolle": {"$ref": "#/$defs/rolle"}, "set_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$"},
    "generation": {"type": "integer", "minimum": 0}, "autonomie": {"type": "integer", "minimum": 0, "maximum": 3}}},
  "ereignis": {"description": "§9.3: {art, ...}", "type": "object", "required": ["art"],
   "properties": {"art": {"enum": ["plan_angenommen", "plan_verriegelt", "plan_vorgeschlagen", "teil_gestartet", "teil_fertig",
    "teil_abgebrochen", "invariante", "rueckfall", "hand", "halter", "hoerschein", "vorschlag_angenommen", "vorschlag_verworfen",
    "vorschlag_verfallen", "material_fertig", "auftrag_status", "geladen", "notbahn", "luecke", "quantum", "ki_stopp", "autonomie",
    "urteil", "zug_antwort", "tempo", "set_basis", "neustart"]}}},
  "zug_anfrage": {"description": "§9.3", "type": "object", "required": ["zug_id", "anlass", "antwort_bis_beat", "lage", "kandidaten", "hinweis"],
   "properties": {"zug_id": {"$ref": "defs.schema.json#/$defs/kurz_id"},
    "anlass": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z_]+$"}},
    "antwort_bis_beat": {"$ref": "defs.schema.json#/$defs/beat"},
    "lage": {"$ref": "takt_zustand.schema.json"},
    "kandidaten": {"type": "array", "items": {"$ref": "kandidat.schema.json"}},
    "hinweis": {"type": "string"}}},
  "ansage": {"description": "§9.3", "type": "object", "required": ["text", "art"],
   "properties": {"text": {"type": "string"}, "art": {"enum": ["vorschlag", "plan", "rueckfall", "warnung", "info"]}}},
  "rpc_antwort": {"description": "§9.3", "type": "object", "required": ["id", "ergebnis"],
   "properties": {"id": {"type": "integer", "minimum": 0}, "ergebnis": {"type": "object"}}},
  "rpc_fehler": {"description": "§9.3; code aus §16.2 (§10)", "type": "object", "required": ["id", "code", "text"],
   "properties": {"id": {"type": "integer", "minimum": 0}, "code": {"$ref": "defs.schema.json#/$defs/grund"}, "text": {"type": "string"}}},
  "rpc": {"description": "§9.4; Methoden = MCP-Werkzeuge (§10)", "type": "object", "required": ["id", "methode", "parameter"],
   "properties": {"id": {"type": "integer", "minimum": 0},
    "methode": {"enum": ["lage", "warte", "waehle", "plan_einreichen", "plan_abbrechen", "laden", "vorhoeren", "bestand", "passung", "erzeuge", "spielzettel", "markieren"]},
    "parameter": {"type": "object"}},
   "allOf": [
    {"if": {"properties": {"methode": {"const": "lage"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/lage_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "warte"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/warte_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "waehle"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/waehle_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "plan_einreichen"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/plan_einreichen_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "plan_abbrechen"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/plan_abbrechen_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "laden"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/laden_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "vorhoeren"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/vorhoeren_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "bestand"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/bestand_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "passung"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/passung_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "erzeuge"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/erzeuge_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "spielzettel"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/spielzettel_eingabe"}}}},
    {"if": {"properties": {"methode": {"const": "markieren"}}}, "then": {"properties": {"parameter": {"$ref": "mcp.schema.json#/$defs/markieren_eingabe"}}}}
   ]},
  "zug_status": {"description": "§9.4", "type": "object", "required": ["zug_id", "stand", "dauer_ms"],
   "properties": {"zug_id": {"$ref": "defs.schema.json#/$defs/kurz_id"}, "stand": {"enum": ["gesendet", "antwort", "zeitueberschreitung"]},
    "dauer_ms": {"type": "integer", "minimum": 0}}},
  "zuruf": {"description": "§9.4", "type": "object", "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}}}
 }
}
