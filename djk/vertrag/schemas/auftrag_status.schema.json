{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/auftrag_status.schema.json",
 "title": "auftrag_status, Werkstatt → Leitstand (SCHNITTSTELLEN.md §12.2)",
 "type": "object",
 "required": ["auftrag_id", "stand", "schritt", "fortschritt", "erwartet_fertig_s", "grund"],
 "properties": {
  "auftrag_id": {"$ref": "defs.schema.json#/$defs/auftrag_id"},
  "stand": {"enum": ["wartet", "laeuft", "fertig", "fehler"]},
  "schritt": {"enum": ["generieren", "dekodieren", "raster", "warp", "stems", "fingerabdruck", "tore", "veroeffentlichen"]},
  "fortschritt": {"$ref": "defs.schema.json#/$defs/anteil"},
  "erwartet_fertig_s": {"type": ["number", "null"], "minimum": 0},
  "grund": {"type": "string"}
 }
}
