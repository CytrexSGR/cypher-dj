  "basis_bpm": {"$ref": "defs.schema.json#/$defs/bpm"},
  "fassung": {"type": "integer", "minimum": 1},
  "pfad": {"type": "string", "minLength": 1},
  "tore": {"$ref": "defs.schema.json#/$defs/tore"},
  "nur_fuer_andreas": {"type": "boolean"},
  "warnungen": {"type": "array", "items": {"type": "string"}},
  "dauer_s": {"description": "je Schritt Sekunden, null für nicht gelaufene Schritte", "type": "object",
   "additionalProperties": {"type": ["number", "null"], "minimum": 0},
