# Build image for cypher-dj .deb packages (Ubuntu 24.04 amd64, glibc 2.39: the package targets exactly this).
# Build deps are the ones named in the header of docs/veroeffentlichung/paket/baue_deb.sh; Rust (rustup), Node and
# Strudel are fetched by that script at build time into persistent volumes, not baked in.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build pkg-config libjack-jackd2-dev librubberband-dev libssl-dev libfftw3-dev \
      libsamplerate0-dev git curl ca-certificates python3 python3-venv dpkg-dev xz-utils rsync ccache \
    && rm -rf /var/lib/apt/lists/*
# Non-root build user with uid/gid 1000 (run with --userns=keep-id so it is the host user and the volumes stay writable).
# The mount points are created here so that new named volumes inherit this ownership.
RUN userdel -r ubuntu 2>/dev/null; groupdel ubuntu 2>/dev/null; \
    groupadd -g 1000 bau && useradd -m -u 1000 -g 1000 -s /bin/bash bau && \
    install -d -o bau -g bau /home/bau/.cargo /home/bau/.rustup /home/bau/.cache/ccache /home/bau/.cache/pnpm \
      /home/bau/.local/share/pnpm /home/bau/.npm /home/bau/strudel /work /out
USER bau
WORKDIR /work
ENV HOME=/home/bau CCACHE_DIR=/home/bau/.cache/ccache CCACHE_MAXSIZE=5G \
    CMAKE_C_COMPILER_LAUNCHER=ccache CMAKE_CXX_COMPILER_LAUNCHER=ccache
