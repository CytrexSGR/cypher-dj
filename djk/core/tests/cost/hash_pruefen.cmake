# One hash test of the arrangement lanes, run by ctest as `cmake -P hash_pruefen.cmake` (see kosten_hash_test in CMakeLists.txt).
# Inputs (-D): EXE (kern_kosten_arr), LANE, BLOCK (256 or 128), ENVV (comma separated K=V of this variant, without KOSTEN_HASH and
# KOSTEN_BLOCK), NACH (regex for the rest of the HASH line after "blocks=5000 ", may be empty), KONTROLLE (1: the control must NOT give the
# reference bits), PINS (hash_pins.txt). KOSTEN_CPU_MODELL replaces the CPU model name (tests of this script).
#   Known host (an entry in PINS): the bits must equal the pin of this host for (lane, block).
#   Unknown host: "no pin for this host" is logged and the variant must give the bits of the plain run of the same lane and block.
cmake_minimum_required(VERSION 3.20)

if(DEFINED ENV{KOSTEN_CPU_MODELL})
  set(cpu "$ENV{KOSTEN_CPU_MODELL}")
else()
  file(STRINGS /proc/cpuinfo cpu LIMIT_COUNT 1 REGEX "^model name")
  string(REGEX REPLACE "^model name[ \t]*:[ \t]*" "" cpu "${cpu}")
endif()

file(STRINGS "${PINS}" zeilen)
set(host "")
foreach(z IN LISTS zeilen)
  string(REPLACE " " ";" t "${z}")
  list(GET t 0 art)
  if(art STREQUAL "host")
    list(GET t 1 schluessel)
    list(GET t 2 teil)
    string(FIND "${cpu}" "${teil}" pos)
    if(NOT pos EQUAL -1)
      set(host "${schluessel}")
    endif()
  endif()
endforeach()

function(lauf umgebung ausgabe_pm ausgabe_out ausgabe_zeile)
  string(REPLACE "," ";" el "${umgebung}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E env KOSTEN_HASH=1 ${el} "${EXE}" 3000 "${LANE}"
                  OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  string(REGEX MATCH "HASH lane=[^\n]*" zeile "${o}${e}")
  if(zeile STREQUAL "")
    message(FATAL_ERROR "no HASH line from ${LANE} (exit ${rc}):\n${o}${e}")
  endif()
  string(REGEX MATCH "pm=([0-9a-f]+) out=([0-9a-f]+)" m "${zeile}")
  set(${ausgabe_pm} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${ausgabe_out} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  set(${ausgabe_zeile} "${zeile}" PARENT_SCOPE)
endfunction()

set(blockenv "")
if(NOT BLOCK STREQUAL "256")
  set(blockenv "KOSTEN_BLOCK=${BLOCK}")
endif()
set(variante "${blockenv}")
if(NOT ENVV STREQUAL "")
  set(variante "${blockenv},${ENVV}")
endif()
string(REGEX REPLACE "^,+" "" variante "${variante}")

lauf("${variante}" pm out zeile)
message(STATUS "${zeile}")

if(host STREQUAL "")
  message(STATUS "no pin for this host (CPU: ${cpu}): checking only that the variant agrees with the plain run of ${LANE} at block ${BLOCK}")
  if(variante STREQUAL blockenv)
    set(ref_pm "${pm}")
    set(ref_out "${out}")
  else()
    lauf("${blockenv}" ref_pm ref_out ref_zeile)
    message(STATUS "plain run: ${ref_zeile}")
  endif()
else()
  set(ref_pm "")
  foreach(z IN LISTS zeilen)
    string(REPLACE " " ";" t "${z}")
    list(GET t 0 art)
    if(art STREQUAL "pin")
      list(GET t 1 h)
      list(GET t 2 l)
      list(GET t 3 b)
      if(h STREQUAL host AND l STREQUAL LANE AND b STREQUAL BLOCK)
        list(GET t 4 ref_pm)
        list(GET t 5 ref_out)
      endif()
    endif()
  endforeach()
  if(ref_pm STREQUAL "")
    message(FATAL_ERROR "host ${host} has no pin for ${LANE} at block ${BLOCK} in ${PINS}")
  endif()
  message(STATUS "pin of host ${host}: pm=${ref_pm} out=${ref_out}")
endif()

if(KONTROLLE)
  if(pm STREQUAL ref_pm AND out STREQUAL ref_out)
    message(FATAL_ERROR "the control gave the reference bits (pm=${pm} out=${out}): the check would not tell the muted run from the real one")
  endif()
else()
  if(NOT (pm STREQUAL ref_pm AND out STREQUAL ref_out))
    message(FATAL_ERROR "hash differs from the reference: got pm=${pm} out=${out}, expected pm=${ref_pm} out=${ref_out}"
                        " (host '${host}', CPU: ${cpu}). If this host or the toolchain is new, measure the pin again, see hash_pins.txt.")
  endif()
endif()
if(NOT NACH STREQUAL "")
  if(NOT zeile MATCHES "blocks=5000 ${NACH}")
    message(FATAL_ERROR "the HASH line does not match 'blocks=5000 ${NACH}':\n${zeile}")
  endif()
endif()
