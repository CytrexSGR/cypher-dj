{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cypherdj.invalid/vertrag/1/defs.schema.json",
 "title": "Gemeinsame Bausteine (INTERFACES.md §1, §16.2)",
 "$defs": {
  "material_id": {"description": "§1.4: 16 Hex-Zeichen, Kleinbuchstaben", "type": "string", "pattern": "^[0-9a-f]{16}$"},
  "plan_id": {"description": "§1.4 plan", "type": "string", "pattern": "^[a-z0-9_-]{1,24}$"},
  "hs_id": {"description": "§1.4 hs_id", "type": "string", "pattern": "^[a-z0-9_-]{1,24}$"},
  "auftrag_id": {"description": "§1.4 auftrag_id", "type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
  "kurz_id": {"description": "Wahl, Vorschlag, Urteil, Zug (§14.2, §14.3, §14.9, §9.3); Form wie auftrag_id", "type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
  "quelle": {"description": "§1.4", "enum": ["andreas", "cypher", "leitstand", "erzeuger", "werkstatt", "pruefstand"]},
  "kanal": {"description": "§1.5 (the four containers deck/1, deck/2, pad/1, pad/2, the buses, master, cue)", "type": "string", "pattern": "^(deck/[12]|pad/[12]|bus/[1-4]|master|cue)$"},
  "hoer_kanal": {"description": "§4.5: the Hörschein key is the player name deck/1 to deck/4 (the core resolves container -> player, container core C7); pad/1 and pad/2 stay for the Schuss ticket (I3b, C15)", "type": "string", "pattern": "^(deck/[1-4]|pad/[12])$"},
  "deck_nr": {"type": "integer", "minimum": 1, "maximum": 4},
  "regler_pfad": {
   "description": "§1.5 control paths. Container core: the strip rows (fader, trim, eq, kill, filter, send, ziel, xseite, pfl, komp, gate, util, bk) exist on the four containers deck/1, deck/2, pad/1, pad/2 only; a bus has no ziel, komp, gate or bk row and the same strip otherwise plus util, mb, lim; deck/1..4/stem/* are player rows; strom/1..16/bk/1..64 are the graph knobs of the instrument that plays on a stream; erz/<n>/(fader|pfl|eq/*|kill/*|filter|bk/1..64) with n = 1, 2, 3, 5, 6, 7, 9, 10 is the alias group (resolved by the page server, pult.json alias_stroeme); transport is a core row and not a path of this schema. Unchanged families: rueckkopplung only fx/1, fx/2; spur/1..32 since D1 (E3); grp/1..16 and pm/fader since 1.10; spur|grp/<n>/send/1..4, ret/1..4/* and ret/1..4/hall/* since 1.10 Slice 3; container/bk/1..64 (1..8 since S5r, 9..32 since the 32-knob widening, 33..64 since the 64-knob widening); fx/3/bk/1..64 and fx/4/bk/1..64 since S14; 345 mix-tool paths since 1.15 (now on the containers and buses): <container>/gate/*, <container or bus>/util/*, bus/<n>/mb/*, bus/<n>/lim/*, spektrum/kanal; ins/komp/1..12/* (10 parameters) since 1.10 slice 4a; ins/eq/1..8/* (59 each) and ins/saett/1..4/* (4 each; pools 8 and 4 since arr-fx slice 2) since slice 4b; ins/host/1..8/an since plan 1.11 (1..4 before strand 1 slice 5); ins/utility/1..8/* (5 parameters) since arr-fx; ins/bk/1..8/* (an, k1..k64) since arr-bk; spur/<slot>/bk/<k>, slot 1..16 (the running number among the tracks with the device bk), k 1..64 (1..32 before 2026-11-16): a transient override of a Baukasten knob, cleared by every playback build, not saved)",
   "type": "string",
   "pattern": "^((deck/[12]|pad/[12])/(fader|trim|eq/(tief|mitte|hoch)|kill/(tief|mitte|hoch)|filter|send/[1-4]|ziel|xseite|pfl|komp/(an|schwelle|ratio|attack|release|makeup|mix|sc))|bus/[1-4]/(fader|trim|eq/(tief|mitte|hoch)|kill/(tief|mitte|hoch)|filter|send/[1-4]|xseite|pfl)|deck/[1-4]/stem/(drums|bass|vocals|other)|duck/(tiefe|release)|color/(art|param)|keylock|xfader|master/(pegel|kleber|pfl)|cue/(mix|pegel|split)|fx/[12]/(notenwert|rueckkopplung)|fx/[1-4]/rueckweg|spur/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])/(fader|pan|mute|solo|filter|pfl|trim|kill/(tief|mitte|hoch)|eq/(tief|mitte|hoch)|fx/[123])|grp/([1-9]|1[0-6])/(fader|pan|mute|solo|cue)|pm/fader|(spur/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])|grp/([1-9]|1[0-6]))/send/[1-8]|ret/[1-8]/(fader|pan|mute|solo|hall/(an|pre|decay|groesse|tief|highcut|fahne))|(deck/[12]|pad/[12])/gate/(an|schwelle|hysterese|ratio|bereich|attack|hold|release|sc)|(deck/[12]|pad/[12]|bus/[1-4])/util/(balance|breite|bassmono|phase_l|phase_r|tausch|dc)|bus/[1-4]/mb/(an|grenze_tief|grenze_hoch|(tief|mitte|hoch)/(schwelle|ratio|attack|release|knie|makeup|umgehen))|bus/[1-4]/lim/(an|decke|abklingen)|spektrum/kanal|ins/komp/([1-9]|[1-9][0-9]|1[0-5][0-9]|160)/(an|schwelle|ratio|knie|attack|release|makeup|mix|schp|sc)|ins/eq/([1-9]|[1-9][0-9]|1[0-5][0-9]|160)/(an|out|propq|b[1-8]/(an|typ|freq|gain|q|steil|platz))|ins/saett/[1-4]/(an|drive|out|mix)|ins/lim/[1-8]/(an|decke|abklingen)|ins/gate/([1-9]|1[0-6])/(an|schwelle|hysterese|ratio|bereich|attack|hold|release)|ins/mb/[1-8]/(an|grenze_tief|grenze_hoch|b[1-3]/(schwelle|ratio|attack|release|knie|makeup|umgehen))|ins/utility/[1-8]/(an|breite|mono_unter|gain|balance)|ins/bk/[1-8]/(an|k([1-9]|[1-5][0-9]|6[0-4]))|spur/([1-9]|1[0-6])/bk/([1-9]|[1-5][0-9]|6[0-4])|ins/host/[1-8]/an|rack/([1-9]|1[0-2])/m[1-4]|(deck/[12]|pad/[12]|fx/[34]|master)/bk/([1-9]|[1-5][0-9]|6[0-4])|strom/([1-9]|1[0-6])/bk/([1-9]|[1-5][0-9]|6[0-4])|erz/(1|2|3|5|6|7|9|10)/(fader|trim|pfl|eq/(tief|mitte|hoch)|kill/(tief|mitte|hoch)|filter|komp/(an|schwelle|ratio|attack|release|makeup|mix|sc)|pan|mute|solo|send/[1-4]|bk/([1-9]|[1-5][0-9]|6[0-4])))$"
  },
  "fassung_name": {"description": "§4.5, §13.1: <bpm·1000>_r<n>", "type": "string", "pattern": "^[1-9][0-9]*_r[1-9][0-9]*$"},
  "inhalt": {"description": "§4.5: Deck <material_id>/<bpm·1000>_r<n>, Pad .../s<nr>, Erzeuger muster/<m>", "type": "string",
   "pattern": "^([0-9a-f]{16}/[1-9][0-9]*_r[1-9][0-9]*(/s[1-9][0-9]*)?|muster/[0-9]+)$"},
  "hoerschein_feld": {"description": "§4.3 Feld 12, §4.4: \"\", eine hs_id oder annahme:<vorschlag_id>", "type": "string",
   "pattern": "^(|[a-z0-9_-]{1,24}|annahme:[a-z0-9_-]{1,32})$"},
  "gruppe": {"description": "§4.3 Feld 11: Kopplungsgruppe oder \"\"", "type": "string", "pattern": "^[a-z0-9_-]{0,24}$"},
  "beat": {"description": "§1.1: Viertel seit Beat 0 der Zeitachse", "type": "number"},
  "dauer_beats": {"description": "§1.1", "type": "number", "minimum": 0},
  "sample": {"description": "§1.1 int64", "type": "integer"},
  "bpm": {"type": "number", "exclusiveMinimum": 0},
  "db": {"description": "§1.2: stumm = -200", "type": "number", "minimum": -200},
  "anteil": {"type": "number", "minimum": 0, "maximum": 1},
  "camelot": {"type": "string", "pattern": "^(1[0-2]|[1-9])[AB]$"},
  "zeit_iso": {"description": "ISO 8601 wie im Beispiel §13.3 (Zeitzone optional)", "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$"},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "baender_db": {"description": "§6.2, §14.8: sechs Bänder in dB, Reihenfolge sub, tief, tiefmitte, mitte, praesenz, hoch",
   "type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
  "ueberdeckung": {"description": "§14.6, §14.8: je Band 0 bis 1 (null: Band ohne Anteil)", "type": "object",
   "required": ["sub", "tief", "tiefmitte", "mitte", "praesenz", "hoch"],
   "properties": {"sub": {"$ref": "#/$defs/anteil_oder_null"}, "tief": {"$ref": "#/$defs/anteil_oder_null"},
    "tiefmitte": {"$ref": "#/$defs/anteil_oder_null"}, "mitte": {"$ref": "#/$defs/anteil_oder_null"},
    "praesenz": {"$ref": "#/$defs/anteil_oder_null"}, "hoch": {"$ref": "#/$defs/anteil_oder_null"}}},
  "anteil_oder_null": {"anyOf": [{"$ref": "#/$defs/anteil"}, {"type": "null"}]},
  "zahl_oder_null": {"type": ["number", "null"]},
  "grund": {
   "description": "§16.2 Codes; dazu \"neustart\" aus §16.3 (teil_abgebrochen nach Kern-Neustart, fehlt in der Tabelle §16.2)",
   "enum": ["zu_spaet", "regler_beim_menschen", "regler_verplant", "ueberlappung", "nur_hand", "nur_rampe", "unbekannter_regler",
    "unbekanntes_deck", "ausserhalb_bereich", "kein_hoerschein", "hoerschein_anderer_kanal", "hoerschein_anderer_inhalt",
    "hoerschein_anderes_tempo", "hoerschein_abgelaufen", "hoerschein_anderer_abschnitt", "ziel_ungehoert", "keine_stems",
    "hoerschein_nicht_sync", "hoerschein_pegel", "invariante_sub_doppelt", "invariante_master_leer", "deck_beruehrt",
    "deck_hoerbar", "deck_laeuft", "nicht_geladen", "material_fehlt", "pruefung", "budget_speicher", "budget_stretcher",
    "karte_voll", "tempo_rampe", "ki_gestoppt", "rechner_fehlt", "kein_stretcher", "autonomie", "form", "hand", "abbruch", "ki_stopp",
    "unbekannte_adresse", "falsche_typen", "protokoll", "neustart", "grenze_sub",
    "datei_fehlt", "format", "audio_fehlt", "zu_gross", "spur_bereich", "reserviert",
    "kein_eingang", "aufnahme_laeuft", "zu_viele_scharf", "eingang_fehlt", "kein_platz",
    "warp_maschine_fehlt", "nur_andreas", "auto_ziel_unbekannt", "laeuft", "host_fehlt", "kein_rueckweg", "belegt", "schreiber_ueberlauf", "zelle_leer", "live_ohne_container", "dj_doppelt", "send_ausser_modul", "zellen_ungueltig"]
  },
  "zeit": {"description": "§9.1 zeit: Kern-Zeitpunkt", "type": "object", "required": ["sample", "beat", "takt", "phrase"],
   "properties": {"sample": {"$ref": "#/$defs/sample"}, "beat": {"$ref": "#/$defs/beat"},
    "takt": {"type": "integer", "minimum": 1}, "phrase": {"type": "integer", "minimum": 1}}},
  "tore": {
   "description": "§13.2 fassung.json tore; §12.2 material_fertig tore",
   "type": "object", "required": ["raster", "headroom", "klarheit", "streckfaktor", "eins"],
   "properties": {
    "raster": {"type": "object", "required": ["ok", "wert_ms", "grenze_ms", "anschlaege"],
     "properties": {"ok": {"type": "boolean"}, "wert_ms": {"type": ["number", "null"]}, "grenze_ms": {"type": "number"}, "anschlaege": {"type": "integer", "minimum": 0}}},
    "headroom": {"type": "object", "required": ["ok", "wert_dbtp", "grenze_dbtp"],
     "properties": {"ok": {"type": "boolean"}, "wert_dbtp": {"type": "number"}, "grenze_dbtp": {"type": "number"}}},
    "klarheit": {"type": "object", "required": ["ok", "wert", "grenze"],
     "properties": {"ok": {"type": "boolean"}, "wert": {"type": "number"}, "grenze": {"type": "number"}}},
    "streckfaktor": {"type": "object", "required": ["ok", "wert", "grenze"],
     "properties": {"ok": {"type": "boolean"}, "wert": {"type": "number"}, "grenze": {"type": "number"}}},
    "eins": {"type": "object", "required": ["ok", "beat_this", "zweitverfahren"],
     "properties": {"ok": {"type": "boolean"}, "beat_this": {"type": ["integer", "null"]}, "zweitverfahren": {"type": ["integer", "null"]},
      "bewertet": {"description": "2026-10-11: false bei Material von vor der Anteil-/Kick-Entscheidung", "type": "boolean"},
      "unsicher": {"description": "Mehrheitsanteil < 0,85 ohne Kick-Bestaetigung oder Kick weicht ab; die Seite zeigt „downbeat?“", "type": "boolean"},
      "anteil": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "kick": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
      "quelle": {"enum": ["mehrheit", "kick", "keine", "andreas", null]}}}
   }
  }
 }
}
