# cypher-dj: persönliche Pfade. Kopieren nach ~/.config/cypherdj/umgebung.env und anpassen.
# djk-start und die Oberfläche-Unit laden diese Datei (Shell: set -a; . DATEI; set +a / systemd: EnvironmentFile=-).
# Werte mit Leerzeichen in "..." setzen (gilt für Shell und systemd gleichermaßen).

# Wurzel der Musiksammlung (Ordner mit den MP3). Pflicht für djk/cues/server.ts (oder --wurzel DIR).
CYPHERDJ_MUSIK="/path/to/music"

# Traktor collection.nml. Optional (ohne sie kein Traktor-Abgleich im Cue-Werkzeug; Strukturvorschlag-Messungen brauchen sie).
CYPHERDJ_NML="/path/to/collection.nml"

# Mediathek-Datenbank (sqlite, nur lesen). Optional (ohne sie antworten die Mediathek-Routen mit 503 mediathek_fehlt).
CYPHERDJ_MEDIATHEK="/path/to/mediathek.sqlite"

# Sample-Quelle Battery (Ordner mit den Drum-Unterordnern Kick, Snare ...), von djk/klang/rollen.json als ${CYPHERDJ_KLANG_BATTERY} gelesen.
CYPHERDJ_KLANG_BATTERY="/path/to/Battery4-Samples/Drums"

# Sample-Quelle Maschine (Ordner mit den Drum-Unterordnern), von djk/klang/rollen.json als ${CYPHERDJ_KLANG_MASCHINE} gelesen.
CYPHERDJ_KLANG_MASCHINE="/path/to/Maschine_2_Library/Samples/Drums"

# Wurzel der Battery-Samples (eine Ebene über Drums). Optional, nur für den Bit-Gleichheits-Test in djk/erzeuger/tests.
CYPHERDJ_KLANG_BATTERY_SAMPLES="/path/to/Battery4-Samples"

# Python mit demucs (Prüfstand, Last-Profil p1). Optional, nur für Prüfläufe mit Profil p1.
CYPHERDJ_DEMUCS_PYTHON="/path/to/venv/bin/python"

# Sperrdatei der Echtzeit-Messläufe (flock in den Mess- und Abnahme-Skripten). Optional; Vorgabe ohne diese Zeile:
# ${XDG_RUNTIME_DIR:-/tmp}/cypherdj-echtzeit.lock. Mehrere Rechner-Nutzer, die sich ausschließen sollen, setzen denselben Pfad.
CYPHERDJ_ECHTZEIT_SCHLOSS="/tmp/cypherdj-echtzeit.lock"
