    },
    {
     "id": "fx4",
     "type": "knob",
     "label": "FX 4",
     "bind": {
      "param": "a_send_fx_4"
     },
     "format": "raw"
    }
   ]
  },
  {
   "id": "out",
   "title": "OUTPUT",
   "cols": 2,
   "controls": [
    {
     "id": "vol",
     "type": "knob",
     "label": "Volume",
     "bind": {
      "param": "a_volume"
     },
     "format": "percent"
    },
    {
     "id": "pan",
     "type": "knob",
     "label": "Pan",
     "bind": {
      "param": "a_pan"
     },
     "format": "percent"
