    },
    {
     "id": "l2amt",
     "type": "knob",
     "label": "Amplitude",
     "bind": {
      "param": "a_lfo2_magnitude"
     },
     "format": "percent"
    },
    {
     "id": "l2def",
     "type": "knob",
     "label": "Deform",
     "bind": {
      "param": "a_lfo2_deform"
     },
