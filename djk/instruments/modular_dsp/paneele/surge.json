    {
     "id": "glide",
     "type": "knob",
     "label": "Glide",
     "bind": {
      "param": "a_portamento"
     },
     "format": "raw"
    },
    {
     "id": "fb",
     "type": "knob",
     "label": "Feedback",
     "bind": {
      "param": "a_feedback"
     },
     "format": "percent"
    }
   ]
  }
 ]
}
