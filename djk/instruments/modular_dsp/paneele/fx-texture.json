{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "fx-texture"},
  "title": "Texture",
  "akzent": "tuerkis",
  "layout": {"rows": [
    ["filter", "fx"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "rnd", "type": "knob", "label": "Cutoff random", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "fx", "title": "EFFECTS", "cols": 3, "controls": [
      {"id": "pmix", "type": "knob", "label": "Phaser mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "dmix", "type": "knob", "label": "Delay mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5},
      {"id": "smix", "type": "knob", "label": "Spring reverb mix", "bind": {"param": "k6"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
