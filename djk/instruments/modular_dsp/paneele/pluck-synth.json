{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "pluck-synth"},
  "title": "Synth Pluck",
  "akzent": "blau",
  "layout": {"rows": [
    ["filter", "env", "fx"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "bp", "pole": 2}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "vel", "type": "knob", "label": "Velocity amount", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "env", "title": "AMP ENV", "cols": 2, "controls": [
      {"id": "hue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.001, "d": "decay", "s": 0, "r": 0.1}},
      {"id": "decay", "type": "knob", "label": "Decay", "span": 2, "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "fx", "title": "REVERB + DELAY", "cols": 2, "controls": [
      {"id": "rmix", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5},
      {"id": "dmix", "type": "knob", "label": "Delay mix", "bind": {"param": "k6"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
