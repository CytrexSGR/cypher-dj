{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "bass-acid"},
  "title": "Acid Bass",
  "akzent": "orange",
  "layout": {"rows": [
    ["filter", "out"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "lfo", "type": "knob", "label": "Cutoff LFO", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5, "scale": {"labels": ["-12", "off", "+12"]}},
      {"id": "fnote", "type": "label", "span": 3, "text": "Ladder filter, LFO 0.3 Hz fixed"}
    ]},
    { "id": "out", "title": "DRIVE & FX", "cols": 3, "controls": [
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k4"}, "format": "db", "default": 0.5},
      {"id": "delay", "type": "knob", "label": "Delay mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5},
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k6"}, "format": "percent", "default": 0.5},
      {"id": "onote", "type": "label", "span": 3, "text": "Saturation after the filter"}
    ]}
  ]
}
