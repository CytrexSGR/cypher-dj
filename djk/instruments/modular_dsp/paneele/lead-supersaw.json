{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "lead-supersaw"},
  "title": "Supersaw Lead",
  "akzent": "gelb",
  "layout": {"rows": [
    ["saw", "filter", "fx"]
  ]},
  "sections": [
    { "id": "saw", "title": "SUPERSAW", "cols": 2, "controls": [
      {"id": "detune", "type": "knob", "label": "Saw detune", "bind": {"param": "k1"}, "format": "raw", "unit": "ct", "default": 0.5},
      {"id": "width", "type": "knob", "label": "Stereo width", "bind": {"param": "k2"}, "format": "percent", "default": 0.5}
    ]},
    { "id": "filter", "title": "FILTER", "cols": 1, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k3"}, "format": "hz", "default": 0.5}
    ]},
    { "id": "fx", "title": "EFFECTS", "cols": 2, "controls": [
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "dmix", "type": "knob", "label": "Delay mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
