{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "fx-downlifter"},
  "title": "Downlifter",
  "akzent": "tuerkis",
  "layout": {"rows": [
    ["sweep", "out"]
  ]},
  "sections": [
    { "id": "sweep", "title": "SWEEP", "cols": 3, "controls": [
      {"id": "shue", "type": "huelle", "span": 3, "label": "Envelope", "of": {"a": "time", "d": 0.001, "s": 0, "r": 2}},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "time", "type": "knob", "label": "Fall time", "bind": {"param": "k2"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Env amount", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "snote", "type": "label", "span": 3, "text": "Band-passed noise, filter sweeps down"}
    ]},
    { "id": "out", "title": "FX", "cols": 2, "controls": [
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "delay", "type": "knob", "label": "Delay mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
