{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "lead"},
  "title": "Sync Lead",
  "akzent": "orange",
  "layout": {"rows": [
    ["osc", "filter", "fenv", "aenv", "vib", "out"]
  ]},
  "sections": [
    { "id": "osc", "title": "OSCILLATORS", "cols": 2, "controls": [
      {"id": "sync", "type": "knob", "label": "Sync pitch", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "osc2", "type": "knob", "label": "Osc 2 level", "bind": {"param": "k7"}, "format": "percent", "default": 0.5},
      {"id": "o1", "type": "label", "span": 2, "text": "Osc 1: saw, level 50 %"},
      {"id": "o2", "type": "label", "span": 2, "text": "Osc 2: saw, hard-synced"},
      {"id": "o3", "type": "label", "span": 2, "text": "Glide 40 ms fixed"}
    ]},
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Env amount", "bind": {"param": "k4"}, "format": "hz", "default": 0.5}
    ]},
    { "id": "fenv", "title": "FILTER ENV", "cols": 2, "controls": [
      {"id": "fhue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.002, "d": "decay", "s": 0.15, "r": 0.3}},
      {"id": "decay", "type": "knob", "label": "Decay", "span": 2, "bind": {"param": "k8"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "fn", "type": "label", "span": 2, "text": "A 2 ms, S 15 %, R 300 ms fixed"}
    ]},
    { "id": "aenv", "title": "AMP ENV", "cols": 2, "controls": [
      {"id": "ahue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.004, "d": 0.3, "s": 0.8, "r": 0.25}},
      {"id": "an", "type": "label", "span": 2, "text": "A 4 ms, D 300 ms, S 80 %, R 250 ms"},
      {"id": "an2", "type": "label", "span": 2, "text": "All four times fixed"}
    ]},
    { "id": "vib", "title": "VIBRATO", "cols": 2, "controls": [
      {"id": "vf", "type": "lfoform", "span": 2, "label": "Vibrato shape", "formen": ["sine"]},
      {"id": "vibrato", "type": "knob", "label": "Depth", "span": 2, "bind": {"param": "k6"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "vn", "type": "label", "span": 2, "text": "5.5 Hz sine fixed"}
    ]},
    { "id": "out", "title": "OUT", "cols": 1, "controls": [
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k5"}, "format": "db", "default": 0.5},
      {"id": "on", "type": "label", "span": 1, "text": "After filter"}
    ]}
  ]
}
