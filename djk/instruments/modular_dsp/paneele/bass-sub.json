{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "bass-sub"},
  "title": "Sub Bass",
  "akzent": "orange",
  "layout": {"rows": [
    ["tone", "amp"]
  ]},
  "sections": [
    { "id": "tone", "title": "TONE", "cols": 3, "controls": [
      {"id": "tone", "type": "knob", "label": "Tone", "bind": {"param": "k1"}, "format": "raw", "unit": "x", "default": 0.5},
      {"id": "upper", "type": "knob", "label": "Upper octave", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k3"}, "format": "db", "default": 0.5},
      {"id": "tnote", "type": "label", "span": 3, "text": "Sine plus a quiet triangle one octave up"}
    ]},
    { "id": "amp", "title": "AMP ENV", "cols": 2, "controls": [
      {"id": "ahue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.001, "d": "decay", "s": 0.85, "r": "release"}},
      {"id": "decay", "type": "knob", "label": "Decay", "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "release", "type": "knob", "label": "Release", "bind": {"param": "k5"}, "format": "ms", "default": 0.5}
    ]}
  ]
}
