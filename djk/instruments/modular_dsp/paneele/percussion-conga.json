{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "percussion-conga"},
  "title": "Conga",
  "akzent": "rot",
  "layout": {"rows": [
    ["tone", "amp", "room"]
  ]},
  "sections": [
    { "id": "tone", "title": "TONE", "cols": 2, "controls": [
      {"id": "tune", "type": "knob", "label": "Tune", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k2"}, "format": "hz", "default": 0.5}
    ]},
    { "id": "amp", "title": "AMP", "cols": 2, "controls": [
      {"id": "hue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.0005, "d": "decay", "s": 0, "r": 0.15}},
      {"id": "decay", "type": "knob", "label": "Decay", "span": 2, "bind": {"param": "k3"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "room", "title": "ROOM", "cols": 1, "controls": [
      {"id": "room", "type": "knob", "label": "Room mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
