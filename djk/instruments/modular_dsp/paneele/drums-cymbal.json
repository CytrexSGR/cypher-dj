{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "drums-cymbal"},
  "title": "Cymbal",
  "akzent": "rot",
  "layout": {"rows": [
    ["tone", "amp", "fx"]
  ]},
  "sections": [
    { "id": "tone", "title": "TONE", "cols": 2, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "metal", "type": "knob", "label": "Metal", "bind": {"param": "k3"}, "format": "percent", "default": 0.5},
      {"id": "mnote", "type": "label", "span": 2, "text": "Metal 0 leaves the noise only"}
    ]},
    { "id": "amp", "title": "AMP", "cols": 2, "controls": [
      {"id": "hue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.0005, "d": "decay", "s": 0, "r": 1}},
      {"id": "decay", "type": "knob", "label": "Decay", "span": 2, "bind": {"param": "k2"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "fx", "title": "DRIVE / ROOM", "cols": 2, "controls": [
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k4"}, "format": "db", "default": 0.5},
      {"id": "room", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
