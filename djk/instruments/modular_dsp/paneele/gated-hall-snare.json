{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "gated-hall-snare"},
  "title": "Gated Hall Snare",
  "akzent": "rot",
  "layout": {"rows": [
    ["snare", "gate", "hall"]
  ]},
  "sections": [
    { "id": "snare", "title": "SNARE", "cols": 5, "controls": [
      {"id": "hue", "type": "huelle", "span": 5, "label": "Body envelope", "of": {"a": 0.001, "d": 0.25, "s": 0, "r": 0.05}},
      {"id": "s1", "type": "label", "span": 5, "text": "Noise plus sine 180 Hz"},
      {"id": "s2", "type": "label", "span": 5, "text": "A 1 ms, D 250 ms, S 0, R 50 ms"}
    ]},
    { "id": "gate", "title": "GATE", "cols": 4, "controls": [
      {"id": "key", "type": "knob", "label": "Key gain", "span": 4, "bind": {"param": "k1"}, "format": "raw", "unit": "x", "default": 0.5},
      {"id": "g1", "type": "label", "span": 4, "text": "Threshold -30 dB, depth 60 dB"},
      {"id": "g2", "type": "label", "span": 4, "text": "Release 30 ms, hysteresis 6 dB"},
      {"id": "g3", "type": "label", "span": 4, "text": "More key gain holds it open"}
    ]},
    { "id": "hall", "title": "HALL", "cols": 4, "controls": [
      {"id": "mix", "type": "knob", "label": "Mix", "span": 4, "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "h1", "type": "label", "span": 4, "text": "Decay 3 s"},
      {"id": "h2", "type": "label", "span": 4, "text": "The gate listens to the dry snare"}
    ]}
  ]
}
