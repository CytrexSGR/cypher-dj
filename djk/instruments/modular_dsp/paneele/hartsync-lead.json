{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "hartsync-lead"},
  "title": "Hard Sync Lead",
  "akzent": "orange",
  "layout": {"rows": [
    ["osc", "sweep", "filter", "aenv", "voice"]
  ]},
  "sections": [
    { "id": "osc", "title": "OSCILLATORS", "cols": 3, "controls": [
      {"id": "sync", "type": "knob", "label": "Sync pitch", "span": 3, "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "o1", "type": "label", "span": 3, "text": "Leader: saw, level 25 %"},
      {"id": "o2", "type": "label", "span": 3, "text": "Follower: saw, hard sync, 80 %"},
      {"id": "o3", "type": "label", "span": 3, "text": "Glide 40 ms fixed"}
    ]},
    { "id": "sweep", "title": "SYNC SWEEP", "cols": 3, "controls": [
      {"id": "shue", "type": "huelle", "span": 3, "label": "Pitch sweep", "of": {"a": 0.001, "d": "sdecay", "s": 0.001, "r": 0.3}},
      {"id": "sweep", "type": "knob", "label": "Sweep", "bind": {"param": "k4"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "sdecay", "type": "knob", "label": "Decay", "bind": {"param": "k5"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "sn", "type": "label", "span": 1, "text": "Attack 1 ms fixed"}
    ]},
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k7"}, "format": "db", "default": 0.5}
    ]},
    { "id": "aenv", "title": "AMP ENV", "cols": 3, "controls": [
      {"id": "ahue", "type": "huelle", "span": 3, "label": "Envelope", "of": {"a": 0.003, "d": 0.3, "s": 0.85, "r": "release"}},
      {"id": "release", "type": "knob", "label": "Release", "span": 3, "bind": {"param": "k8"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "an", "type": "label", "span": 3, "text": "A 3 ms, D 300 ms, S 85 % fixed"}
    ]},
    { "id": "voice", "title": "VIBRATO", "cols": 2, "controls": [
      {"id": "vf", "type": "lfoform", "span": 2, "label": "Vibrato shape", "formen": ["sine"]},
      {"id": "vibrato", "type": "knob", "label": "Depth", "span": 2, "bind": {"param": "k6"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "vn", "type": "label", "span": 2, "text": "5.5 Hz sine fixed"}
    ]}
  ]
}
