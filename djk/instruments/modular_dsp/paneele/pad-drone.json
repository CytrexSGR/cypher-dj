{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "pad-drone"},
  "title": "Drone Pad",
  "akzent": "violett",
  "layout": {"rows": [
    ["filter", "env", "fx"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Env amount", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "env", "title": "AMP ENV", "cols": 2, "controls": [
      {"id": "hue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": "attack", "d": 10, "s": 1, "r": 3.3}},
      {"id": "attack", "type": "knob", "label": "Attack", "span": 2, "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "fx", "title": "REVERB", "cols": 1, "controls": [
      {"id": "rmix", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
