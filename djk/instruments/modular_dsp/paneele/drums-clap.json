{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "drums-clap"},
  "title": "Clap",
  "akzent": "rot",
  "layout": {"rows": [
    ["tone", "amp", "room"]
  ]},
  "sections": [
    { "id": "tone", "title": "TONE", "cols": 2, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Filter env amount", "bind": {"param": "k2"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "amp", "title": "CLAP", "cols": 2, "controls": [
      {"id": "depth", "type": "knob", "label": "Clap depth", "bind": {"param": "k3"}, "format": "percent", "default": 0.5},
      {"id": "decay", "type": "knob", "label": "Decay", "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "hue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.0005, "d": "decay", "s": 0, "r": 0.115}}
    ]},
    { "id": "room", "title": "ROOM", "cols": 1, "controls": [
      {"id": "room", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
