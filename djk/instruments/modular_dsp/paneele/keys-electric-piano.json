{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "keys-electric-piano"},
  "title": "Electric Piano",
  "akzent": "orange",
  "layout": {"rows": [
    ["tone", "env", "fx"]
  ]},
  "sections": [
    { "id": "tone", "title": "TONE", "cols": 2, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Env amount", "bind": {"param": "k2"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "env", "title": "AMP ENV", "cols": 2, "controls": [
      {"id": "hue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.001, "d": "decay", "s": 0, "r": 0.63}},
      {"id": "decay", "type": "knob", "label": "Decay", "span": 2, "bind": {"param": "k3"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "fx", "title": "REVERB", "cols": 1, "controls": [
      {"id": "rmix", "type": "knob", "label": "Room mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
