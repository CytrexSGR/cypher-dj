{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "chip-rauschen"},
  "title": "Chip Noise",
  "akzent": "rot",
  "layout": {"rows": [
    ["pitch", "amp", "out"]
  ]},
  "sections": [
    { "id": "pitch", "title": "PITCH", "cols": 3, "controls": [
      {"id": "pitch", "type": "knob", "label": "Pitch", "bind": {"param": "k1"}, "format": "raw", "unit": "x", "default": 0.5},
      {"id": "sweep", "type": "knob", "label": "Sweep", "bind": {"param": "k2"}, "format": "raw", "unit": "st", "default": 0.25},
      {"id": "sdec", "type": "knob", "label": "Sweep time", "bind": {"param": "k3"}, "format": "ms", "default": 0.5, "wirkt": {"ueber": ["sweep", 0.01]}, "wirkt_text": "The sweep is off: turn up Sweep"},
      {"id": "pitch-n", "type": "label", "span": 3, "text": "Noise clock = note pitch times Pitch"}
    ]},
    { "id": "amp", "title": "AMP", "cols": 2, "controls": [
      {"id": "decay", "type": "knob", "label": "Decay", "bind": {"param": "k4"}, "format": "ms", "default": 0.5},
      {"id": "kurz", "type": "switch", "label": "Short mode", "bind": {"param": "k5"}, "default": 0},
      {"id": "amp-n", "type": "label", "span": 2, "text": "Level steps in 16 stages (4 bit)"}
    ]},
    { "id": "out", "title": "OUT", "cols": 1, "controls": [
      {"id": "level", "type": "knob", "label": "Level", "bind": {"param": "k6"}, "format": "percent", "default": 0.8}
    ]}
  ]
}
