{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "wavetable-chor"},
  "title": "Wavetable Choir",
  "akzent": "blau",
  "pages": [{"id": "main", "title": "Main"}, {"id": "mod", "title": "Mod"}],
  "layout": {"rows": [
    ["table", "unison", "wenv", "aenv"],
    ["warp", "chaos"],
    ["pm", "chorus"]
  ]},
  "sections": [
    { "id": "table", "title": "TABLE", "page": "main", "cols": 4, "controls": [
      {"id": "lf", "type": "lfoform", "span": 4, "label": "Vowel motion", "formen": ["sine"]},
      {"id": "vowel", "type": "knob", "label": "Vowel", "bind": {"param": "k1"}, "format": "percent", "default": 0.5},
      {"id": "motion", "type": "knob", "label": "Motion", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "t1", "type": "label", "span": 4, "text": "Table: vowels, position = Vowel"},
      {"id": "t2", "type": "label", "span": 4, "text": "Motion LFO 0.15 Hz sine fixed"}
    ]},
    { "id": "unison", "title": "UNISON", "page": "main", "cols": 3, "controls": [
      {"id": "detune", "type": "knob", "label": "Detune", "bind": {"param": "k3"}, "format": "raw", "unit": "ct", "default": 0.5},
      {"id": "width", "type": "knob", "label": "Width", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "u1", "type": "label", "span": 3, "text": "5 copies"}
    ]},
    { "id": "wenv", "title": "WAVE ENV", "page": "main", "cols": 3, "controls": [
      {"id": "whue", "type": "huelle", "span": 3, "label": "Table position envelope", "of": {"a": "wattack", "d": "wdecay", "s": 0, "r": 0.3}},
      {"id": "wamt", "type": "knob", "label": "Amount", "bind": {"param": "k7"}, "format": "percent", "default": 0.5},
      {"id": "wattack", "type": "knob", "label": "Attack", "bind": {"param": "k8"}, "format": "raw", "unit": "s", "default": 0.5, "wirkt": {"weg": ["wamt"]}, "wirkt_text": "The wave envelope does nothing: turn Amount away from the middle"},
      {"id": "wdecay", "type": "knob", "label": "Decay", "bind": {"param": "k9"}, "format": "raw", "unit": "s", "default": 0.5, "wirkt": {"weg": ["wamt"]}, "wirkt_text": "The wave envelope does nothing: turn Amount away from the middle"},
      {"id": "wn", "type": "label", "span": 3, "text": "Sustain 0, release 300 ms fixed"}
    ]},
    { "id": "aenv", "title": "AMP ENV", "page": "main", "cols": 3, "controls": [
      {"id": "ahue", "type": "huelle", "span": 3, "label": "Envelope", "of": {"a": "attack", "d": 0.5, "s": 0.9, "r": "release"}},
      {"id": "attack", "type": "knob", "label": "Attack", "bind": {"param": "k5"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "release", "type": "knob", "label": "Release", "bind": {"param": "k6"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "an", "type": "label", "span": 3, "text": "Decay 500 ms, sustain 90 % fixed"}
    ]},
    {"id": "warp", "title": "WARP / STACK", "page": "mod", "cols": 3, "controls": [{"id": "warpmode", "type": "selector", "label": "Warp mode", "span": 3, "bind": {"param": "k10"}, "options": ["Off", "Bend", "Asym", "Sync"], "default": 0}, {"id": "warpdepth", "type": "knob", "label": "Warp depth", "bind": {"param": "k11"}, "format": "percent", "default": 0.75, "scale": {"labels": ["-100", "0", "+100"]}, "span": 3, "wirkt": {"ist": ["warpmode", [1, 2, 3]]}, "wirkt_text": "Warp is off: set Warp mode to Bend, Asym or Sync"}, {"id": "stack", "type": "selector", "label": "Stack", "span": 3, "bind": {"param": "k12"}, "options": ["Off", "Oct", "Oct+5th"], "default": 0}, {"id": "wn1", "type": "label", "span": 3, "text": "Stack is heard on the next note"}]},
    {"id": "chaos", "title": "CHAOS", "page": "mod", "cols": 3, "controls": [{"id": "crate", "type": "knob", "label": "Rate", "bind": {"param": "k13"}, "format": "hz", "default": 0.299052, "span": 1, "wirkt": {"weg": ["cpos"]}, "wirkt_text": "Chaos goes nowhere: turn To position away from off"}, {"id": "cpos", "type": "knob", "label": "To position", "bind": {"param": "k14"}, "format": "percent", "default": 0.5, "scale": {"labels": ["-100", "off", "+100"]}, "span": 2}, {"id": "cn", "type": "label", "span": 3, "text": "Lorenz: never repeats"}]},
    {"id": "pm", "title": "PHASE MOD", "page": "mod", "cols": 3, "controls": [{"id": "pmamt", "type": "knob", "label": "Amount", "bind": {"param": "k15"}, "format": "raw", "unit": "cyc", "default": 0, "scale": {"labels": ["off", "0.25", "0.5"]}, "span": 3}, {"id": "pn", "type": "label", "span": 3, "text": "Sine at note pitch"}]},
    {"id": "chorus", "title": "CHORUS", "page": "mod", "cols": 3, "controls": [{"id": "chmode", "type": "selector", "label": "Mode", "span": 3, "bind": {"param": "k17"}, "options": ["I", "II", "I+II"], "default": 0, "wirkt": {"ueber": ["chamt", 0.01]}, "wirkt_text": "The chorus is off: turn up Amount"}, {"id": "chamt", "type": "knob", "label": "Amount", "bind": {"param": "k16"}, "format": "percent", "default": 0, "scale": {"labels": ["off", "50", "100"]}, "span": 3}, {"id": "cn2", "type": "label", "span": 3, "text": "After the output level"}]}
  ]
}
