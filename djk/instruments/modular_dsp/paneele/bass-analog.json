{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "bass-analog"},
  "title": "Analog Bass",
  "akzent": "orange",
  "layout": {"rows": [
    ["tone", "amp", "fx"]
  ]},
  "sections": [
    { "id": "tone", "title": "TONE", "cols": 2, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "span": 2, "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "tnote", "type": "label", "span": 2, "text": "Saw + square, ladder filter"}
    ]},
    { "id": "amp", "title": "AMP", "cols": 2, "controls": [
      {"id": "ahue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.001, "d": 10, "s": 1, "r": "release"}},
      {"id": "release", "type": "knob", "label": "Release", "bind": {"param": "k3"}, "format": "ms", "default": 0.5},
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k2"}, "format": "db", "default": 0.5}
    ]},
    { "id": "fx", "title": "CHORUS", "cols": 1, "controls": [
      {"id": "chorus", "type": "knob", "label": "Chorus mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
