{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "lead-arp"},
  "title": "Arp Lead",
  "akzent": "blau",
  "layout": {"rows": [
    ["filter", "out"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Env amount", "bind": {"param": "k2"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "hp", "type": "knob", "label": "High-pass", "bind": {"param": "k3"}, "format": "hz", "default": 0.5},
      {"id": "fnote", "type": "label", "span": 3, "text": "Saw + pulse, short plucked envelopes"}
    ]},
    { "id": "out", "title": "FX", "cols": 2, "controls": [
      {"id": "delay", "type": "knob", "label": "Delay mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
