{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "metall-hihat"},
  "title": "Metal Hi-Hat",
  "akzent": "rot",
  "layout": {"rows": [
    ["closed", "open", "tone", "src"]
  ]},
  "sections": [
    { "id": "closed", "title": "CLOSED", "cols": 3, "controls": [
      {"id": "cd", "type": "knob", "label": "Decay", "span": 3, "bind": {"param": "k1"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "c1", "type": "label", "span": 3, "text": "Choked in 8 ms by the next hit"}
    ]},
    { "id": "open", "title": "OPEN", "cols": 3, "controls": [
      {"id": "od", "type": "knob", "label": "Decay", "span": 3, "bind": {"param": "k2"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "o1", "type": "label", "span": 3, "text": "Open hat is darker"}
    ]},
    { "id": "tone", "title": "TONE", "cols": 4, "controls": [
      {"id": "tune", "type": "knob", "label": "Tune", "bind": {"param": "k3"}, "format": "raw", "unit": "x", "default": 0.5},
      {"id": "farbe", "type": "knob", "label": "Colour", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "rausch", "type": "knob", "label": "Noise", "bind": {"param": "k5"}, "format": "percent", "default": 0.5},
      {"id": "hp", "type": "knob", "label": "Low cut", "bind": {"param": "k6"}, "format": "hz", "default": 0.5}
    ]},
    { "id": "src", "title": "SOURCE", "cols": 3, "controls": [
      {"id": "t1", "type": "label", "span": 3, "text": "Six metal oscillators"},
      {"id": "t2", "type": "label", "span": 3, "text": "205 to 800 Hz times Tune"},
      {"id": "t3", "type": "label", "span": 3, "text": "Three band-passes 3.5, 7, 10.5 kHz"},
      {"id": "t4", "type": "label", "span": 3, "text": "4 voices"}
    ]}
  ]
}
