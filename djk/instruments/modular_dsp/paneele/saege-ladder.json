{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "saege-ladder"},
  "title": "Saw Ladder",
  "akzent": "orange",
  "layout": {"rows": [
    ["osc", "filter", "fenv", "aenv", "out"]
  ]},
  "sections": [
    { "id": "osc", "title": "OSCILLATOR", "cols": 2, "controls": [
      {"id": "o1", "type": "label", "span": 2, "text": "One saw, level 50 %"},
      {"id": "o2", "type": "label", "span": 2, "text": "Ladder filter, 4 poles"},
      {"id": "o3", "type": "label", "span": 2, "text": "8 voices"}
    ]},
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Env amount", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "fenv", "title": "FILTER ENV", "cols": 2, "controls": [
      {"id": "fhue", "type": "huelle", "span": 2, "label": "Envelope", "of": {"a": 0.002, "d": "fdecay", "s": "fsus", "r": "release"}},
      {"id": "fdecay", "type": "knob", "label": "Decay", "bind": {"param": "k9"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "fsus", "type": "knob", "label": "Sustain", "bind": {"param": "k10"}, "format": "percent", "default": 0.5},
      {"id": "fn", "type": "label", "span": 2, "text": "Attack 2 ms fixed. Release: AMP ENV"}
    ]},
    { "id": "aenv", "title": "AMP ENV", "cols": 4, "controls": [
      {"id": "ahue", "type": "huelle", "span": 4, "label": "Envelope", "of": {"a": "attack", "d": "decay", "s": "sustain", "r": "release"}},
      {"id": "attack", "type": "knob", "label": "Attack", "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "decay", "type": "knob", "label": "Decay", "bind": {"param": "k5"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "sustain", "type": "knob", "label": "Sustain", "bind": {"param": "k6"}, "format": "percent", "default": 0.5},
      {"id": "release", "type": "knob", "label": "Release", "bind": {"param": "k7"}, "format": "raw", "unit": "s", "default": 0.5},
      {"id": "an", "type": "label", "span": 4, "text": "Release feeds FILTER ENV"}
    ]},
    { "id": "out", "title": "OUT", "cols": 1, "controls": [
      {"id": "level", "type": "knob", "label": "Level", "bind": {"param": "k8"}, "format": "percent", "default": 0.5},
      {"id": "on", "type": "label", "span": 1, "text": "Default 25 %"}
    ]}
  ]
}
