{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "bass-rolling"},
  "title": "Rolling Bass",
  "akzent": "orange",
  "layout": {"rows": [
    ["filter", "amp", "sub"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "env", "type": "knob", "label": "Filter env amount", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "fn", "type": "label", "span": 3, "text": "Filter env decay fixed at 180 ms"}
    ]},
    { "id": "amp", "title": "AMP", "cols": 3, "controls": [
      {"id": "ahue", "type": "huelle", "span": 3, "label": "Amp envelope", "of": {"a": 0.001, "d": "decay", "s": 0, "r": 0.05}},
      {"id": "decay", "type": "knob", "label": "Amp decay", "span": 3, "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "sub", "title": "SUB", "cols": 1, "controls": [
      {"id": "sub", "type": "knob", "label": "Sub level", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
