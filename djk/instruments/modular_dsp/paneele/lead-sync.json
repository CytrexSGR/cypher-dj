{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "lead-sync"},
  "title": "Sync Lead",
  "akzent": "blau",
  "layout": {"rows": [
    ["osc", "out"]
  ]},
  "sections": [
    { "id": "osc", "title": "SYNC & FILTER", "cols": 3, "controls": [
      {"id": "sync", "type": "knob", "label": "Sync pitch", "bind": {"param": "k1"}, "format": "raw", "unit": "st", "default": 0.5},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k2"}, "format": "hz", "default": 0.5},
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k3"}, "format": "db", "default": 0.5},
      {"id": "snote", "type": "label", "span": 3, "text": "Hard-synced saw pair, slow vibrato"}
    ]},
    { "id": "out", "title": "FX", "cols": 2, "controls": [
      {"id": "delay", "type": "knob", "label": "Delay mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
