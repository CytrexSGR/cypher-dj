{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "fx-noise"},
  "title": "Noise Wash",
  "akzent": "tuerkis",
  "layout": {"rows": [
    ["tone", "swell", "out"]
  ]},
  "sections": [
    { "id": "tone", "title": "NOISE", "cols": 3, "controls": [
      {"id": "ahue", "type": "huelle", "span": 3, "label": "Envelope", "of": {"a": "attack", "d": 10, "s": 1, "r": 1}},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "attack", "type": "knob", "label": "Attack", "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "swell", "title": "SWELL", "cols": 2, "controls": [
      {"id": "depth", "type": "knob", "label": "Swell depth", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "rate", "type": "knob", "label": "Swell rate", "bind": {"param": "k3"}, "format": "hz", "default": 0.5, "wirkt": {"ueber": ["depth", 0.02]}, "wirkt_text": "No swell: turn up Swell depth"}
    ]},
    { "id": "out", "title": "FX", "cols": 1, "controls": [
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
