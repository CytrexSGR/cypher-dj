{
 "format": "cypherdj-panel/2",
 "geraet": {
  "art": "bk",
  "graph": "fx-tremolo"
 },
 "title": "Cypher Tremolo",
 "akzent": "tuerkis",
 "layout": {
  "rows": [
   [
    "ratesec",
    "shapesec",
    "outsec"
   ]
  ]
 },
 "sections": [
  {
   "id": "ratesec",
   "title": "RATE",
   "cols": 2,
   "controls": [
    {
     "id": "rmode",
     "type": "selector",
     "label": "Rate mode",
     "bind": {
      "param": "k1"
     },
     "options": [
      "Free",
      "1/16",
      "1/8",
      "1/4",
      "1/2",
      "1 bar",
      "2 bars",
      "4 bars"
     ],
     "default": 3,
     "span": 2
    },
    {
     "id": "rate",
     "type": "knob",
     "label": "Rate",
     "bind": {
      "param": "k2"
     },
     "format": "hz",
     "default": 0.5,
     "wirkt": {
      "ist": [
       "rmode",
       [
        0
       ]
      ]
     },
     "wirkt_text": "Rate mode is synced to the beat: pick Free",
     "span": 2
    }
   ]
  },
  {
   "id": "shapesec",
   "title": "SHAPE",
   "cols": 2,
   "controls": [
    {
     "id": "depth",
     "type": "knob",
     "label": "Depth",
     "bind": {
      "param": "k3"
     },
     "format": "percent",
     "default": 0.5
    },
    {
     "id": "form",
     "type": "knob",
     "label": "Shape",
     "bind": {
      "param": "k4"
     },
     "format": "percent",
     "default": 0.5,
     "wirkt": {
      "alle": [
       {
        "ueber": [
         "depth",
         0.01
        ]
       },
       {
        "ueber": [
         "mix",
         0.01
        ]
       }
      ]
     },
     "wirkt_text": "Needs Depth and Mix above zero"
    },
    {
     "id": "pan",
     "type": "selector",
     "label": "Mode",
     "bind": {
      "param": "k5"
     },
     "options": [
      "Tremolo",
      "Pan"
     ],
     "default": 0,
     "span": 2
    }
   ]
  },
  {
   "id": "outsec",
   "title": "OUT",
   "cols": 1,
   "controls": [
    {
     "id": "mix",
     "type": "knob",
     "label": "Mix",
     "bind": {
      "param": "k6"
     },
     "format": "percent",
     "default": 1
    }
   ]
  }
 ]
}
