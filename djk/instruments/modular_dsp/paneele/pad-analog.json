{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "pad-analog"},
  "title": "Analog Pad",
  "akzent": "violett",
  "layout": {"rows": [
    ["filter", "env", "fx"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 3, "controls": [
      {"id": "fk", "type": "filterkurve", "span": 3, "of": {"cutoff": "cutoff", "reso": "reso"}, "typen": [{"art": "lp", "pole": 4}]},
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5},
      {"id": "reso", "type": "knob", "label": "Resonance", "bind": {"param": "k2"}, "format": "percent", "default": 0.5},
      {"id": "lfod", "type": "knob", "label": "Cutoff LFO depth", "bind": {"param": "k3"}, "format": "raw", "unit": "st", "default": 0.5}
    ]},
    { "id": "env", "title": "AMP ENV", "cols": 1, "controls": [
      {"id": "hue", "type": "huelle", "span": 1, "label": "Envelope", "of": {"a": 0.005, "d": 10, "s": 1, "r": "release"}},
      {"id": "release", "type": "knob", "label": "Release", "bind": {"param": "k4"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "fx", "title": "REVERB", "cols": 1, "controls": [
      {"id": "rmix", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
