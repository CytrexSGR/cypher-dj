{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "rueckkopplung"},
  "title": "Feedback String",
  "akzent": "violett",
  "layout": {"rows": [
    ["exc", "string", "tone", "gate"]
  ]},
  "sections": [
    { "id": "exc", "title": "EXCITER", "cols": 3, "controls": [
      {"id": "bhue", "type": "huelle", "span": 3, "label": "Noise burst", "of": {"a": 0.001, "d": 0.02, "s": 0, "r": 0.01}},
      {"id": "e1", "type": "label", "span": 3, "text": "White noise, one burst per note"}
    ]},
    { "id": "string", "title": "STRING", "cols": 4, "controls": [
      {"id": "tune", "type": "knob", "label": "Tune", "bind": {"param": "k1"}, "format": "raw", "unit": "x", "default": 0.5},
      {"id": "fb", "type": "knob", "label": "Feedback", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "s1", "type": "label", "span": 4, "text": "Delay line at the note pitch x Tune"}
    ]},
    { "id": "tone", "title": "TONE", "cols": 3, "controls": [
      {"id": "colour", "type": "knob", "label": "Colour", "bind": {"param": "k2"}, "format": "raw", "unit": "x", "default": 0.5},
      {"id": "bite", "type": "knob", "label": "Bite", "bind": {"param": "k3"}, "format": "db", "default": 0.5},
      {"id": "t1", "type": "label", "span": 3, "text": "Band-pass at note x Colour, then drive"}
    ]},
    { "id": "gate", "title": "FEEDBACK GATE", "cols": 3, "controls": [
      {"id": "ghue", "type": "huelle", "span": 3, "label": "Feedback level", "of": {"a": 0.005, "d": 0.01, "s": 1, "r": 0.3}},
      {"id": "g1", "type": "label", "span": 3, "text": "Feedback fades with the key, R 300 ms"}
    ]}
  ]
}
