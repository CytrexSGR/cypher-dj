{
  "format": "cypherdj-panel/2",
  "geraet": {"art": "bk", "graph": "lead-mono"},
  "title": "Mono Lead",
  "akzent": "gelb",
  "layout": {"rows": [
    ["filter", "drive", "amp", "fx"]
  ]},
  "sections": [
    { "id": "filter", "title": "FILTER", "cols": 1, "controls": [
      {"id": "cutoff", "type": "knob", "label": "Cutoff", "bind": {"param": "k1"}, "format": "hz", "default": 0.5}
    ]},
    { "id": "drive", "title": "DRIVE", "cols": 1, "controls": [
      {"id": "drive", "type": "knob", "label": "Drive", "bind": {"param": "k2"}, "format": "db", "default": 0.5}
    ]},
    { "id": "amp", "title": "AMP", "cols": 3, "controls": [
      {"id": "ahue", "type": "huelle", "span": 3, "label": "Amp envelope", "of": {"a": 0.001, "d": 10, "s": 1, "r": "release"}},
      {"id": "release", "type": "knob", "label": "Release", "span": 3, "bind": {"param": "k3"}, "format": "raw", "unit": "s", "default": 0.5}
    ]},
    { "id": "fx", "title": "EFFECTS", "cols": 2, "controls": [
      {"id": "dmix", "type": "knob", "label": "Delay mix", "bind": {"param": "k4"}, "format": "percent", "default": 0.5},
      {"id": "hall", "type": "knob", "label": "Hall mix", "bind": {"param": "k5"}, "format": "percent", "default": 0.5}
    ]}
  ]
}
