{
  "format": "baukasten/2",
  "name": "hartsync-pad",
  "stimmen": 8,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Sync pitch", "4": "Sweep depth", "5": "PWM depth",
                   "6": "Attack", "7": "Release", "8": "Chorus"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 300, "max": 12000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0, "max": 0.8},
    {"id": "k_sync", "art": "regler", "nr": 3, "min": 0, "max": 19},
    {"id": "k_sweep", "art": "regler", "nr": 4, "min": 0, "max": 12},
    {"id": "k_pwm", "art": "regler", "nr": 5, "min": 0, "max": 0.9},
    {"id": "k_att", "art": "regler", "nr": 6, "min": 0.005, "max": 2, "log": 1},
    {"id": "k_rel", "art": "regler", "nr": 7, "min": 0.05, "max": 3, "log": 1},
    {"id": "k_chorus", "art": "regler", "nr": 8, "min": 0, "max": 1},
    {"id": "leiter", "art": "saege"},
    {"id": "fahrt", "art": "lfo", "rate": 0.23, "form": 1},
    {"id": "fahrt_st", "art": "mul"},
    {"id": "fahrt_pos", "art": "add", "b": 1},
    {"id": "fahrt_halb", "art": "mul", "b": 0.5},
    {"id": "folger_st", "art": "add"},
    {"id": "ton_f", "art": "transponiere"},
    {"id": "pwm_lfo", "art": "lfo", "rate": 0.7},
    {"id": "pwm", "art": "mul"},
    {"id": "folger", "art": "puls"},
    {"id": "filter", "art": "svf"},
    {"id": "env", "art": "adsr", "a": 0.4, "d": 0.6, "s": 0.8, "r": 0.8},
    {"id": "vca", "art": "mul"},
    {"id": "dcblock", "art": "svf", "cutoff": 25, "reso": 0},
    {"id": "pegel", "art": "mul", "b": 0.09},
    {"id": "chorus", "art": "chorus", "modus": 3},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "leiter.hz"},
    {"von": "fahrt.aus", "nach": "fahrt_pos.a"},
    {"von": "fahrt_pos.aus", "nach": "fahrt_halb.a"},
    {"von": "fahrt_halb.aus", "nach": "fahrt_st.a"},
    {"von": "k_sweep.aus", "nach": "fahrt_st.b"},
    {"von": "k_sync.aus", "nach": "folger_st.a"},
    {"von": "fahrt_st.aus", "nach": "folger_st.b"},
    {"von": "note.hz", "nach": "ton_f.hz"},
    {"von": "folger_st.aus", "nach": "ton_f.st"},
    {"von": "ton_f.aus", "nach": "folger.hz"},
    {"von": "pwm_lfo.aus", "nach": "pwm.a"},
    {"von": "k_pwm.aus", "nach": "pwm.b"},
    {"von": "pwm.aus", "nach": "folger.pwm"},
    {"von": "leiter.hart", "nach": "folger.hart"},
    {"von": "folger.aus", "nach": "filter.x"},
    {"von": "k_cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_att.aus", "nach": "env.a"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "filter.tp", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "dcblock.x"},
    {"von": "dcblock.hp", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "chorus.x"},
    {"von": "k_chorus.aus", "nach": "chorus.mix"},
    {"von": "chorus.l", "nach": "aus.l"},
    {"von": "chorus.r", "nach": "aus.r"}
  ]
}
