{
  "format": "baukasten/2",
  "name": "pad-analog",
  "stimmen": 8,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "LFO depth", "4": "Release", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 400, "max": 3600, "log": 1},
    {"id": "k_resonance", "art": "regler", "nr": 2, "min": 0.3, "max": 0.9},
    {"id": "k_lfo_depth", "art": "regler", "nr": 3, "min": 0, "max": 12},
    {"id": "k_release", "art": "regler", "nr": 4, "min": 0.5625, "max": 9, "log": 1},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.7},
    {"id": "ton1", "art": "transponiere", "st": 0, "cent": -11},
    {"id": "square1", "art": "puls", "pwm": 0},
    {"id": "ton2", "art": "transponiere", "st": 24, "cent": 11},
    {"id": "square2", "art": "puls", "pwm": 0},
    {"id": "cut_lfo", "art": "lfo", "rate": 0.3},
    {"id": "mix", "art": "add"},
    {"id": "vor", "art": "mul", "b": 0.35},
    {"id": "lfo_st", "art": "mul"},
    {"id": "cutoff", "art": "transponiere", "cent": 0},
    {"id": "filter", "art": "ladder"},
    {"id": "env", "art": "adsr", "a": 0.005, "d": 10, "s": 1, "r": 0},
    {"id": "vca1", "art": "mul"},
    {"id": "chorus", "art": "chorus", "mix": 1},
    {"id": "phaser", "art": "phaser", "mix": 0.25, "rate": 0.15},
    {"id": "hall", "art": "hall", "decay": 4},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.3981},
    {"id": "pegel_r", "art": "mul", "b": 0.3981}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "ton1.hz"},
    {"von": "ton1.aus", "nach": "square1.hz"},
    {"von": "note.hz", "nach": "ton2.hz"},
    {"von": "ton2.aus", "nach": "square2.hz"},
    {"von": "square1.aus", "nach": "mix.a"},
    {"von": "square2.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "vor.a"},
    {"von": "cut_lfo.aus", "nach": "lfo_st.a"},
    {"von": "k_lfo_depth.aus", "nach": "lfo_st.b"},
    {"von": "k_cutoff.aus", "nach": "cutoff.hz"},
    {"von": "lfo_st.aus", "nach": "cutoff.st"},
    {"von": "vor.aus", "nach": "filter.x"},
    {"von": "cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_resonance.aus", "nach": "filter.reso"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_release.aus", "nach": "env.r"},
    {"von": "filter.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "chorus.x"},
    {"von": "chorus.l", "nach": "phaser.l"},
    {"von": "chorus.r", "nach": "phaser.r"},
    {"von": "phaser.l", "nach": "hall.l"},
    {"von": "phaser.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
