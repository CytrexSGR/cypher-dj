{
  "format": "baukasten/2",
  "name": "lead-poly",
  "stimmen": 8,
  "regler_namen": {"1": "Cutoff", "2": "Env amount", "3": "PWM depth", "4": "Delay mix", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 10, "max": 160, "log": 1},
    {"id": "k_env_amount", "art": "regler", "nr": 2, "min": 60, "max": 180},
    {"id": "k_pwm_depth", "art": "regler", "nr": 3, "min": 0, "max": 0.9},
    {"id": "k_delay_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.3},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.4},
    {"id": "pwm_lfo", "art": "lfo", "form": 1, "rate": 5.5},
    {"id": "pwm", "art": "mul"},
    {"id": "ton1", "art": "transponiere", "st": 0, "cent": -10},
    {"id": "pulse1", "art": "puls"},
    {"id": "ton2", "art": "transponiere", "st": 12, "cent": 10},
    {"id": "pwm2", "art": "add", "b": -0.6667},
    {"id": "pulse2", "art": "puls"},
    {"id": "mix", "art": "add"},
    {"id": "vor", "art": "mul", "b": 0.4},
    {"id": "dc_osz", "art": "svf", "cutoff": 20, "reso": 0},
    {"id": "fenv", "art": "adsr", "a": 0.03, "d": 10, "s": 1, "r": 0.6},
    {"id": "m1", "art": "mul"},
    {"id": "cut1", "art": "transponiere", "cent": 0},
    {"id": "filter", "art": "ladder", "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.001, "d": 10, "s": 1, "r": 0.35},
    {"id": "vca1", "art": "mul"},
    {"id": "chorus", "art": "chorus", "mix": 1},
    {"id": "delay", "art": "delay", "takt": 0.5, "fb": 0.3},
    {"id": "hall", "art": "hall", "decay": 2},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.1153},
    {"id": "pegel_r", "art": "mul", "b": 0.1153}
  ],
  "kanten": [
    {"von": "pwm_lfo.aus", "nach": "pwm.a"},
    {"von": "k_pwm_depth.aus", "nach": "pwm.b"},
    {"von": "note.hz", "nach": "ton1.hz"},
    {"von": "ton1.aus", "nach": "pulse1.hz"},
    {"von": "pwm.aus", "nach": "pulse1.pwm"},
    {"von": "note.hz", "nach": "ton2.hz"},
    {"von": "pwm.aus", "nach": "pwm2.a"},
    {"von": "ton2.aus", "nach": "pulse2.hz"},
    {"von": "pwm2.aus", "nach": "pulse2.pwm"},
    {"von": "pulse1.aus", "nach": "mix.a"},
    {"von": "pulse2.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "vor.a"},
    {"von": "vor.aus", "nach": "dc_osz.x"},
    {"von": "note.gate", "nach": "fenv.gate"},
    {"von": "note.trig", "nach": "fenv.trig"},
    {"von": "fenv.aus", "nach": "m1.a"},
    {"von": "k_env_amount.aus", "nach": "m1.b"},
    {"von": "k_cutoff.aus", "nach": "cut1.hz"},
    {"von": "m1.aus", "nach": "cut1.st"},
    {"von": "dc_osz.hp", "nach": "filter.x"},
    {"von": "cut1.aus", "nach": "filter.cutoff"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "filter.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "chorus.x"},
    {"von": "chorus.l", "nach": "delay.l"},
    {"von": "chorus.r", "nach": "delay.r"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "hall.l"},
    {"von": "delay.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
