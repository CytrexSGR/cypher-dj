{
  "format": "baukasten/2",
  "name": "pad-granular",
  "stimmen": 8,
  "regler_namen": {"1": "Position", "2": "Motion", "3": "Cutoff", "4": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_position", "art": "regler", "nr": 1, "min": 0, "max": 0.8},
    {"id": "k_motion", "art": "regler", "nr": 2, "min": 0, "max": 0.5},
    {"id": "k_cutoff", "art": "regler", "nr": 3, "min": 1520, "max": 9500, "log": 1},
    {"id": "k_hall_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.9},
    {"id": "scan_lfo", "art": "lfo", "rate": 0.07},
    {"id": "jitter_lfo", "art": "lfo", "form": 4, "rate": 3},
    {"id": "jitter", "art": "glatt", "zeit": 0.08},
    {"id": "jitter_pegel", "art": "mul", "b": 0.3},
    {"id": "bewegung", "art": "add"},
    {"id": "pos_mod", "art": "mul"},
    {"id": "position", "art": "add"},
    {"id": "cloud", "art": "wavetable", "tabelle": 4, "kopien": 5, "glatt": 40, "verstimmung": 15, "breite": 0.8},
    {"id": "env", "art": "adsr", "a": 1, "d": 3, "s": 0.9, "r": 2.5},
    {"id": "lp_l", "art": "svf", "pole": 4, "reso": 0},
    {"id": "vca1", "art": "mul"},
    {"id": "lp_r", "art": "svf", "pole": 4, "reso": 0},
    {"id": "vca2", "art": "mul"},
    {"id": "hall", "art": "hall", "decay": 8},
    {"id": "chorus_in", "art": "add"},
    {"id": "chorus", "art": "chorus", "mix": 1},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.0823},
    {"id": "pegel_r", "art": "mul", "b": 0.0823}
  ],
  "kanten": [
    {"von": "jitter_lfo.aus", "nach": "jitter.x"},
    {"von": "jitter.aus", "nach": "jitter_pegel.a"},
    {"von": "scan_lfo.aus", "nach": "bewegung.a"},
    {"von": "jitter_pegel.aus", "nach": "bewegung.b"},
    {"von": "bewegung.aus", "nach": "pos_mod.a"},
    {"von": "k_motion.aus", "nach": "pos_mod.b"},
    {"von": "k_position.aus", "nach": "position.a"},
    {"von": "pos_mod.aus", "nach": "position.b"},
    {"von": "note.hz", "nach": "cloud.hz"},
    {"von": "note.trig", "nach": "cloud.trig"},
    {"von": "position.aus", "nach": "cloud.pos"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "cloud.l", "nach": "lp_l.x"},
    {"von": "k_cutoff.aus", "nach": "lp_l.cutoff"},
    {"von": "lp_l.tp", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "cloud.r", "nach": "lp_r.x"},
    {"von": "k_cutoff.aus", "nach": "lp_r.cutoff"},
    {"von": "lp_r.tp", "nach": "vca2.a"},
    {"von": "env.aus", "nach": "vca2.b"},
    {"von": "vca1.aus", "nach": "hall.l"},
    {"von": "vca2.aus", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "chorus_in.a"},
    {"von": "hall.r", "nach": "chorus_in.b"},
    {"von": "chorus_in.aus", "nach": "chorus.x"},
    {"von": "chorus.l", "nach": "dcblock_l.x"},
    {"von": "chorus.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
