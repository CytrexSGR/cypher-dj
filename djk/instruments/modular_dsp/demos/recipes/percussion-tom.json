{
  "format": "baukasten/2",
  "name": "percussion-tom",
  "stimmen": 1,
  "regler_namen": {"1": "Tune", "2": "Pitch drop", "3": "Decay", "4": "Env amount", "5": "Room mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_tune", "art": "regler", "nr": 1, "min": 55, "max": 220, "log": 1},
    {"id": "k_pitch_drop", "art": "regler", "nr": 2, "min": 0, "max": 10},
    {"id": "k_decay", "art": "regler", "nr": 3, "min": 0.15, "max": 2.4, "log": 1},
    {"id": "k_env_amount", "art": "regler", "nr": 4, "min": 21, "max": 63},
    {"id": "k_room_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.3},
    {"id": "pitch_env", "art": "adsr", "a": 0.0005, "d": 0.1, "s": 0, "r": 0.1},
    {"id": "pitch_st", "art": "mul"},
    {"id": "pitch", "art": "transponiere", "cent": 0},
    {"id": "square1", "art": "puls", "pwm": 0},
    {"id": "ton2", "art": "transponiere", "st": -10, "cent": 0},
    {"id": "square2", "art": "puls", "pwm": 0},
    {"id": "mix", "art": "add"},
    {"id": "fenv", "art": "adsr", "a": 0.0005, "d": 0.35, "s": 0, "r": 0.3},
    {"id": "vor", "art": "mul", "b": 0.4},
    {"id": "m1", "art": "mul"},
    {"id": "cut1", "art": "transponiere", "hz": 800, "cent": 0},
    {"id": "filter", "art": "ladder", "reso": 0.45},
    {"id": "env", "art": "adsr", "a": 0.0005, "d": 0, "s": 0, "r": 0.4},
    {"id": "vca1", "art": "mul"},
    {"id": "hall", "art": "hall", "decay": 0.5, "groesse": 15},
    {"id": "komp", "art": "komp", "ratio": 4, "schwelle": -18},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 1.209},
    {"id": "pegel_r", "art": "mul", "b": 1.209}
  ],
  "kanten": [
    {"von": "note.gate", "nach": "pitch_env.gate"},
    {"von": "note.trig", "nach": "pitch_env.trig"},
    {"von": "pitch_env.aus", "nach": "pitch_st.a"},
    {"von": "k_pitch_drop.aus", "nach": "pitch_st.b"},
    {"von": "k_tune.aus", "nach": "pitch.hz"},
    {"von": "pitch_st.aus", "nach": "pitch.st"},
    {"von": "pitch.aus", "nach": "square1.hz"},
    {"von": "pitch.aus", "nach": "ton2.hz"},
    {"von": "ton2.aus", "nach": "square2.hz"},
    {"von": "square1.aus", "nach": "mix.a"},
    {"von": "square2.aus", "nach": "mix.b"},
    {"von": "note.gate", "nach": "fenv.gate"},
    {"von": "note.trig", "nach": "fenv.trig"},
    {"von": "mix.aus", "nach": "vor.a"},
    {"von": "fenv.aus", "nach": "m1.a"},
    {"von": "k_env_amount.aus", "nach": "m1.b"},
    {"von": "m1.aus", "nach": "cut1.st"},
    {"von": "vor.aus", "nach": "filter.x"},
    {"von": "cut1.aus", "nach": "filter.cutoff"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_decay.aus", "nach": "env.d"},
    {"von": "filter.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "hall.x"},
    {"von": "k_room_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "komp.l"},
    {"von": "hall.r", "nach": "komp.r"},
    {"von": "komp.l", "nach": "dcblock_l.x"},
    {"von": "komp.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
