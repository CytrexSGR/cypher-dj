{
  "format": "baukasten/2",
  "name": "chip-rauschen",
  "stimmen": 1,
  "regler_namen": {"1": "Pitch", "2": "Sweep", "3": "Sweep time", "4": "Decay", "5": "Short mode", "6": "Level"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_pitch", "art": "regler", "nr": 1, "min": 2, "max": 128, "log": 1, "vorgabe": 0.5},
    {"id": "k_sweep", "art": "regler", "nr": 2, "min": 0, "max": 48, "vorgabe": 0.25},
    {"id": "k_sdec", "art": "regler", "nr": 3, "min": 5, "max": 500, "log": 1, "vorgabe": 0.5},
    {"id": "k_decay", "art": "regler", "nr": 4, "min": 10, "max": 1500, "log": 1, "vorgabe": 0.5},
    {"id": "k_kurz", "art": "regler", "nr": 5, "min": 0, "max": 1, "vorgabe": 0},
    {"id": "k_lvl", "art": "regler", "nr": 6, "min": 0, "max": 1, "vorgabe": 0.8},
    {"id": "takt0", "art": "mul"},
    {"id": "sdec_s", "art": "mul", "b": 0.001},
    {"id": "dec_s", "art": "mul", "b": 0.001},
    {"id": "penv", "art": "adsr", "a": 0.0005, "d": 0.05, "s": 0, "r": 0.05},
    {"id": "pst", "art": "mul"},
    {"id": "takt", "art": "transponiere"},
    {"id": "lang", "art": "lfsr", "kurz": 0},
    {"id": "kurz", "art": "lfsr", "kurz": 1},
    {"id": "modus", "art": "wahl", "n": 2, "blende": 2},
    {"id": "huelle", "art": "adsr", "a": 0.0005, "d": 0.12, "s": 0, "r": 0.12},
    {"id": "stufe", "art": "mul", "b": 0.9375},
    {"id": "vier_bit", "art": "krume", "bits": 5, "rate": 48000},
    {"id": "g1", "art": "mul"},
    {"id": "g2", "art": "mul"},
    {"id": "halb", "art": "mul", "b": 0.5},
    {"id": "aus_m", "art": "mul"},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "takt0.a"},
    {"von": "k_pitch.aus", "nach": "takt0.b"},
    {"von": "k_sdec.aus", "nach": "sdec_s.a"},
    {"von": "k_decay.aus", "nach": "dec_s.a"},
    {"von": "note.gate", "nach": "penv.gate"},
    {"von": "note.trig", "nach": "penv.trig"},
    {"von": "sdec_s.aus", "nach": "penv.d"},
    {"von": "sdec_s.aus", "nach": "penv.r"},
    {"von": "penv.aus", "nach": "pst.a"},
    {"von": "k_sweep.aus", "nach": "pst.b"},
    {"von": "takt0.aus", "nach": "takt.hz"},
    {"von": "pst.aus", "nach": "takt.st"},
    {"von": "takt.aus", "nach": "lang.hz"},
    {"von": "takt.aus", "nach": "kurz.hz"},
    {"von": "lang.aus", "nach": "modus.e1"},
    {"von": "kurz.aus", "nach": "modus.e2"},
    {"von": "k_kurz.aus", "nach": "modus.wahl"},
    {"von": "note.gate", "nach": "huelle.gate"},
    {"von": "note.trig", "nach": "huelle.trig"},
    {"von": "dec_s.aus", "nach": "huelle.d"},
    {"von": "dec_s.aus", "nach": "huelle.r"},
    {"von": "huelle.aus", "nach": "stufe.a"},
    {"von": "stufe.aus", "nach": "vier_bit.x"},
    {"von": "vier_bit.aus", "nach": "g1.a"},
    {"von": "note.vel", "nach": "g1.b"},
    {"von": "g1.aus", "nach": "g2.a"},
    {"von": "k_lvl.aus", "nach": "g2.b"},
    {"von": "modus.aus", "nach": "halb.a"},
    {"von": "halb.aus", "nach": "aus_m.a"},
    {"von": "g2.aus", "nach": "aus_m.b"},
    {"von": "aus_m.aus", "nach": "aus.x"}
  ]
}
