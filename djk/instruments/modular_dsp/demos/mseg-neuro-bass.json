{
  "format": "baukasten/2",
  "name": "mseg-neuro-bass",
  "stimmen": 1,
  "regler_namen": {"1": "Base cutoff", "2": "Depth", "3": "Resonance"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_mitte", "art": "regler", "nr": 1, "min": 40, "max": 400, "log": 1},
    {"id": "k_tiefe", "art": "regler", "nr": 2, "min": 0, "max": 72},
    {"id": "k_reso", "art": "regler", "nr": 3, "min": 0, "max": 0.8},
    {"id": "saw", "art": "saege"},
    {"id": "unten", "art": "transponiere", "st": -12},
    {"id": "sub", "art": "sinus"},
    {"id": "saw_pegel", "art": "mul", "b": 0.5},
    {"id": "sub_pegel", "art": "mul", "b": 0.5},
    {"id": "summe", "art": "add"},
    {"id": "form", "art": "mseg", "stufen": 4, "halt": 0, "von": 2, "bis": 3,
      "p1": 1, "t1": 0.01, "p2": 0.1, "t2": 0.14, "k2": -0.6, "p3": 0.85, "t3": 0.1, "k3": 0.5, "p4": 0, "t4": 0.2},
    {"id": "tiefe", "art": "mul"},
    {"id": "schnitt", "art": "transponiere"},
    {"id": "filter", "art": "ladder"},
    {"id": "env", "art": "adsr", "a": 0.003, "d": 0.3, "s": 0.8, "r": 0.12},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.5},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "saw.hz"},
    {"von": "note.hz", "nach": "unten.hz"},
    {"von": "unten.aus", "nach": "sub.hz"},
    {"von": "saw.aus", "nach": "saw_pegel.a"},
    {"von": "sub.aus", "nach": "sub_pegel.a"},
    {"von": "saw_pegel.aus", "nach": "summe.a"},
    {"von": "sub_pegel.aus", "nach": "summe.b"},
    {"von": "summe.aus", "nach": "filter.x"},
    {"von": "note.gate", "nach": "form.gate"},
    {"von": "note.trig", "nach": "form.trig"},
    {"von": "form.aus", "nach": "tiefe.a"},
    {"von": "k_tiefe.aus", "nach": "tiefe.b"},
    {"von": "k_mitte.aus", "nach": "schnitt.hz"},
    {"von": "tiefe.aus", "nach": "schnitt.st"},
    {"von": "schnitt.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "filter.aus", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "aus.x"}
  ]
