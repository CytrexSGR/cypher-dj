{
  "format": "baukasten/2",
  "name": "fm-lead",
  "stimmen": 1,
  "regler_namen": {"1": "Brightness", "2": "Feedback", "3": "Vibrato", "4": "Decay", "5": "Echo"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_hell", "art": "regler", "nr": 1, "min": 0, "max": 2},
    {"id": "k_rueck", "art": "regler", "nr": 2, "min": 0, "max": 1},
    {"id": "k_vib", "art": "regler", "nr": 3, "min": 0, "max": 0.6},
    {"id": "k_zeit", "art": "regler", "nr": 4, "min": 0.25, "max": 4, "log": 1},
    {"id": "k_echo", "art": "regler", "nr": 5, "min": 0, "max": 0.5},
    {"id": "glide", "art": "glatt", "zeit": 0.05},
    {"id": "vibrato", "art": "lfo", "rate": 5.5},
    {"id": "vib_st", "art": "mul"},
    {"id": "ton", "art": "transponiere"},
    {"id": "fm", "art": "fm", "algo": 0, "anschlag": 0.4,
     "o1_verh": 1, "o1_pegel": 1, "o1_a": 0.004, "o1_d": 2, "o1_s": 0.8, "o1_r": 0.2,
     "o2_verh": 1, "o2_pegel": 0.16, "o2_a": 0.01, "o2_d": 1.2, "o2_s": 0.6, "o2_r": 0.2,
     "o3_verh": 2, "o3_pegel": 0.07, "o3_a": 0.001, "o3_d": 0.6, "o3_s": 0.4, "o3_r": 0.2,
     "o4_verh": 1, "o4_fein": 5, "o4_pegel": 0.08, "o4_a": 0.001, "o4_d": 0.8, "o4_s": 0.5, "o4_r": 0.2},
    {"id": "pegel", "art": "mul", "b": 0.4},
    {"id": "echo", "art": "delay", "zeit": 330, "fb": 0.35, "daempf": 3500, "pingpong": 1},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "glide.x"},
    {"von": "note.erste", "nach": "glide.setzen"},
    {"von": "vibrato.aus", "nach": "vib_st.a"},
    {"von": "k_vib.aus", "nach": "vib_st.b"},
    {"von": "glide.aus", "nach": "ton.hz"},
    {"von": "vib_st.aus", "nach": "ton.st"},
    {"von": "ton.aus", "nach": "fm.hz"},
    {"von": "note.gate", "nach": "fm.gate"},
    {"von": "note.trig", "nach": "fm.trig"},
    {"von": "note.vel", "nach": "fm.vel"},
    {"von": "k_hell.aus", "nach": "fm.index"},
    {"von": "k_rueck.aus", "nach": "fm.rueck"},
    {"von": "k_zeit.aus", "nach": "fm.zeit"},
    {"von": "fm.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "echo.x"},
    {"von": "k_echo.aus", "nach": "echo.mix"},
    {"von": "echo.l", "nach": "aus.l"},
    {"von": "echo.r", "nach": "aus.r"}
  ]
}
