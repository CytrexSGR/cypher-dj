{
  "format": "baukasten/2",
  "name": "wavetable-chor",
  "stimmen": 8,
  "regler_namen": {"1": "Vowel", "2": "Vowel motion", "3": "Detune", "4": "Width", "5": "Attack", "6": "Release", "7": "Wave env amount", "8": "Wave env attack", "9": "Wave env decay"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_vokal", "art": "regler", "nr": 1, "min": 0, "max": 1},
    {"id": "k_bewegung", "art": "regler", "nr": 2, "min": 0, "max": 0.5},
    {"id": "k_det", "art": "regler", "nr": 3, "min": 0, "max": 30},
    {"id": "k_breite", "art": "regler", "nr": 4, "min": 0, "max": 1},
    {"id": "k_att", "art": "regler", "nr": 5, "min": 0.02, "max": 2, "log": 1},
    {"id": "k_rel", "art": "regler", "nr": 6, "min": 0.1, "max": 4, "log": 1},
    {"id": "lfo", "art": "lfo", "rate": 0.15},
    {"id": "bewegung", "art": "mul"},
    {"id": "pos", "art": "add"},
    {"id": "osz", "art": "wavetable", "tabelle": 5, "kopien": 5, "glatt": 30},
    {"id": "env", "art": "adsr", "a": 0.3, "d": 0.5, "s": 0.9, "r": 1.0},
    {"id": "vca_l", "art": "mul"},
    {"id": "vca_r", "art": "mul"},
    {"id": "pegel_l", "art": "mul", "b": 0.2},
    {"id": "pegel_r", "art": "mul", "b": 0.2},
    {"id": "aus", "art": "ausgang"},
    {"id": "k_wamt", "art": "regler", "nr": 7, "min": -1, "max": 1},
    {"id": "k_watt", "art": "regler", "nr": 8, "min": 0.005, "max": 4, "log": 1},
    {"id": "k_wdec", "art": "regler", "nr": 9, "min": 0.05, "max": 6, "log": 1},
    {"id": "wenv", "art": "adsr", "a": 0.01, "d": 0.5, "s": 0, "r": 0.3},
    {"id": "wmod", "art": "mul"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "osz.hz"},
    {"von": "note.trig", "nach": "osz.trig"},
    {"von": "lfo.aus", "nach": "bewegung.a"},
    {"von": "k_bewegung.aus", "nach": "bewegung.b"},
    {"von": "k_vokal.aus", "nach": "pos.a"},
    {"von": "bewegung.aus", "nach": "pos.b"},
    {"von": "pos.aus", "nach": "osz.pos"},
    {"von": "k_det.aus", "nach": "osz.verstimmung"},
    {"von": "k_breite.aus", "nach": "osz.breite"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_att.aus", "nach": "env.a"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "osz.l", "nach": "vca_l.a"},
    {"von": "osz.r", "nach": "vca_r.a"},
    {"von": "env.aus", "nach": "vca_l.b"},
    {"von": "env.aus", "nach": "vca_r.b"},
    {"von": "vca_l.aus", "nach": "pegel_l.a"},
    {"von": "vca_r.aus", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"},
    {"von": "note.gate", "nach": "wenv.gate"},
    {"von": "note.trig", "nach": "wenv.trig"},
    {"von": "k_watt.aus", "nach": "wenv.a"},
    {"von": "k_wdec.aus", "nach": "wenv.d"},
    {"von": "wenv.aus", "nach": "wmod.a"},
    {"von": "k_wamt.aus", "nach": "wmod.b"},
    {"von": "wmod.aus", "nach": "pos.c"}
  ]
}
