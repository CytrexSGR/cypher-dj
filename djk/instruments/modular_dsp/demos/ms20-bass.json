{
  "format": "baukasten/2",
  "name": "ms20-bass",
  "stimmen": 8,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Drive", "4": "Filter env"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 60, "max": 800, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0.3, "max": 0.95},
    {"id": "k_drive", "art": "regler", "nr": 3, "min": 0, "max": 1},
    {"id": "k_fenv", "art": "regler", "nr": 4, "min": 0, "max": 4000},
    {"id": "saege", "art": "saege"},
    {"id": "puls", "art": "puls", "pwm": 0.0},
    {"id": "pegel_saege", "art": "mul", "b": 0.5},
    {"id": "pegel_puls", "art": "mul", "b": 0.4},
    {"id": "mix", "art": "add"},
    {"id": "fenv", "art": "adsr", "a": 0.002, "d": 0.25, "s": 0.1, "r": 0.2},
    {"id": "fenv_hz", "art": "mul"},
    {"id": "cutoff", "art": "add"},
    {"id": "filter", "art": "ms20", "modus": 1},
    {"id": "dcblock", "art": "svf", "cutoff": 25, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.003, "d": 0.3, "s": 0.8, "r": 0.15},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.15},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "saege.hz"},
    {"von": "note.hz", "nach": "puls.hz"},
    {"von": "saege.aus", "nach": "pegel_saege.a"},
    {"von": "puls.aus", "nach": "pegel_puls.a"},
    {"von": "pegel_saege.aus", "nach": "mix.a"},
    {"von": "pegel_puls.aus", "nach": "mix.b"},
    {"von": "note.gate", "nach": "fenv.gate"},
    {"von": "note.trig", "nach": "fenv.trig"},
    {"von": "fenv.aus", "nach": "fenv_hz.a"},
    {"von": "k_fenv.aus", "nach": "fenv_hz.b"},
    {"von": "k_cutoff.aus", "nach": "cutoff.a"},
    {"von": "fenv_hz.aus", "nach": "cutoff.b"},
    {"von": "mix.aus", "nach": "filter.x"},
    {"von": "cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},
    {"von": "k_drive.aus", "nach": "filter.antrieb"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "filter.tp", "nach": "dcblock.x"},
    {"von": "dcblock.hp", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "aus.x"}
  ]
