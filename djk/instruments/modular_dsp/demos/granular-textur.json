{
  "format": "baukasten/2",
  "name": "granular-textur",
  "stimmen": 8,
  "regler_namen": {"1": "Grain size", "2": "Density", "3": "Pitch", "4": "Resonance", "5": "Width", "6": "Attack", "7": "Release"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_groesse", "art": "regler", "nr": 1, "min": 2, "max": 80, "log": 1},
    {"id": "k_dichte", "art": "regler", "nr": 2, "min": 20, "max": 800, "log": 1},
    {"id": "k_ton", "art": "regler", "nr": 3, "min": -24, "max": 24},
    {"id": "k_reso", "art": "regler", "nr": 4, "min": 0.3, "max": 0.95},
    {"id": "k_breite", "art": "regler", "nr": 5, "min": 0, "max": 1},
    {"id": "k_att", "art": "regler", "nr": 6, "min": 0.005, "max": 2, "log": 1},
    {"id": "k_rel", "art": "regler", "nr": 7, "min": 0.05, "max": 3, "log": 1},
    {"id": "korn", "art": "granular", "quelle": 2, "puffer": 1, "pos": 0.5, "pos_zufall": 1, "ton_zufall": 200, "streuung": 1, "saat": 2},
    {"id": "filter_l", "art": "svf"},
    {"id": "filter_r", "art": "svf"},
    {"id": "env", "art": "adsr", "a": 0.05, "d": 0.3, "s": 0.8, "r": 0.6},
    {"id": "vca_l", "art": "mul"},
    {"id": "vca_r", "art": "mul"},
    {"id": "pegel_l", "art": "mul", "b": 1.0},
    {"id": "pegel_r", "art": "mul", "b": 1.0},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "korn.hz"},
    {"von": "note.trig", "nach": "korn.trig"},
    {"von": "k_groesse.aus", "nach": "korn.groesse"},
    {"von": "k_dichte.aus", "nach": "korn.dichte"},
    {"von": "k_ton.aus", "nach": "korn.tonhoehe"},
    {"von": "k_breite.aus", "nach": "korn.breite"},
    {"von": "korn.l", "nach": "filter_l.x"},
    {"von": "korn.r", "nach": "filter_r.x"},
    {"von": "note.hz", "nach": "filter_l.cutoff"},
    {"von": "note.hz", "nach": "filter_r.cutoff"},
    {"von": "k_reso.aus", "nach": "filter_l.reso"},
    {"von": "k_reso.aus", "nach": "filter_r.reso"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_att.aus", "nach": "env.a"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "filter_l.bp", "nach": "vca_l.a"},
    {"von": "filter_r.bp", "nach": "vca_r.a"},
    {"von": "env.aus", "nach": "vca_l.b"},
    {"von": "env.aus", "nach": "vca_r.b"},
    {"von": "vca_l.aus", "nach": "pegel_l.a"},
    {"von": "vca_r.aus", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
