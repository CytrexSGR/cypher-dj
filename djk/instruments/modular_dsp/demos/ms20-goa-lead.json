{
  "format": "baukasten/2",
  "name": "ms20-goa-lead",
  "stimmen": 4,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Drive", "4": "LFO depth", "5": "Filter env", "6": "Detune"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 300, "max": 5000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0.7, "max": 1},
    {"id": "k_drive", "art": "regler", "nr": 3, "min": 0, "max": 1},
    {"id": "k_lfo", "art": "regler", "nr": 4, "min": 0, "max": 3000},
    {"id": "k_fenv", "art": "regler", "nr": 5, "min": 0, "max": 5000},
    {"id": "k_detune", "art": "regler", "nr": 6, "min": 0, "max": 30},
    {"id": "glide", "art": "glatt", "zeit": 0.05},
    {"id": "osz1", "art": "saege"},
    {"id": "ton2", "art": "transponiere"},
    {"id": "osz2", "art": "saege"},
    {"id": "pegel1", "art": "mul", "b": 0.5},
    {"id": "pegel2", "art": "mul", "b": 0.5},
    {"id": "mix", "art": "add"},
    {"id": "lfo", "art": "lfo", "rate": 0.35, "form": 1},
    {"id": "lfo_hz", "art": "mul"},
    {"id": "fenv", "art": "adsr", "a": 0.002, "d": 0.5, "s": 0.2, "r": 0.3},
    {"id": "fenv_hz", "art": "mul"},
    {"id": "cutoff", "art": "add"},
    {"id": "filter", "art": "ms20", "modus": 1},
    {"id": "dcblock", "art": "svf", "cutoff": 25, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.004, "d": 0.3, "s": 0.85, "r": 0.25},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.15},
    {"id": "aus", "art": "ausgang"}
