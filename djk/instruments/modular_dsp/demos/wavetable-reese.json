{
  "format": "baukasten/2",
  "name": "wavetable-reese",
  "stimmen": 2,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Detune", "4": "Width", "5": "Drive", "6": "Release"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 120, "max": 6000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0, "max": 0.7},
    {"id": "k_det", "art": "regler", "nr": 3, "min": 0, "max": 30},
    {"id": "k_breite", "art": "regler", "nr": 4, "min": 0, "max": 1},
    {"id": "k_drive", "art": "regler", "nr": 5, "min": 0, "max": 18},
    {"id": "k_rel", "art": "regler", "nr": 6, "min": 0.02, "max": 1, "log": 1},
    {"id": "osz", "art": "wavetable", "tabelle": 0, "kopien": 2},
    {"id": "filter_l", "art": "svf", "pole": 4},
    {"id": "filter_r", "art": "svf", "pole": 4},
    {"id": "drive_l", "art": "saett"},
    {"id": "drive_r", "art": "saett"},
    {"id": "dcblock_l", "art": "svf", "cutoff": 25, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 25, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.004, "d": 0.2, "s": 0.9, "r": 0.15},
    {"id": "vca_l", "art": "mul"},
    {"id": "vca_r", "art": "mul"},
    {"id": "pegel_l", "art": "mul", "b": 0.2},
    {"id": "pegel_r", "art": "mul", "b": 0.2},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "osz.hz"},
    {"von": "note.trig", "nach": "osz.trig"},
    {"von": "k_det.aus", "nach": "osz.verstimmung"},
    {"von": "k_breite.aus", "nach": "osz.breite"},
    {"von": "osz.l", "nach": "filter_l.x"},
    {"von": "osz.r", "nach": "filter_r.x"},
    {"von": "k_cutoff.aus", "nach": "filter_l.cutoff"},
    {"von": "k_cutoff.aus", "nach": "filter_r.cutoff"},
    {"von": "k_reso.aus", "nach": "filter_l.reso"},
    {"von": "k_reso.aus", "nach": "filter_r.reso"},
    {"von": "filter_l.tp", "nach": "drive_l.x"},
    {"von": "filter_r.tp", "nach": "drive_r.x"},
    {"von": "k_drive.aus", "nach": "drive_l.antrieb"},
    {"von": "k_drive.aus", "nach": "drive_r.antrieb"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "drive_l.aus", "nach": "dcblock_l.x"},
    {"von": "drive_r.aus", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "vca_l.a"},
    {"von": "dcblock_r.hp", "nach": "vca_r.a"},
    {"von": "env.aus", "nach": "vca_l.b"},
    {"von": "env.aus", "nach": "vca_r.b"},
    {"von": "vca_l.aus", "nach": "pegel_l.a"},
    {"von": "vca_r.aus", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
