{
  "format": "baukasten/2",
  "name": "saite-klavier",
  "stimmen": 16,
  "regler_namen": {"1": "Decay", "2": "Damping", "3": "Hardness", "4": "Hammer position", "5": "Soundboard", "6": "Damper"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_decay", "art": "regler", "nr": 1, "min": 2, "max": 20, "log": 1},
    {"id": "k_damp", "art": "regler", "nr": 2, "min": 0, "max": 1},
    {"id": "k_hell", "art": "regler", "nr": 3, "min": 0, "max": 1},
    {"id": "k_lage", "art": "regler", "nr": 4, "min": 0.06, "max": 0.25},
    {"id": "k_body", "art": "regler", "nr": 5, "min": 0, "max": 1},
    {"id": "k_rel", "art": "regler", "nr": 6, "min": 0.05, "max": 1, "log": 1},
    {"id": "saite", "art": "saite", "anreger": 2, "koerper": 3},
    {"id": "halt", "art": "mul"},
    {"id": "los_g", "art": "mul"},
    {"id": "los_n", "art": "mul", "b": -1},
    {"id": "ausklang", "art": "add"},
    {"id": "pegel", "art": "mul", "b": 0.5},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "saite.hz"},
    {"von": "note.trig", "nach": "saite.trig"},
    {"von": "note.vel", "nach": "saite.vel"},
    {"von": "note.gate", "nach": "halt.a"},
    {"von": "k_decay.aus", "nach": "halt.b"},
    {"von": "k_damp.aus", "nach": "saite.daempfung"},
    {"von": "k_hell.aus", "nach": "saite.hell"},
    {"von": "k_lage.aus", "nach": "saite.lage"},
    {"von": "k_body.aus", "nach": "saite.koerper_mix"},
    {"von": "note.gate", "nach": "los_g.a"},
    {"von": "k_rel.aus", "nach": "los_g.b"},
    {"von": "k_rel.aus", "nach": "ausklang.c"},
    {"von": "los_g.aus", "nach": "los_n.a"},
    {"von": "halt.aus", "nach": "ausklang.a"},
    {"von": "los_n.aus", "nach": "ausklang.b"},
    {"von": "ausklang.aus", "nach": "saite.ausklang"},
    {"von": "saite.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "aus.x"}
  ]
}
