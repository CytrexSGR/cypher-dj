{
  "format": "baukasten/2",
  "name": "granular-drone",
  "stimmen": 2,
  "regler_namen": {"1": "Position", "2": "Density", "3": "Pitch", "4": "Freeze", "5": "Tone", "6": "Grain size"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_pos", "art": "regler", "nr": 1, "min": 0, "max": 0.9},
    {"id": "k_dichte", "art": "regler", "nr": 2, "min": 4, "max": 60, "log": 1},
    {"id": "k_ton", "art": "regler", "nr": 3, "min": -12, "max": 12},
    {"id": "k_frieren", "art": "regler", "nr": 4, "min": 0, "max": 1},
    {"id": "k_ton_filter", "art": "regler", "nr": 5, "min": 300, "max": 8000, "log": 1},
    {"id": "k_groesse", "art": "regler", "nr": 6, "min": 60, "max": 800, "log": 1},
    {"id": "quinte", "art": "transponiere", "st": 7},
    {"id": "s1", "art": "saege"},
    {"id": "s2", "art": "saege"},
    {"id": "summe", "art": "add"},
    {"id": "env", "art": "adsr", "a": 0.3, "d": 0.5, "s": 0.8, "r": 1.5},
    {"id": "vca", "art": "mul"},
    {"id": "korn", "art": "granular", "quelle": 1, "puffer": 4, "pos_zufall": 0.25, "ton_zufall": 8, "breite": 1, "streuung": 0.6, "fenster": 0.3, "saat": 3},
    {"id": "filter_l", "art": "svf", "reso": 0.2},
    {"id": "filter_r", "art": "svf", "reso": 0.2},
    {"id": "pegel_l", "art": "mul", "b": 0.18},
    {"id": "pegel_r", "art": "mul", "b": 0.18},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "s1.hz"},
    {"von": "note.hz", "nach": "quinte.hz"},
    {"von": "quinte.aus", "nach": "s2.hz"},
    {"von": "s1.aus", "nach": "summe.a"},
    {"von": "s2.aus", "nach": "summe.b"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "summe.aus", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "korn.x"},
    {"von": "k_pos.aus", "nach": "korn.pos"},
    {"von": "k_dichte.aus", "nach": "korn.dichte"},
    {"von": "k_ton.aus", "nach": "korn.tonhoehe"},
    {"von": "k_frieren.aus", "nach": "korn.frieren"},
    {"von": "k_groesse.aus", "nach": "korn.groesse"},
    {"von": "korn.l", "nach": "filter_l.x"},
    {"von": "korn.r", "nach": "filter_r.x"},
    {"von": "k_ton_filter.aus", "nach": "filter_l.cutoff"},
    {"von": "k_ton_filter.aus", "nach": "filter_r.cutoff"},
    {"von": "filter_l.tp", "nach": "pegel_l.a"},
    {"von": "filter_r.tp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
