{
  "format": "baukasten/2",
  "name": "hartsync-bass",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Sync pitch", "4": "Zap", "5": "Zap decay",
                   "6": "Sub", "7": "Drive", "8": "Release"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 100, "max": 8000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0, "max": 0.85},
    {"id": "k_sync", "art": "regler", "nr": 3, "min": 0, "max": 24},
    {"id": "k_zap", "art": "regler", "nr": 4, "min": 0, "max": 48},
    {"id": "k_zdecay", "art": "regler", "nr": 5, "min": 0.01, "max": 0.5, "log": 1},
    {"id": "k_sub", "art": "regler", "nr": 6, "min": 0, "max": 1},
    {"id": "k_drive", "art": "regler", "nr": 7, "min": 0, "max": 18},
    {"id": "k_rel", "art": "regler", "nr": 8, "min": 0.02, "max": 1, "log": 1},
    {"id": "leiter", "art": "sinus"},
    {"id": "zenv", "art": "adsr", "a": 0.001, "d": 0.07, "s": 0.001, "r": 0.05},
    {"id": "zap_st", "art": "mul"},
    {"id": "folger_st", "art": "add"},
    {"id": "ton_f", "art": "transponiere"},
    {"id": "folger", "art": "dreieck"},
    {"id": "filter", "art": "svf", "pole": 4},
    {"id": "sub", "art": "mul"},
    {"id": "sub_pegel", "art": "mul", "b": 0.6},
    {"id": "mix", "art": "add"},
    {"id": "drive", "art": "saett"},
    {"id": "dcblock", "art": "svf", "cutoff": 20, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.002, "d": 0.25, "s": 0.7, "r": 0.15},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.5},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "leiter.hz"},
    {"von": "note.gate", "nach": "zenv.gate"},
    {"von": "note.trig", "nach": "zenv.trig"},
    {"von": "k_zdecay.aus", "nach": "zenv.d"},
    {"von": "zenv.aus", "nach": "zap_st.a"},
    {"von": "k_zap.aus", "nach": "zap_st.b"},
    {"von": "k_sync.aus", "nach": "folger_st.a"},
    {"von": "zap_st.aus", "nach": "folger_st.b"},
    {"von": "note.hz", "nach": "ton_f.hz"},
    {"von": "folger_st.aus", "nach": "ton_f.st"},
    {"von": "ton_f.aus", "nach": "folger.hz"},
    {"von": "leiter.hart", "nach": "folger.hart"},
    {"von": "folger.aus", "nach": "filter.x"},
    {"von": "k_cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},
    {"von": "leiter.aus", "nach": "sub.a"},
    {"von": "k_sub.aus", "nach": "sub.b"},
    {"von": "sub.aus", "nach": "sub_pegel.a"},
    {"von": "filter.tp", "nach": "mix.a"},
    {"von": "sub_pegel.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "drive.x"},
    {"von": "k_drive.aus", "nach": "drive.antrieb"},
    {"von": "drive.aus", "nach": "dcblock.x"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "dcblock.hp", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "aus.x"}
  ]
}
