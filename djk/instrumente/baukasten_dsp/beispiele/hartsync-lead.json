{
  "format": "baukasten/2",
  "name": "hartsync-lead",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Sync pitch", "4": "Sweep", "5": "Sweep decay",
                   "6": "Vibrato", "7": "Drive", "8": "Release"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 300, "max": 12000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0, "max": 0.85},
    {"id": "k_sync", "art": "regler", "nr": 3, "min": 0, "max": 24},
    {"id": "k_sweep", "art": "regler", "nr": 4, "min": 0, "max": 36},
    {"id": "k_sdecay", "art": "regler", "nr": 5, "min": 0.05, "max": 2, "log": 1},
    {"id": "k_vib", "art": "regler", "nr": 6, "min": 0, "max": 0.6},
    {"id": "k_drive", "art": "regler", "nr": 7, "min": 0, "max": 18},
    {"id": "k_rel", "art": "regler", "nr": 8, "min": 0.02, "max": 2, "log": 1},
    {"id": "glide", "art": "glatt", "zeit": 0.04},
    {"id": "vibrato", "art": "lfo", "rate": 5.5},
    {"id": "vib_st", "art": "mul"},
    {"id": "ton_m", "art": "transponiere"},
    {"id": "leiter", "art": "saege"},
    {"id": "senv", "art": "adsr", "a": 0.001, "d": 0.3, "s": 0.001, "r": 0.3},
    {"id": "sweep_st", "art": "mul"},
    {"id": "folger_st", "art": "add"},
    {"id": "ton_f", "art": "transponiere"},
    {"id": "folger", "art": "saege"},
    {"id": "pegel_f", "art": "mul", "b": 0.8},
    {"id": "pegel_m", "art": "mul", "b": 0.25},
    {"id": "mix", "art": "add"},
    {"id": "filter", "art": "svf", "pole": 4},
    {"id": "drive", "art": "saett"},
    {"id": "dcblock", "art": "svf", "cutoff": 25, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.003, "d": 0.3, "s": 0.85, "r": 0.3},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.45},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "glide.x"},
    {"von": "note.erste", "nach": "glide.setzen"},
    {"von": "vibrato.aus", "nach": "vib_st.a"},
    {"von": "k_vib.aus", "nach": "vib_st.b"},
    {"von": "glide.aus", "nach": "ton_m.hz"},
    {"von": "vib_st.aus", "nach": "ton_m.st"},
    {"von": "ton_m.aus", "nach": "leiter.hz"},
    {"von": "note.gate", "nach": "senv.gate"},
    {"von": "note.trig", "nach": "senv.trig"},
    {"von": "k_sdecay.aus", "nach": "senv.d"},
    {"von": "senv.aus", "nach": "sweep_st.a"},
    {"von": "k_sweep.aus", "nach": "sweep_st.b"},
    {"von": "k_sync.aus", "nach": "folger_st.a"},
    {"von": "sweep_st.aus", "nach": "folger_st.b"},
    {"von": "vib_st.aus", "nach": "folger_st.c"},
    {"von": "glide.aus", "nach": "ton_f.hz"},
    {"von": "folger_st.aus", "nach": "ton_f.st"},
    {"von": "ton_f.aus", "nach": "folger.hz"},
    {"von": "leiter.hart", "nach": "folger.hart"},
    {"von": "folger.aus", "nach": "pegel_f.a"},
    {"von": "leiter.aus", "nach": "pegel_m.a"},
    {"von": "pegel_f.aus", "nach": "mix.a"},
    {"von": "pegel_m.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "filter.x"},
    {"von": "k_cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},
    {"von": "filter.tp", "nach": "drive.x"},
    {"von": "k_drive.aus", "nach": "drive.antrieb"},
    {"von": "drive.aus", "nach": "dcblock.x"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "dcblock.hp", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "aus.x"}
  ]
}
