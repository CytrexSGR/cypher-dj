{
  "format": "baukasten/2",
  "name": "bassmusik",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Wobble depth", "3": "Wobble rate", "4": "Resonance",
                   "5": "Growl", "6": "Sub", "7": "Drive", "8": "Release"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 80, "max": 2500, "log": 1},
    {"id": "k_tiefe", "art": "regler", "nr": 2, "min": 0, "max": 4000},
    {"id": "k_rate", "art": "regler", "nr": 3, "min": 0.5, "max": 16, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 4, "min": 0, "max": 0.85},
    {"id": "k_growl", "art": "regler", "nr": 5, "min": 0, "max": 1},
    {"id": "k_sub", "art": "regler", "nr": 6, "min": 0, "max": 0.6},
    {"id": "k_drive", "art": "regler", "nr": 7, "min": 0, "max": 18},
    {"id": "k_release", "art": "regler", "nr": 8, "min": 0.05, "max": 1.5, "log": 1},

    {"id": "saege", "art": "saege"},
    {"id": "puls", "art": "puls", "pwm": 0.3},
    {"id": "sub_hz", "art": "transponiere", "st": -12},
    {"id": "sub", "art": "sinus"},
    {"id": "saege_halb", "art": "mul", "b": 0.35},
    {"id": "puls_halb", "art": "mul", "b": 0.25},
    {"id": "sub_pegel", "art": "mul"},

    {"id": "lfo", "art": "lfo", "form": 0, "neustart": 1, "takt": 0},
    {"id": "lfo_eins", "art": "add", "b": 1},
    {"id": "lfo_halb", "art": "mul", "b": 0.5},
    {"id": "cutoff_hub", "art": "mul"},
    {"id": "cutoff", "art": "add"},

    {"id": "ring_hz", "art": "transponiere", "st": 7},
    {"id": "ring_osz", "art": "sinus"},
    {"id": "ring", "art": "mul"},
    {"id": "bp", "art": "svf", "pole": 2, "reso": 0.5},
    {"id": "bp_lage", "art": "mul", "b": 1.5},
    {"id": "growl_pegel", "art": "mul"},
    {"id": "trocken_pegel", "art": "mul"},
    {"id": "eins_minus", "art": "add", "b": 1},
    {"id": "minus_growl", "art": "mul", "b": -1},
    {"id": "nachfilter", "art": "add"},

    {"id": "mix", "art": "add"},
    {"id": "antrieb", "art": "saett"},
    {"id": "filter", "art": "ladder"},
    {"id": "env", "art": "adsr", "a": 0.003, "d": 0.2, "s": 0.9, "r": 0.2},
    {"id": "vca", "art": "mul"},
    {"id": "summe", "art": "add"},
    {"id": "pegel", "art": "mul", "b": 0.5},
    {"id": "grenze", "art": "saett", "antrieb": 0},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "saege.hz"},
    {"von": "note.hz", "nach": "puls.hz"},
    {"von": "note.hz", "nach": "sub_hz.hz"},
    {"von": "sub_hz.aus", "nach": "sub.hz"},
    {"von": "saege.aus", "nach": "saege_halb.a"},
    {"von": "puls.aus", "nach": "puls_halb.a"},
    {"von": "sub.aus", "nach": "sub_pegel.a"},
    {"von": "k_sub.aus", "nach": "sub_pegel.b"},

    {"von": "k_rate.aus", "nach": "lfo.rate"},
    {"von": "note.trig", "nach": "lfo.trig"},
    {"von": "lfo.aus", "nach": "lfo_eins.a"},
    {"von": "lfo_eins.aus", "nach": "lfo_halb.a"},
    {"von": "lfo_halb.aus", "nach": "cutoff_hub.a"},
    {"von": "k_tiefe.aus", "nach": "cutoff_hub.b"},
    {"von": "k_cutoff.aus", "nach": "cutoff.a"},
    {"von": "cutoff_hub.aus", "nach": "cutoff.b"},

    {"von": "saege_halb.aus", "nach": "mix.a"},
    {"von": "puls_halb.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "antrieb.x"},
    {"von": "k_drive.aus", "nach": "antrieb.antrieb"},
    {"von": "antrieb.aus", "nach": "filter.x"},
    {"von": "cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},

    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_release.aus", "nach": "env.r"},
    {"von": "note.hz", "nach": "ring_hz.hz"},
    {"von": "ring_hz.aus", "nach": "ring_osz.hz"},
    {"von": "filter.aus", "nach": "ring.a"},
    {"von": "ring_osz.aus", "nach": "ring.b"},
    {"von": "ring.aus", "nach": "bp.x"},
    {"von": "cutoff.aus", "nach": "bp_lage.a"},
    {"von": "bp_lage.aus", "nach": "bp.cutoff"},
    {"von": "bp.bp", "nach": "growl_pegel.a"},
    {"von": "k_growl.aus", "nach": "growl_pegel.b"},
    {"von": "k_growl.aus", "nach": "minus_growl.a"},
    {"von": "minus_growl.aus", "nach": "eins_minus.a"},
    {"von": "filter.aus", "nach": "trocken_pegel.a"},
    {"von": "eins_minus.aus", "nach": "trocken_pegel.b"},
    {"von": "trocken_pegel.aus", "nach": "nachfilter.a"},
    {"von": "growl_pegel.aus", "nach": "nachfilter.b"},
    {"von": "nachfilter.aus", "nach": "summe.a"},
    {"von": "sub_pegel.aus", "nach": "summe.b"},
    {"von": "summe.aus", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "grenze.x"},
    {"von": "grenze.aus", "nach": "aus.x"}
  ]
}
