{
  "format": "baukasten/2",
  "name": "granular-pad",
  "stimmen": 8,
  "regler_namen": {"1": "Position", "2": "Grain size", "3": "Density", "4": "Pitch jitter", "5": "Width", "6": "Attack", "7": "Release"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_pos", "art": "regler", "nr": 1, "min": 0, "max": 0.8},
    {"id": "k_groesse", "art": "regler", "nr": 2, "min": 20, "max": 400, "log": 1},
    {"id": "k_dichte", "art": "regler", "nr": 3, "min": 5, "max": 160, "log": 1},
    {"id": "k_ton", "art": "regler", "nr": 4, "min": 0, "max": 40},
    {"id": "k_breite", "art": "regler", "nr": 5, "min": 0, "max": 1},
    {"id": "k_att", "art": "regler", "nr": 6, "min": 0.02, "max": 2, "log": 1},
    {"id": "k_rel", "art": "regler", "nr": 7, "min": 0.1, "max": 4, "log": 1},
    {"id": "lfo", "art": "lfo", "rate": 0.11},
    {"id": "bewegung", "art": "mul", "b": 0.2},
    {"id": "pos", "art": "add"},
    {"id": "korn", "art": "granular", "quelle": 0, "tabelle": 5, "pos_zufall": 0.08, "fenster": 0.2, "saat": 1},
    {"id": "env", "art": "adsr", "a": 0.4, "d": 0.6, "s": 0.9, "r": 1.2},
    {"id": "vca_l", "art": "mul"},
    {"id": "vca_r", "art": "mul"},
    {"id": "pegel_l", "art": "mul", "b": 0.25},
    {"id": "pegel_r", "art": "mul", "b": 0.25},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "korn.hz"},
    {"von": "note.trig", "nach": "korn.trig"},
    {"von": "lfo.aus", "nach": "bewegung.a"},
    {"von": "k_pos.aus", "nach": "pos.a"},
    {"von": "bewegung.aus", "nach": "pos.b"},
    {"von": "pos.aus", "nach": "korn.pos"},
    {"von": "k_groesse.aus", "nach": "korn.groesse"},
    {"von": "k_dichte.aus", "nach": "korn.dichte"},
    {"von": "k_ton.aus", "nach": "korn.ton_zufall"},
    {"von": "k_breite.aus", "nach": "korn.breite"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_att.aus", "nach": "env.a"},
    {"von": "k_rel.aus", "nach": "env.r"},
    {"von": "korn.l", "nach": "vca_l.a"},
    {"von": "korn.r", "nach": "vca_r.a"},
    {"von": "env.aus", "nach": "vca_l.b"},
    {"von": "env.aus", "nach": "vca_r.b"},
    {"von": "vca_l.aus", "nach": "pegel_l.a"},
    {"von": "vca_r.aus", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
