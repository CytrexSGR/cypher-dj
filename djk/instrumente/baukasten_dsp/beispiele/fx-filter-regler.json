{
  "format": "baukasten/2",
  "name": "fx-filter-regler",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Resonance"},
  "knoten": [
    {"id": "ein", "art": "eingang"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 200, "max": 8000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0, "max": 0.8},
    {"id": "fl", "art": "svf", "pole": 4},
    {"id": "fr", "art": "svf", "pole": 4},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "k_cutoff.aus", "nach": "fl.cutoff"},
    {"von": "k_cutoff.aus", "nach": "fr.cutoff"},
    {"von": "k_reso.aus", "nach": "fl.reso"},
    {"von": "k_reso.aus", "nach": "fr.reso"},
    {"von": "ein.l", "nach": "fl.x"},
    {"von": "ein.r", "nach": "fr.x"},
    {"von": "fl.tp", "nach": "aus.l"},
    {"von": "fr.tp", "nach": "aus.r"}
  ]
}
