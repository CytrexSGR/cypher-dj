{
  "format": "baukasten/2",
  "name": "fm-epiano",
  "stimmen": 8,
  "regler_namen": {"1": "Brightness", "2": "Decay", "3": "Tremolo", "4": "Chorus"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_hell", "art": "regler", "nr": 1, "min": 0, "max": 2},
    {"id": "k_zeit", "art": "regler", "nr": 2, "min": 0.25, "max": 4, "log": 1},
    {"id": "k_trem", "art": "regler", "nr": 3, "min": 0, "max": 0.8},
    {"id": "k_chorus", "art": "regler", "nr": 4, "min": 0, "max": 1},
    {"id": "fm", "art": "fm", "algo": 3, "anschlag": 0.7,
     "o1_verh": 1, "o1_pegel": 1, "o1_a": 0.001, "o1_d": 3.5, "o1_s": 0, "o1_r": 0.25,
     "o2_verh": 1, "o2_pegel": 0.11, "o2_a": 0.001, "o2_d": 2.5, "o2_s": 0, "o2_r": 0.25,
     "o3_verh": 1, "o3_fein": 4, "o3_pegel": 0.6, "o3_a": 0.001, "o3_d": 1.8, "o3_s": 0, "o3_r": 0.25,
     "o4_verh": 14, "o4_pegel": 0.035, "o4_a": 0.001, "o4_d": 0.25, "o4_s": 0, "o4_r": 0.25},
    {"id": "trem", "art": "lfo", "rate": 4.5},
    {"id": "trem_tiefe", "art": "mul"},
    {"id": "trem_halb", "art": "mul", "b": 0.5},
    {"id": "trem_gain", "art": "add", "b": 1},
    {"id": "trem_neg", "art": "mul", "b": -0.5},
    {"id": "trem_summe", "art": "add"},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.26},
    {"id": "chorus", "art": "chorus", "modus": 1},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "fm.hz"},
    {"von": "note.gate", "nach": "fm.gate"},
    {"von": "note.trig", "nach": "fm.trig"},
    {"von": "note.vel", "nach": "fm.vel"},
    {"von": "k_hell.aus", "nach": "fm.index"},
    {"von": "k_zeit.aus", "nach": "fm.zeit"},
    {"von": "trem.aus", "nach": "trem_tiefe.a"},
    {"von": "k_trem.aus", "nach": "trem_tiefe.b"},
    {"von": "trem_tiefe.aus", "nach": "trem_halb.a"},
    {"von": "k_trem.aus", "nach": "trem_neg.a"},
    {"von": "trem_halb.aus", "nach": "trem_summe.a"},
    {"von": "trem_neg.aus", "nach": "trem_summe.b"},
    {"von": "trem_summe.aus", "nach": "trem_gain.a"},
    {"von": "fm.aus", "nach": "vca.a"},
    {"von": "trem_gain.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "chorus.x"},
    {"von": "k_chorus.aus", "nach": "chorus.mix"},
    {"von": "chorus.l", "nach": "aus.l"},
    {"von": "chorus.r", "nach": "aus.r"}
  ]
}
