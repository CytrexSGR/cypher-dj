{
  "format": "baukasten/2",
  "name": "sync-lead",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Resonance", "3": "Sync pitch", "4": "Filter env", "5": "Drive",
                   "6": "Vibrato", "7": "Osc 2 level", "8": "Filter decay"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 200, "max": 10000, "log": 1},
    {"id": "k_reso", "art": "regler", "nr": 2, "min": 0, "max": 0.9},
    {"id": "k_sync", "art": "regler", "nr": 3, "min": 0, "max": 24},
    {"id": "k_fenv", "art": "regler", "nr": 4, "min": 0, "max": 6000},
    {"id": "k_drive", "art": "regler", "nr": 5, "min": 0, "max": 24},
    {"id": "k_vib", "art": "regler", "nr": 6, "min": 0, "max": 0.6},
    {"id": "k_osc2", "art": "regler", "nr": 7, "min": 0, "max": 0.5},
    {"id": "k_decay", "art": "regler", "nr": 8, "min": 0.05, "max": 2, "log": 1},
    {"id": "glide", "art": "glatt", "zeit": 0.04},
    {"id": "vibrato", "art": "lfo", "rate": 5.5},
    {"id": "vib_st", "art": "mul"},
    {"id": "ton1", "art": "transponiere"},
    {"id": "osz1", "art": "saege"},
    {"id": "sync_st", "art": "add"},
    {"id": "ton2", "art": "transponiere"},
    {"id": "osz2", "art": "saege"},
    {"id": "pegel1", "art": "mul", "b": 0.5},
    {"id": "pegel2", "art": "mul"},
    {"id": "mix", "art": "add"},
    {"id": "fenv", "art": "adsr", "a": 0.002, "d": 0.4, "s": 0.15, "r": 0.3},
    {"id": "fenv_hz", "art": "mul"},
    {"id": "cutoff", "art": "add"},
    {"id": "filter", "art": "svf", "pole": 4},
    {"id": "drive", "art": "saett"},
    {"id": "env", "art": "adsr", "a": 0.004, "d": 0.3, "s": 0.8, "r": 0.25},
    {"id": "vca", "art": "mul"},
    {"id": "pegel", "art": "mul", "b": 0.35},
    {"id": "aus", "art": "ausgang"}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "glide.x"},
    {"von": "note.erste", "nach": "glide.setzen"},
    {"von": "vibrato.aus", "nach": "vib_st.a"},
    {"von": "k_vib.aus", "nach": "vib_st.b"},
    {"von": "glide.aus", "nach": "ton1.hz"},
    {"von": "vib_st.aus", "nach": "ton1.st"},
    {"von": "ton1.aus", "nach": "osz1.hz"},
    {"von": "k_sync.aus", "nach": "sync_st.a"},
    {"von": "vib_st.aus", "nach": "sync_st.b"},
    {"von": "glide.aus", "nach": "ton2.hz"},
    {"von": "sync_st.aus", "nach": "ton2.st"},
    {"von": "ton2.aus", "nach": "osz2.hz"},
    {"von": "osz1.zyklus", "nach": "osz2.sync"},
    {"von": "osz1.aus", "nach": "pegel1.a"},
    {"von": "osz2.aus", "nach": "pegel2.a"},
    {"von": "k_osc2.aus", "nach": "pegel2.b"},
    {"von": "pegel1.aus", "nach": "mix.a"},
    {"von": "pegel2.aus", "nach": "mix.b"},
    {"von": "note.gate", "nach": "fenv.gate"},
    {"von": "note.trig", "nach": "fenv.trig"},
    {"von": "k_decay.aus", "nach": "fenv.d"},
    {"von": "fenv.aus", "nach": "fenv_hz.a"},
    {"von": "k_fenv.aus", "nach": "fenv_hz.b"},
    {"von": "k_cutoff.aus", "nach": "cutoff.a"},
    {"von": "fenv_hz.aus", "nach": "cutoff.b"},
    {"von": "mix.aus", "nach": "filter.x"},
    {"von": "cutoff.aus", "nach": "filter.cutoff"},
    {"von": "k_reso.aus", "nach": "filter.reso"},
    {"von": "filter.tp", "nach": "drive.x"},
    {"von": "k_drive.aus", "nach": "drive.antrieb"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "drive.aus", "nach": "vca.a"},
    {"von": "env.aus", "nach": "vca.b"},
    {"von": "vca.aus", "nach": "pegel.a"},
    {"von": "pegel.aus", "nach": "aus.x"}
  ]
}
