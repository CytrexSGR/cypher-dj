{
  "format": "baukasten/2",
  "name": "percussion-shaker",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Decay", "3": "Room mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 3800, "max": 15200, "log": 1},
    {"id": "k_decay", "art": "regler", "nr": 2, "min": 0.016, "max": 0.1, "log": 1},
    {"id": "k_room_mix", "art": "regler", "nr": 3, "min": 0, "max": 0.3},
    {"id": "noise", "art": "rauschen"},
    {"id": "vor", "art": "mul", "b": 0.5},
    {"id": "filter", "art": "ladder", "reso": 1},
    {"id": "env", "art": "adsr", "a": 0.0005, "d": 0, "s": 0, "r": 0.04},
    {"id": "vca1", "art": "mul"},
    {"id": "vca2", "art": "mul"},
    {"id": "eq_hp", "art": "svf", "cutoff": 600, "reso": 0},
    {"id": "hall", "art": "hall", "decay": 0.3, "groesse": 8},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 5.8298},
    {"id": "pegel_r", "art": "mul", "b": 5.8298}
  ],
  "kanten": [
    {"von": "noise.aus", "nach": "vor.a"},
    {"von": "vor.aus", "nach": "filter.x"},
    {"von": "k_cutoff.aus", "nach": "filter.cutoff"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_decay.aus", "nach": "env.d"},
    {"von": "filter.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "vca2.a"},
    {"von": "note.vel", "nach": "vca2.b"},
    {"von": "vca2.aus", "nach": "eq_hp.x"},
    {"von": "eq_hp.hp", "nach": "hall.x"},
    {"von": "k_room_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
