{
  "format": "baukasten/2",
  "name": "lead-arp",
  "stimmen": 8,
  "regler_namen": {"1": "Cutoff", "2": "Env amount", "3": "High-pass", "4": "Delay mix", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 300, "max": 2700, "log": 1},
    {"id": "k_env_amount", "art": "regler", "nr": 2, "min": 0, "max": 72},
    {"id": "k_high_pass", "art": "regler", "nr": 3, "min": 100, "max": 900, "log": 1},
    {"id": "k_delay_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.5},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.24},
    {"id": "saw", "art": "saege"},
    {"id": "ton_pu", "art": "transponiere", "st": 0, "cent": 7},
    {"id": "pulse", "art": "puls", "pwm": -0.4444},
    {"id": "mix", "art": "add"},
    {"id": "vor", "art": "mul", "b": 0.5},
    {"id": "dc_osz", "art": "svf", "cutoff": 20, "reso": 0},
    {"id": "fenv", "art": "adsr", "a": 0.001, "d": 0.12, "s": 0, "r": 0.05},
    {"id": "m1", "art": "mul"},
    {"id": "cut1", "art": "transponiere", "cent": 0},
    {"id": "filter", "art": "ladder", "reso": 0.2},
    {"id": "highpass", "art": "svf", "pole": 4, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.001, "d": 0.15, "s": 0.15, "r": 0.08},
    {"id": "vca1", "art": "mul"},
    {"id": "delay", "art": "delay", "takt": 0.25, "fb": 0.35, "daempf": 3000},
    {"id": "hall", "art": "hall", "decay": 1},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.8888},
    {"id": "pegel_r", "art": "mul", "b": 0.8888}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "saw.hz"},
    {"von": "note.hz", "nach": "ton_pu.hz"},
    {"von": "ton_pu.aus", "nach": "pulse.hz"},
    {"von": "saw.aus", "nach": "mix.a"},
    {"von": "pulse.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "vor.a"},
    {"von": "vor.aus", "nach": "dc_osz.x"},
    {"von": "note.gate", "nach": "fenv.gate"},
    {"von": "note.trig", "nach": "fenv.trig"},
    {"von": "fenv.aus", "nach": "m1.a"},
    {"von": "k_env_amount.aus", "nach": "m1.b"},
    {"von": "k_cutoff.aus", "nach": "cut1.hz"},
    {"von": "m1.aus", "nach": "cut1.st"},
    {"von": "dc_osz.hp", "nach": "filter.x"},
    {"von": "cut1.aus", "nach": "filter.cutoff"},
    {"von": "filter.aus", "nach": "highpass.x"},
    {"von": "k_high_pass.aus", "nach": "highpass.cutoff"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "highpass.hp", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "delay.x"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "hall.l"},
    {"von": "delay.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
