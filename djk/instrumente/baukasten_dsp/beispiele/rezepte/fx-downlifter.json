    {"id": "k_env_amount", "art": "regler", "nr": 3, "min": 24, "max": 72},
    {"id": "k_hall_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.7},
    {"id": "k_delay_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.3},
    {"id": "mod_env", "art": "adsr", "a": 0, "d": 0.001, "s": 0, "r": 2},
    {"id": "amt_neg", "art": "mul", "b": -1},
    {"id": "noise", "art": "rauschen"},
    {"id": "vor", "art": "mul", "b": 0.5},
    {"id": "m1", "art": "mul"},
    {"id": "cut1", "art": "transponiere", "cent": 0},
