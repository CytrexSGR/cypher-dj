{
  "format": "baukasten/2",
  "name": "lead-fm",
  "stimmen": 8,
  "regler_namen": {"1": "Index", "2": "Bite", "3": "Decay", "4": "Delay mix", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_index", "art": "regler", "nr": 1, "min": 0.25, "max": 4, "log": 1},
    {"id": "k_bite", "art": "regler", "nr": 2, "min": 0, "max": 6},
    {"id": "k_decay", "art": "regler", "nr": 3, "min": 0.48, "max": 3, "log": 1},
    {"id": "k_delay_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.3},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.4},
    {"id": "mod_env", "art": "adsr", "a": 0.001, "d": 0.3, "s": 0, "r": 0.3},
    {"id": "biss_env", "art": "mul"},
    {"id": "biss_vel", "art": "mul"},
    {"id": "index", "art": "add"},
    {"id": "mod_hz", "art": "mul", "b": 2},
    {"id": "mod", "art": "sinus"},
    {"id": "fm_tiefe", "art": "mul"},
    {"id": "fm", "art": "mul"},
    {"id": "carrier", "art": "sinus"},
    {"id": "lp", "art": "svf", "cutoff": 9000, "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.005, "d": 0, "s": 0.45, "r": 0.3},
    {"id": "vca1", "art": "mul"},
    {"id": "chorus", "art": "chorus", "mix": 0.5},
    {"id": "delay", "art": "delay", "takt": 0.5, "fb": 0.3},
    {"id": "hall", "art": "hall", "decay": 1.8},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.1525},
    {"id": "pegel_r", "art": "mul", "b": 0.1525}
  ],
  "kanten": [
    {"von": "note.gate", "nach": "mod_env.gate"},
    {"von": "note.trig", "nach": "mod_env.trig"},
    {"von": "mod_env.aus", "nach": "biss_env.a"},
    {"von": "k_bite.aus", "nach": "biss_env.b"},
    {"von": "biss_env.aus", "nach": "biss_vel.a"},
    {"von": "note.vel", "nach": "biss_vel.b"},
    {"von": "k_index.aus", "nach": "index.a"},
    {"von": "biss_vel.aus", "nach": "index.b"},
    {"von": "note.hz", "nach": "mod_hz.a"},
    {"von": "mod_hz.aus", "nach": "mod.hz"},
    {"von": "mod_hz.aus", "nach": "fm_tiefe.a"},
    {"von": "index.aus", "nach": "fm_tiefe.b"},
    {"von": "mod.aus", "nach": "fm.a"},
    {"von": "fm_tiefe.aus", "nach": "fm.b"},
    {"von": "note.hz", "nach": "carrier.hz"},
    {"von": "fm.aus", "nach": "carrier.fm"},
    {"von": "carrier.aus", "nach": "lp.x"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_decay.aus", "nach": "env.d"},
    {"von": "lp.tp", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "chorus.x"},
    {"von": "chorus.l", "nach": "delay.l"},
    {"von": "chorus.r", "nach": "delay.r"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "hall.l"},
    {"von": "delay.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
