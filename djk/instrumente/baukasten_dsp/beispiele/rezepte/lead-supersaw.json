{
  "format": "baukasten/2",
  "name": "lead-supersaw",
  "stimmen": 8,
  "regler_namen": {"1": "Detune", "2": "Width", "3": "Cutoff", "4": "Hall mix", "5": "Delay mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_detune", "art": "regler", "nr": 1, "min": 0, "max": 50},
    {"id": "k_width", "art": "regler", "nr": 2, "min": 0.4, "max": 1},
    {"id": "k_cutoff", "art": "regler", "nr": 3, "min": 1000, "max": 400000, "log": 1},
    {"id": "k_hall_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.6},
    {"id": "k_delay_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.24},
    {"id": "saws", "art": "wavetable", "tabelle": 0, "kopien": 7},
    {"id": "env", "art": "adsr", "a": 0.005, "d": 0.3, "s": 0.6, "r": 0.4},
    {"id": "filter_l", "art": "svf", "reso": 0},
    {"id": "filter_r", "art": "svf", "reso": 0},
    {"id": "vca1", "art": "mul"},
    {"id": "vca2", "art": "mul"},
    {"id": "hall", "art": "hall", "decay": 2.5, "pre": 40},
    {"id": "gate", "art": "gate", "schwelle": -40, "release": 80},
    {"id": "delay", "art": "delay", "takt": 0.5, "fb": 0.25},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.2343},
    {"id": "pegel_r", "art": "mul", "b": 0.2343}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "saws.hz"},
    {"von": "note.trig", "nach": "saws.trig"},
    {"von": "k_detune.aus", "nach": "saws.verstimmung"},
    {"von": "k_width.aus", "nach": "saws.breite"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "saws.l", "nach": "filter_l.x"},
    {"von": "k_cutoff.aus", "nach": "filter_l.cutoff"},
    {"von": "saws.r", "nach": "filter_r.x"},
    {"von": "k_cutoff.aus", "nach": "filter_r.cutoff"},
    {"von": "filter_l.tp", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "filter_r.tp", "nach": "vca2.a"},
    {"von": "env.aus", "nach": "vca2.b"},
    {"von": "vca1.aus", "nach": "hall.l"},
    {"von": "vca2.aus", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "gate.l"},
    {"von": "hall.r", "nach": "gate.r"},
    {"von": "gate.l", "nach": "delay.l"},
    {"von": "gate.r", "nach": "delay.r"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "dcblock_l.x"},
    {"von": "delay.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
