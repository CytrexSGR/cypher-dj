{
  "format": "baukasten/2",
  "name": "lead-sync",
  "stimmen": 1,
  "regler_namen": {"1": "Sync pitch", "2": "Cutoff", "3": "Drive", "4": "Delay mix", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_sync_pitch", "art": "regler", "nr": 1, "min": 0, "max": 14},
    {"id": "k_cutoff", "art": "regler", "nr": 2, "min": 1000, "max": 400000, "log": 1},
    {"id": "k_drive", "art": "regler", "nr": 3, "min": 0, "max": 6},
    {"id": "k_delay_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.3},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.4},
    {"id": "glide", "art": "glatt", "zeit": 0.02},
    {"id": "vib_lfo", "art": "lfo", "form": 1, "rate": 0.66},
    {"id": "vib", "art": "mul", "b": 4.5},
    {"id": "master1", "art": "saege"},
    {"id": "slave_hz1", "art": "transponiere"},
    {"id": "slave1", "art": "puls", "pwm": 0},
    {"id": "master_hz2", "art": "transponiere", "st": 0, "cent": 8},
    {"id": "master2", "art": "saege"},
    {"id": "slave_hz2", "art": "transponiere"},
    {"id": "slave2", "art": "puls", "pwm": 0},
    {"id": "mix", "art": "add"},
    {"id": "vor", "art": "mul", "b": 0.3},
    {"id": "filter", "art": "ladder", "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.001, "d": 10, "s": 1, "r": 0.6},
    {"id": "vca1", "art": "mul"},
    {"id": "drive", "art": "saett"},
    {"id": "delay", "art": "delay", "takt": 0.5, "fb": 0.3},
    {"id": "hall", "art": "hall", "decay": 1.5},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.4238},
    {"id": "pegel_r", "art": "mul", "b": 0.4238}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "glide.x"},
    {"von": "note.erste", "nach": "glide.setzen"},
    {"von": "vib_lfo.aus", "nach": "vib.a"},
    {"von": "glide.aus", "nach": "master1.hz"},
    {"von": "glide.aus", "nach": "slave_hz1.hz"},
    {"von": "k_sync_pitch.aus", "nach": "slave_hz1.st"},
    {"von": "vib.aus", "nach": "slave_hz1.cent"},
    {"von": "slave_hz1.aus", "nach": "slave1.hz"},
    {"von": "master1.zyklus", "nach": "slave1.sync"},
    {"von": "glide.aus", "nach": "master_hz2.hz"},
    {"von": "master_hz2.aus", "nach": "master2.hz"},
    {"von": "master_hz2.aus", "nach": "slave_hz2.hz"},
    {"von": "k_sync_pitch.aus", "nach": "slave_hz2.st"},
    {"von": "vib.aus", "nach": "slave_hz2.cent"},
    {"von": "slave_hz2.aus", "nach": "slave2.hz"},
    {"von": "master2.zyklus", "nach": "slave2.sync"},
    {"von": "slave1.aus", "nach": "mix.a"},
    {"von": "slave2.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "vor.a"},
    {"von": "vor.aus", "nach": "filter.x"},
    {"von": "k_cutoff.aus", "nach": "filter.cutoff"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "filter.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "drive.x"},
    {"von": "k_drive.aus", "nach": "drive.antrieb"},
    {"von": "drive.aus", "nach": "delay.x"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "hall.l"},
    {"von": "delay.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
