{
  "format": "baukasten/2",
  "name": "lead-mono",
  "stimmen": 1,
  "regler_namen": {"1": "Cutoff", "2": "Drive", "3": "Release", "4": "Delay mix", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_cutoff", "art": "regler", "nr": 1, "min": 1000, "max": 400000, "log": 1},
    {"id": "k_drive", "art": "regler", "nr": 2, "min": 0, "max": 12},
    {"id": "k_release", "art": "regler", "nr": 3, "min": 0.116667, "max": 1.05, "log": 1},
    {"id": "k_delay_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.3},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.4},
    {"id": "glide", "art": "glatt", "zeit": 0.02},
    {"id": "squares", "art": "wavetable", "tabelle": 1, "kopien": 2, "verstimmung": 10},
    {"id": "vor", "art": "mul", "b": 0.5},
    {"id": "filter", "art": "ladder", "reso": 0},
    {"id": "env", "art": "adsr", "a": 0.001, "d": 10, "s": 1, "r": 0},
    {"id": "vca1", "art": "mul"},
    {"id": "drive", "art": "saett"},
    {"id": "delay", "art": "delay", "takt": 0.5, "fb": 0.3},
    {"id": "hall", "art": "hall", "decay": 1.2, "groesse": 25},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.4359},
    {"id": "pegel_r", "art": "mul", "b": 0.4359}
  ],
  "kanten": [
    {"von": "note.hz", "nach": "glide.x"},
    {"von": "note.erste", "nach": "glide.setzen"},
    {"von": "glide.aus", "nach": "squares.hz"},
    {"von": "note.trig", "nach": "squares.trig"},
    {"von": "squares.aus", "nach": "vor.a"},
    {"von": "vor.aus", "nach": "filter.x"},
    {"von": "k_cutoff.aus", "nach": "filter.cutoff"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_release.aus", "nach": "env.r"},
    {"von": "filter.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "drive.x"},
    {"von": "k_drive.aus", "nach": "drive.antrieb"},
    {"von": "drive.aus", "nach": "delay.x"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "hall.l"},
    {"von": "delay.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "dcblock_l.x"},
    {"von": "hall.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
}
