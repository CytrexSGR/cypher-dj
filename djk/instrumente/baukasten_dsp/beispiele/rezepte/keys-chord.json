{
  "format": "baukasten/2",
  "name": "keys-chord",
  "stimmen": 8,
  "regler_namen": {"1": "PWM depth", "2": "Detune", "3": "Release", "4": "Delay mix", "5": "Hall mix"},
  "knoten": [
    {"id": "note", "art": "note"},
    {"id": "k_pwm_depth", "art": "regler", "nr": 1, "min": 0, "max": 0.8},
    {"id": "k_detune", "art": "regler", "nr": 2, "min": 0, "max": 20},
    {"id": "k_release", "art": "regler", "nr": 3, "min": 0.0025, "max": 0.04, "log": 1},
    {"id": "k_delay_mix", "art": "regler", "nr": 4, "min": 0, "max": 0.3},
    {"id": "k_hall_mix", "art": "regler", "nr": 5, "min": 0, "max": 0.3},
    {"id": "pwm_lfo", "art": "lfo", "rate": 6},
    {"id": "pwm_eins", "art": "add", "b": 1},
    {"id": "pwm_pos", "art": "mul"},
    {"id": "root", "art": "wavetable", "tabelle": 1, "kopien": 2, "glatt": 0},
    {"id": "quinte_hz", "art": "transponiere", "st": 7, "cent": 0},
    {"id": "fifth", "art": "wavetable", "tabelle": 1, "kopien": 2, "glatt": 0},
    {"id": "mix", "art": "add"},
    {"id": "vor", "art": "mul", "b": 0.4},
    {"id": "env", "art": "adsr", "a": 0.001, "d": 10, "s": 1, "r": 0},
    {"id": "vca1", "art": "mul"},
    {"id": "chorus", "art": "chorus", "mix": 1},
    {"id": "delay", "art": "delay", "takt": 0.5, "fb": 0.3},
    {"id": "hall", "art": "hall", "decay": 1},
    {"id": "komp", "art": "komp", "ratio": 4, "schwelle": -18},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 0.3038},
    {"id": "pegel_r", "art": "mul", "b": 0.3038}
  ],
  "kanten": [
    {"von": "pwm_lfo.aus", "nach": "pwm_eins.a"},
    {"von": "pwm_eins.aus", "nach": "pwm_pos.a"},
    {"von": "k_pwm_depth.aus", "nach": "pwm_pos.b"},
    {"von": "note.hz", "nach": "root.hz"},
    {"von": "note.trig", "nach": "root.trig"},
    {"von": "k_detune.aus", "nach": "root.verstimmung"},
    {"von": "pwm_pos.aus", "nach": "root.pos"},
    {"von": "note.hz", "nach": "quinte_hz.hz"},
    {"von": "quinte_hz.aus", "nach": "fifth.hz"},
    {"von": "note.trig", "nach": "fifth.trig"},
    {"von": "k_detune.aus", "nach": "fifth.verstimmung"},
    {"von": "pwm_pos.aus", "nach": "fifth.pos"},
    {"von": "root.aus", "nach": "mix.a"},
    {"von": "fifth.aus", "nach": "mix.b"},
    {"von": "mix.aus", "nach": "vor.a"},
    {"von": "note.gate", "nach": "env.gate"},
    {"von": "note.trig", "nach": "env.trig"},
    {"von": "k_release.aus", "nach": "env.r"},
    {"von": "vor.aus", "nach": "vca1.a"},
    {"von": "env.aus", "nach": "vca1.b"},
    {"von": "vca1.aus", "nach": "chorus.x"},
    {"von": "chorus.l", "nach": "delay.l"},
    {"von": "chorus.r", "nach": "delay.r"},
    {"von": "k_delay_mix.aus", "nach": "delay.mix"},
    {"von": "delay.l", "nach": "hall.l"},
    {"von": "delay.r", "nach": "hall.r"},
    {"von": "k_hall_mix.aus", "nach": "hall.mix"},
    {"von": "hall.l", "nach": "komp.l"},
    {"von": "hall.r", "nach": "komp.r"},
    {"von": "komp.l", "nach": "dcblock_l.x"},
    {"von": "komp.r", "nach": "dcblock_r.x"},
    {"von": "dcblock_l.hp", "nach": "pegel_l.a"},
    {"von": "dcblock_r.hp", "nach": "pegel_r.a"},
    {"von": "pegel_l.aus", "nach": "aus.l"},
    {"von": "pegel_r.aus", "nach": "aus.r"}
  ]
