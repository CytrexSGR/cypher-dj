    {"id": "vor", "art": "mul", "b": 0.5},
    {"id": "drive", "art": "saett", "antrieb": 2},
    {"id": "hall", "art": "hall", "decay": 0.9, "groesse": 20},
    {"id": "komp", "art": "komp", "ratio": 4, "attack": 5, "schwelle": -18},
    {"id": "dcblock_l", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "dcblock_r", "art": "svf", "cutoff": 15, "reso": 0},
    {"id": "aus", "art": "ausgang"},
    {"id": "pegel_l", "art": "mul", "b": 1.5472},
