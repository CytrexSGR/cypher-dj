# cypherdj-notbahn: Notbahn daneben am Ausgang (ADR 016, Nachtrag 2026-09-25; Scheibe 10).
# Ports als Aufrufparameter (INTERFACES.md §7, kein TOML in C). Vorgabe stumm: die geteilte Null-Senke
# cypher_stumm. Das echte Interface erst mit --ton-frei nach Andreas' Freigabe (§8, „Kein Ton ohne Frage“).
# --vor: der stumme Ausgang vor auf den Kern-Eingang notbahn_vor, die Notbahn rechnet vor dem Kern und hängt nicht an ihm (29.10.; vorher --kante, Probe 2026-09-25).
# Installation und Start gehören Scheibe 18 (cypherdj.target); diese Datei wird hier nur geliefert, nicht aktiviert.
[Unit]
Description=Cypher-DJ Notbahn (daneben)
PartOf=cypherdj.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/pw-jack -p 256 %h/cypher-dj/djk/notbahn/build/cypherdj-notbahn --master cypher_stumm:playback_F --daneben --vor cypherdj-kern:notbahn_vor
Restart=always
RestartSec=0
Nice=-5

[Install]
WantedBy=cypherdj.target
