#!/usr/bin/env node
// djk-fx (Beat-FX, SCHNITTSTELLEN §4.10, zwei Einheiten seit 2026-09-28): die Beat-FX aus der CLI, für die Welle. Meldet
// sich beim Kern an (/k/hallo), schickt /k/fx bzw. /k/fx/zuweisung mit Quelle cypher und wartet auf Quittung und /e/fx
// bzw. /e/fx/zuweisung. Ist der AUTO-Schalter der Seite aus (autonom.json im Erzeuger-Ordner), schickt es nichts (wie
// djk-muster). `aus` liest den Stand der Einheit von der Seite (GET /fx) und schickt ihn mit an 0. Nach dem Übernehmen
// schreibt es fx_von.json je Einheit (cypher): schaltet Andreas AUTO aus, lässt die Seite Cyphers Effekt auslaufen.
// Aufruf: djk-fx [--instanz i] [--einheit 1|2] <art> <beats> <depth> <param1> [param2] [param3]
//         djk-fx [--instanz i] [--einheit 1|2] zuweisen <A|B|C|C2|C3|L1|L2|M> <an|aus>
//         djk-fx [--instanz i] [--einheit 1|2] aus
//   art: echo flanger phaser filter · beats: 0.25 0.5 1 2 4 8 16 · depth, param1..3: 0 bis 1 (param2/3 Vorgabe 0,5,
//   ohne DSP-Wirkung, S8-Knöpfe 3/4) · Einheit Vorgabe 1
// Rückgabe 0 übernommen, 1 abgelehnt oder keine Antwort, 2 falscher Aufruf, 4 AUTO aus.
import dgram from 'node:dgram';
import fs from 'node:fs';
import path from 'node:path';
import { parseArgs } from 'node:util';
import { kodiere, dekodiere } from '../vertrag/attrappe_kern/osc.mjs';
import { autonomAn } from './src/muster_stand.mjs';

const AUFRUF = 'Aufruf: djk-fx [--instanz i] [--einheit 1|2] <echo|flanger|phaser|filter> <beats> <depth 0..1> <param1 0..1> [param2] [param3] | zuweisen <A|B|C|C2|C3|L1|L2|M> <an|aus> | aus';
const KANAL = { A: 'deck/1', B: 'deck/2', C: 'erz/1', C2: 'erz/2', C3: 'erz/3', L1: 'pad/1', L2: 'pad/2', M: 'master' };
const ARTEN = ['echo', 'flanger', 'phaser', 'filter'];
const BEATS = [0.25, 0.5, 1, 2, 4, 8, 16];
const raus = (text, rc) => { (rc ? process.stderr : process.stdout).write(`djk-fx: ${text}\n`); process.exit(rc); };

let opt, pos;
try {
  ({ values: opt, positionals: pos } = parseArgs({ allowPositionals: true, options: {
    instanz: { type: 'string', default: process.env.CYPHERDJ_INSTANZ ?? '' },
    einheit: { type: 'string', default: '1' },
    'kern-port': { type: 'string' },
    'seite-port': { type: 'string' },
    'erzeuger-ordner': { type: 'string' },
  } }));
} catch (e) { raus(`${e.message}\n${AUFRUF}`, 2); }
const I = opt.instanz;
if (I && !/^[a-i]$/.test(I)) raus(`Instanz ${I}: erlaubt sind a bis i`, 2);
const EINHEIT = Number(opt.einheit);
if (EINHEIT !== 1 && EINHEIT !== 2) raus(`Einheit ${opt.einheit}: 1 oder 2`, 2);
const V = I ? 1000 * (I.charCodeAt(0) - 96) : 0;
const KERN = Number(opt['kern-port'] ?? 47100 + V);
const SEITE = Number(opt['seite-port'] ?? 47300 + V);
const ERZ = opt['erzeuger-ordner'] ?? `/dev/shm/cypherdj${I ? `-${I}` : ''}/erzeuger`;
const anteil = (x) => x >= 0 && x <= 1;

if (!autonomAn(ERZ)) raus('AUTO ist aus, Andreas hat übernommen; nichts gesetzt', 4);

// von wem die Einheit ist (je Einheit ein Schlüssel, wie server.ts fxVon)
function fxVonCypher() {
  const datei = path.join(ERZ, 'fx_von.json');
  let stand = {};
  try { stand = JSON.parse(fs.readFileSync(datei, 'utf8')); } catch { /* noch keine Datei */ }
  if (typeof stand !== 'object' || stand === null || 'von' in stand) stand = {};   // altes flaches Format ersetzen
  stand[String(EINHEIT)] = { von: 'cypher', zeit: Date.now() };
  try { fs.mkdirSync(ERZ, { recursive: true }); fs.writeFileSync(datei, JSON.stringify(stand)); } catch { /* ohne Datei bleibt er stehen */ }
}

const id = BigInt(Date.now()) * 1000n + BigInt(process.pid % 1000);
let sendung, antwort, meldung;
if (pos.length === 1 && pos[0] === 'aus') {
  let stand;
  try { stand = await (await fetch(`http://127.0.0.1:${SEITE}/fx`)).json(); } catch (e) { raus(`Seite auf ${SEITE} nicht erreichbar: ${e.message}`, 1); }
  const f = Array.isArray(stand) ? stand[EINHEIT - 1] : null;
  if (!f || f.an !== 1) raus(`FX${EINHEIT} ist schon aus`, 0);
  sendung = ['/k/fx', 'hsiidddddi', [id, 'cypher', EINHEIT, f.art, f.beats, f.wet, f.param1, f.param2, f.param3, 0]];
  antwort = '/e/fx';
} else if (pos.length === 3 && pos[0] === 'zuweisen') {
  const kanal = KANAL[pos[1].toUpperCase()] ?? (Object.values(KANAL).includes(pos[1]) ? pos[1] : null);
  if (!kanal) raus(`Kanal ${pos[1]}: A B C C2 C3 L1 L2 M`, 2);
  if (pos[2] !== 'an' && pos[2] !== 'aus') raus(`${pos[2]}: an oder aus`, 2);
  sendung = ['/k/fx/zuweisung', 'hsisi', [id, 'cypher', EINHEIT, kanal, pos[2] === 'an' ? 1 : 0]];
  antwort = '/e/fx/zuweisung';
} else if (pos.length >= 4 && pos.length <= 6) {
  const [a, b, w, p1, p2 = '0.5', p3 = '0.5'] = pos;
  const art = ARTEN.indexOf(a.toLowerCase()) + 1;
  const beats = Number(b), wet = Number(w), param1 = Number(p1), param2 = Number(p2), param3 = Number(p3);
  if (art < 1) raus(`Art ${a}: ${ARTEN.join(' ')}`, 2);
  if (!BEATS.includes(beats)) raus(`Beats ${b}: ${BEATS.join(' ')}`, 2);
  if (![wet, param1, param2, param3].every(anteil)) raus('depth und param1..3: 0 bis 1', 2);
  sendung = ['/k/fx', 'hsiidddddi', [id, 'cypher', EINHEIT, art, beats, wet, param1, param2, param3, 1]];
  antwort = '/e/fx';
} else {
  raus(AUFRUF, 2);
}

const sock = dgram.createSocket('udp4');
const name = `djk-fx-${process.pid}`;
let angenommen = false, ende = false;
const fertig = (text, rc) => {
  if (ende) return;
  ende = true;
  sock.send(kodiere('/k/tschuess', 's', [name]), KERN, '127.0.0.1', () => { sock.close(); raus(text, rc); });
};
sock.on('message', (buf) => {
  let m;
  try { m = dekodiere(buf); } catch { return; }
  if (m.adresse === '/k/willkommen' && !angenommen) sock.send(kodiere(...sendung), KERN, '127.0.0.1');
  else if (m.adresse === '/q' && m.werte[0] === id) {
    const st = m.werte[2];
    if ([4, 6, 7, 8].includes(st)) fertig(`${sendung[0]} ${st === 6 ? 'abgelehnt' : `nicht ausgeführt (Status ${st})`}: ${m.werte[5]}`, 1);
    else angenommen = true;
  } else if (m.adresse === antwort && angenommen && m.werte[0] === EINHEIT) {
    fxVonCypher();
    if (antwort === '/e/fx') {
      const [, art, beats, wet, param1, , , an] = m.werte;
      fertig(`FX${EINHEIT} ${ARTEN[art - 1]?.toUpperCase() ?? art} ${an ? 'an' : 'aus'}, ${beats} Beat(s), depth ${wet.toFixed(2)}, param1 ${param1.toFixed(2)}`, 0);
    } else {
      const [, kanal, an] = m.werte;
      fertig(`FX${EINHEIT} ${an ? 'an' : 'ab'} ${kanal}`, 0);
    }
  }
});
sock.bind(0, '127.0.0.1', () => {
  sock.send(kodiere('/k/hallo', 'sii', [name, sock.address().port, 1]), KERN, '127.0.0.1');
  setTimeout(() => fertig(angenommen ? `${sendung[0]} angenommen, kein ${antwort}` : `keine Antwort vom Kern auf udp ${KERN}`, angenommen ? 0 : 1), 1500);
});
