# cypher-dj: personal paths. Copy to ~/.config/cypherdj/umgebung.env and uncomment the lines you need.
# djk-start and the web interface unit load this file (shell: set -a; . FILE; set +a / systemd: EnvironmentFile=-).
# Put values with spaces in "..." (works the same for shell and systemd).
# Every line is commented out on purpose: a placeholder path that is set counts as a real path (for example the
# library catalog would be built next to /path/to/mediathek.sqlite). Without a line the built-in default applies.

# Root of your music collection (folder with the MP3 files). Needed by djk/cues/server.ts (or --wurzel DIR).
#CYPHERDJ_MUSIK="/path/to/music"

# Traktor collection.nml. Optional (without it no Traktor sync in the cue tool; structure suggestion measurements need it).
#CYPHERDJ_NML="/path/to/collection.nml"

# Media library database (sqlite, read only). Optional (without it the media library routes answer 503 mediathek_fehlt;
# the catalog of djk-bibliothek then lives under ~/.local/share/cypherdj/mediathek/).
#CYPHERDJ_MEDIATHEK="/path/to/mediathek.sqlite"

# Sample source Battery (folder with the drum subfolders Kick, Snare ...), read by djk/sound/rollen.json as ${CYPHERDJ_KLANG_BATTERY}.
#CYPHERDJ_KLANG_BATTERY="/path/to/Battery4-Samples/Drums"

# Sample source Maschine (folder with the drum subfolders), read by djk/sound/rollen.json as ${CYPHERDJ_KLANG_MASCHINE}.
#CYPHERDJ_KLANG_MASCHINE="/path/to/Maschine_2_Library/Samples/Drums"

# Root of the Battery samples (one level above Drums). Optional, only for the bit-identity test in djk/generator/tests.
#CYPHERDJ_KLANG_BATTERY_SAMPLES="/path/to/Battery4-Samples"

# Python with demucs (testbench, load profile p1). Optional, only for test runs with profile p1.
#CYPHERDJ_DEMUCS_PYTHON="/path/to/venv/bin/python"

# Lock file of the real-time measurement runs (flock in the measurement and acceptance scripts). Optional; default without
# this line: ${XDG_RUNTIME_DIR:-/tmp}/cypherdj-echtzeit.lock. Several users of one machine who should exclude each other set the same path.
#CYPHERDJ_ECHTZEIT_SCHLOSS="/tmp/cypherdj-echtzeit.lock"
