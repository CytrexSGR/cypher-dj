#!/usr/bin/env bash
# djk-instrumente: Surge-XT-Instrumente (Carla-Wirte, ADR 009) an ein LAUFENDES Studio hängen, ohne Kern, Notbahn,
# Leitstand, Seite oder Drums (erzeuger1) anzuhalten. Andreas 2026-10-03: „in einer live session muss man auch andere
# dinge laden können". djk-start --instrumente ruft denselben Weg mit --nur-wirte.
#
# Aufruf: djk-instrumente [--instanz a..i] [--nur-wirte] [--melodie surge|fluegel|baukasten] [--bass surge|rb338]
#         djk-instrumente [--instanz a..i] --arr1 [--arr2]
#         djk-instrumente [--instanz a..i] --arr2
#         djk-instrumente [--instanz a..i] start arr1|arr2 surge|plugin:<format>:<pfad>#<uid>
#   --bass rb338 (RB-338 W1): der Bass-Wirt spielt die eigene 303 (VST3 aus djk/instruments, install.sh) statt Surge.
#   Ohne --bass bleibt der Bass-Wirt, wie er läuft (läuft er nicht: Surge). klang/fahre gibt es nur mit Surge; rb338 kennt param.
#   --melodie fluegel (Glanz Welle 4): der Melodie-Wirt spielt den Flügel (Carla-SFZ, hosts/carla/instrument_build.py,
#   baut ~/.config/cypherdj/instrumente/grand beim ersten Mal) statt Surge. Läuft der Wirt schon in der anderen Art, wird
#   nur er neu gestartet; seine Kanten bleiben (gleicher Klientname). Ohne --melodie bleibt die Melodie, wie die Status-Datei sagt (keine Datei: Surge). klang/fahre gibt es nur mit Surge.
#   --melodie baukasten (Baukasten S1): der Melodie-Wirt spielt Cypher Modular (VST3 aus djk/instruments, install.sh
#   baukasten). Den Graphen liest das Plugin bei jedem Start des Wirts aus ~/.config/cypherdj<-i>/baukasten-melodie.json
#   (fehlt die Datei: eingebauter Graph; ist sie fehlerhaft: eingebauter Graph und eine Zeile "graph rejected" im Journal
#   der Unit). Neuer Graph = Datei schreiben, dann systemctl --user restart cypherdj-wirt-melodie<-i>.
#   Schritte, je Gruppe (bass: midi_aus_1 -> erz/2, melodie: midi_aus_2 -> erz/3), jeder idempotent:
#   1 Wirt-Unit cypherdj-wirt-<g> starten (läuft sie schon: übersprungen), auf "bereit" warten.
#   2 Kanten midi_aus -> Wirt, Wirt -> rueck_erz_<n>_L/R verbinden und in /dev/shm/cypherdj<i>/kanten anhängen; der Kern
#     liest die Datei bei Änderung neu (kern main.cpp lade_kanten_datei) und verbindet nach Neustarts nach.
#   3 (ohne --nur-wirte) erzeuger2/erzeuger3 ohne --ziel midi:… mit derselben Befehlszeile plus --ziel neu starten. Das
#     Muster bleibt (Datei im Erzeuger-Ordner), es klingt ab dem nächsten Takt über Surge statt über das Kit. Die
#     anderen Units werden nicht angefasst.
#   --arr1 (D1, Spec 2.4): NUR der Produktions-Slot 1, ein Surge-Wirt für die Instrument-Spur des Arrangements. Eigene
#   Unit cypherdj-wirt-arr1<-i>, Status /dev/shm/cypherdj<-i>/wirt-arr1.json, Socket wirt-arr1.sock, Klang
#   ~/.config/cypherdj<-i>/klang-arr1.fxp. Kanten arr_midi_1 -> Wirt -> arr_rueck_1_L/R in der Kanten-Datei. Fehlen
#   nach "bereit" die eigenen Ports des Wirts, ist das ein Fehler (Rückgabe 5). Fehlt ein Kern-Port (der laufende Kern ist
#   älter als D1 K2b), wird die Kante nur eingetragen und das so gemeldet; ein Kern ab D1 K2b hat die Ports arr_midi_1 und
#   arr_rueck_1_L/R und verbindet die Kanten aus der Datei selbst (filtere_kanten). bass, melodie, erz/1-3, Studio-Ströme und Erzeuger bleiben unberührt;
#   idempotent wie die anderen Gruppen. djk-stop räumt den Wirt ab.
#   --arr2 (1.9, L10): der zweite Produktions-Slot, genau wie --arr1 (Unit cypherdj-wirt-arr2<-i>, Status wirt-arr2.json, Socket wirt-arr2.sock, Klang
#   klang-arr2.fxp, Kanten arr_midi_2 -> Wirt -> arr_rueck_2_L/R). --arr1 --arr2 zusammen startet beide Slots in einem Aufruf.
#   start <arr1|arr2> <surge|plugin:<format>:<pfad>#<uid>> (plan 1.11 task 16): start ONE production slot, with Surge (same as
#   --arrN) or with a foreign plugin instrument. <format> is vst3 or lv2 (LV2: path = URI, uid may be empty: plugin:lv2:<uri>#;
#   the identity always ends in '#'). Same unit name, status file, socket and edges as the Surge slot; the host runs
#   `instrument_host.py --instrument <format>:<pfad>#<uid>` (loads the plugin at start, no empty rack: an instrument's latency is
#   measured like Surge's) with the REAL HOME, DISPLAY and XAUTHORITY (D16: plugin editors need the user's X session).
#   Status file: art "plugin" plus kennung "<format>:<pfad>#<uid>" (art alone would read as Surge). The plugin must exist
#   (VST3 bundle / LV2 URI on the LV2 path) or exit 2 "not loadable", nothing started. A plugin without a MIDI input is no
#   instrument: the host exits 2 with "kein_instrument" and this script exits 2 with that reason (no restart loop, no edges).
#   Running the slot with the same plugin again does nothing; with another plugin or `surge` only its host is swapped. A plain
#   --arrN leaves a running plugin host as it is (like --bass without a value keeps the RB-338).
# Rückgabe: 0 Instrumente hängen, 2 Aufruf/Aufbau (kein Kern, kein Surge), 5 ein Schritt scheiterte (Bericht auf stderr;
# Gestartetes bleibt stehen, djk-stop räumt ab).
set -uo pipefail
# Aus der Hand (MCP über stdio) kommt eine abgespeckte Umgebung ohne Laufzeit-Ordner und Sitzungsbus: ohne sie sehen
# systemctl --user und pw-link nichts (gemessen 2026-10-03, „kern is not running" bei laufendem Kern).
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
HIER=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
DJK=${DJK:-$(cd "$HIER/.." && pwd)}
I=${CYPHERDJ_INSTANZ:-}; NUR_WIRTE=0; MELODIE=; BASS=; ARR1=0; ARR2=0
START=0; POS=(); ARRSPEC_1=; ARRSPEC_2=
while [ $# -gt 0 ]; do
  case "$1" in
    --instanz) [ $# -ge 2 ] || { echo "djk-instrumente: --instanz needs a value" >&2; exit 2; }; I=$2; shift 2;;
    --nur-wirte) NUR_WIRTE=1; shift;;
    --arr1) ARR1=1; shift;;
    --arr2) ARR2=1; shift;;
    start) if [ "$START" = 0 ] && [ ${#POS[@]} = 0 ]; then START=1; shift; else echo "djk-instrumente: unknown option start (see --help)" >&2; exit 2; fi;;
    --melodie) [ $# -ge 2 ] || { echo "djk-instrumente: --melodie needs surge, fluegel or baukasten" >&2; exit 2; }; MELODIE=$2; shift 2;;
    --bass) [ $# -ge 2 ] || { echo "djk-instrumente: --bass needs surge or rb338" >&2; exit 2; }; BASS=$2; shift 2;;
    -h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0;;
    *) if [ "$START" = 1 ]; then POS+=("$1"); shift; else echo "djk-instrumente: unknown option $1 (see --help)" >&2; exit 2; fi;;
  esac
done
if [ "$START" = 1 ]; then
  [ ${#POS[@]} -ge 2 ] || { echo "djk-instrumente: start needs <arr1|arr2> <surge|plugin:<format>:<path>#<uid>>" >&2; exit 2; }
  [ ${#POS[@]} -le 2 ] || { echo "djk-instrumente: start: unexpected argument '${POS[2]}'" >&2; exit 2; }
  case "${POS[0]}" in arr1) ARR1=1;; arr2) ARR2=1;; *) echo "djk-instrumente: start: group '${POS[0]}' must be arr1 or arr2" >&2; exit 2;; esac
  case "${POS[1]}" in
    surge) ;;
    plugin:*)
      PSPEC=${POS[1]#plugin:}; PFMT=${PSPEC%%:*}; PREST=${PSPEC#*:}
      { [ -n "$PSPEC" ] && [ "$PREST" != "$PSPEC" ] && [ -n "$PREST" ]; } || { echo "djk-instrumente: start: plugin '${POS[1]}' is not plugin:<format>:<path>#<uid>" >&2; exit 2; }
      case "$PFMT" in
        vst3) PPFAD=${PREST%#*}; [ -e "$PPFAD" ] || { echo "djk-instrumente: plugin not loadable: VST3 '$PPFAD' does not exist" >&2; exit 2; };;
        lv2)
          PPFAD=${PREST%#*}
          # a manifest names a plugin as <uri> or, as the LSP and Dragonfly bundles do, as prefix:name with an @prefix line
          python3 - "$PPFAD" /usr/lib/lv2 /usr/local/lib/lv2 "$HOME/.lv2" "$HOME/.local/lib/cypherdj/lv2" <<'PY' || { echo "djk-instrumente: plugin not loadable: LV2 URI '$PPFAD' not found on the LV2 path" >&2; exit 2; }
import glob, os, re, sys
uri = sys.argv[1]
for d in sys.argv[2:]:
    for m in glob.glob(os.path.join(d, "*", "manifest.ttl")):
        try:
            t = open(m, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        if f"<{uri}>" in t:
            sys.exit(0)
        for pre, base in re.findall(r"@prefix\s+([A-Za-z0-9_-]*):\s*<([^>]*)>", t):
            if uri.startswith(base) and re.search(r"(?<![\w:])" + re.escape(pre + ":" + uri[len(base):]) + r"(?![\w-])", t):
                sys.exit(0)
sys.exit(1)
PY
          ;;
        *) echo "djk-instrumente: start: plugin format '$PFMT' unknown, use vst3 or lv2" >&2; exit 2;;
      esac;;
    *) echo "djk-instrumente: start: '${POS[1]}' must be surge or plugin:<format>:<path>#<uid>" >&2; exit 2;;
  esac
  [ "${POS[0]}" = arr1 ] && ARRSPEC_1=${POS[1]}
  [ "${POS[0]}" = arr2 ] && ARRSPEC_2=${POS[1]}
fi
case "$MELODIE" in ""|surge|fluegel|baukasten) ;; *) echo "djk-instrumente: --melodie '$MELODIE' invalid, use surge, fluegel or baukasten" >&2; exit 2;; esac
case "$BASS" in ""|surge|rb338) ;; *) echo "djk-instrumente: --bass '$BASS' invalid, use surge or rb338" >&2; exit 2;; esac
if [ "$ARR1$ARR2" != 00 ] && [ -n "$MELODIE$BASS" ]; then
  echo "djk-instrumente: --arr1/--arr2 are production slots only; --bass and --melodie belong to the DJ instruments (separate call)" >&2; exit 2
fi
RB338_VST3="$HOME/.local/lib/cypherdj/vst3/rb338.vst3"
if [ "$BASS" = rb338 ] && [ ! -d "$RB338_VST3" ]; then echo "djk-instrumente: rb338 missing (djk/instruments/install.sh)" >&2; exit 2; fi
BAUKASTEN_VST3="$HOME/.local/lib/cypherdj/vst3/baukasten.vst3"
if [ "$MELODIE" = baukasten ] && [ ! -d "$BAUKASTEN_VST3" ]; then echo "djk-instrumente: baukasten missing (djk/instruments/install.sh baukasten)" >&2; exit 2; fi
FLUEGEL_SFZ="$HOME/.config/cypherdj/instrumente/grand/grand.sfz"
case "$I" in "") SFX="";; [a-i]) SFX="-$I";; *) echo "djk-instrumente: instance '$I' invalid, use a..i or empty" >&2; exit 2;; esac
KERN_CLIENT=cypherdj-kern$SFX
KANTEN_DATEI="/dev/shm/cypherdj$SFX/kanten"
aktiv() { [ "$(systemctl --user is-active "$1.service" 2>/dev/null)" = active ]; }
fehler() { echo "djk-instrumente: $1" >&2; [ -n "${2:-}" ] && journalctl --user -u "$2.service" -n 12 --no-pager -o cat 2>/dev/null | sed 's/^/    | /' >&2; exit 5; }

aktiv "cypherdj-kern$SFX" || { echo "djk-instrumente: kern cypherdj-kern$SFX is not running (start the studio with djk-start${I:+ --instanz $I} --strudel)" >&2; exit 2; }
# Die DJ-Instrumente hängen an den MIDI-Strömen des Kerns; die Produktions-Slots nicht (ihre Ports prüft die Kanten-Schleife)
if [ "$ARR1$ARR2" = 00 ]; then
  pw-link -o 2>/dev/null | grep -qx "$KERN_CLIENT:midi_aus_1" || { echo "djk-instrumente: $KERN_CLIENT:midi_aus_1 missing (kern without MIDI streams?)" >&2; exit 2; }
fi
[ -f "$KANTEN_DATEI" ] || : > "$KANTEN_DATEI"
if [ "$MELODIE" = fluegel ] && [ ! -f "$FLUEGEL_SFZ" ]; then
  python3 "$DJK/hosts/carla/instrument_build.py" --ziel "$(dirname "$FLUEGEL_SFZ")" --name grand >/dev/null \
    || { echo "djk-instrumente: grand piano could not be built (hosts/carla/instrument_build.py; Ableton Core Library missing?)" >&2; exit 2; }
fi

W_IN=events-in; W_OUT1=audio-out1; W_OUT2=audio-out2
SD="$HOME/.local/share/cypherdj/surge-daten/usr/share/surge-xt"; mkdir -p "$HOME/.config/cypherdj$SFX"
# Gruppe:Kern-MIDI-Ausgang:Kern-Rückweg (ohne _L/_R)
GRUPPEN="bass:midi_aus_1:rueck_erz_2 melodie:midi_aus_2:rueck_erz_3"
if [ "$ARR1$ARR2" != 00 ]; then
  GRUPPEN=""; ARR_GRUPPEN=""
  [ "$ARR1" = 1 ] && { GRUPPEN="arr1:arr_midi_1:arr_rueck_1"; ARR_GRUPPEN="arr1"; }
  [ "$ARR2" = 1 ] && { GRUPPEN="$GRUPPEN arr2:arr_midi_2:arr_rueck_2"; ARR_GRUPPEN="$ARR_GRUPPEN arr2"; }
fi
ist_arr() { [ "$1" = arr1 ] || [ "$1" = arr2 ]; }
ARR_KERN_FEHLT=""   # production groups whose kern-side ports are missing (list of group names)
# $1 -o (Ausgänge) oder -i (Eingänge). The list is read first and searched afterwards: under pipefail, `pw-link | grep -q` returns 141 (SIGPIPE) when
# grep leaves at the first match while pw-link is still writing, and a port that exists is reported missing (ledger D33; 1.9 U3 acceptance run 1).
port_da() { local liste; liste=$(pw-link "$1" 2>/dev/null); grep -qxF -- "$2" <<<"$liste"; }
# the own ports of a host show a moment after "bereit" (the status file is written first): wait up to 5 s for them
port_warte() { local _; for _ in $(seq 20); do port_da "$1" "$2" && return 0; sleep 0.25; done; return 1; }
for g in $GRUPPEN; do
  G=${g%%:*}; R=${g#*:}; MIDI=${R%%:*}; RUECK=${R#*:}
  U="cypherdj-wirt-$G$SFX"; C="cypherdj-wirt-$G$SFX"; ST="/dev/shm/cypherdj$SFX/wirt-$G.json"
  ART=lv2; [ "$G" = melodie ] && [ "$MELODIE" = fluegel ] && ART=sfz:grand
  [ "$G" = melodie ] && [ "$MELODIE" = baukasten ] && ART=vst3:baukasten
  [ "$G" = bass ] && [ "$BASS" = rb338 ] && ART=vst3:rb338
  # Art laut Status-Datei (fehlt sie oder hat sie kein "art" = vor Welle 4: lv2); gilt auch, wenn der Wirt tot ist
  IST=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("art","lv2"))' "$ST" 2>/dev/null || echo lv2)
  # Bass ohne --bass bleibt, wie er war (hand.ts und djk-start rufen ohne --bass; kein stilles Zurücktauschen der RB-338,
  # auch nicht nach einem toten Wirt oder einem Studio-Neustart: die Status-Datei entscheidet)
  [ "$G" = bass ] && [ -z "$BASS" ] && ART=$IST
  [ "$G" = melodie ] && [ -z "$MELODIE" ] && ART=$IST  # dasselbe für die Melodie (Review X2: Flügel kippte auf Surge)
  # production slots with a plugin instrument (task 16): `start <slot> plugin:...` names it, `start <slot> surge` names Surge, a plain
  # --arrN keeps a RUNNING plugin host (taking the plugin from its status file) and otherwise means Surge
  PS=""; KENN=""
  if ist_arr "$G"; then
    eval "SPEC=\$ARRSPEC_${G#arr}"
    KENN=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("kennung",""))' "$ST" 2>/dev/null || echo "")
    case "$SPEC" in
      plugin:*) PS=${SPEC#plugin:};;
      "") if aktiv "$U" && [ "$IST" = plugin ] && [ -n "$KENN" ]; then PS=$KENN; fi;;
    esac
    [ -n "$PS" ] && ART=plugin
  fi
  if aktiv "$U"; then  # läuft er in der anderen Art, nur ihn tauschen
    if [ "$IST" != "$ART" ] || { [ "$ART" = plugin ] && [ "$KENN" != "$PS" ]; }; then
      systemctl --user stop "$U.service" || fehler "wirt $G: stop failed" "$U"
      for _ in $(seq 50); do systemctl --user list-units --all --no-legend --plain "$U.service" | grep -q . || break; sleep 0.1; done
      echo "  wirt $G    $IST stopped, switching to $ART"
    fi
  fi
  if aktiv "$U"; then
    echo "  wirt $G    already running"
  else
    # Die Art kann auch aus der Status-Datei kommen (Review R1): fehlt das Bundle dann, sofort melden statt 30 s auf "bereit" zu warten
    if [ "$ART" = vst3:rb338 ] && [ ! -d "$RB338_VST3" ]; then
      echo "djk-instrumente: wirt $G was rb338 (status file) but rb338 is missing (djk/instruments/install.sh, or --bass surge)" >&2; exit 2
    fi
    if [ "$ART" = vst3:baukasten ] && [ ! -d "$BAUKASTEN_VST3" ]; then
      echo "djk-instrumente: wirt $G was baukasten (status file) but baukasten is missing (djk/instruments/install.sh baukasten, or --melodie surge)" >&2; exit 2
    fi
    # Surge XT ist nur nötig, wenn diese Gruppe wirklich Surge startet (rb338 und Flügel brauchen es nicht)
    if [ "$ART" = lv2 ] && [ ! -f "$HOME/.local/lib/cypherdj/lv2/Surge XT.lv2/manifest.ttl" ]; then
      echo "djk-instrumente: Surge XT missing (djk/hosts/carla/install_surge.sh)" >&2; exit 2
    fi
    # Eine tote, noch geladene Unit (failed, ohne --collect-Abräumung) blockiert den Namen: zurücksetzen.
    systemctl --user reset-failed "$U.service" 2>/dev/null
    rm -f "$ST"
    WH="$HOME/.local/state/cypherdj/wirt-$G$SFX"; mkdir -p "$WH/.local/share"
    if [ -d "$SD" ]; then ln -sfn "$SD" "$WH/.local/share/surge-xt"; fi
    if [ "$ART" = plugin ]; then
      INSTR_ARGS=(--instrument "$PS")
    elif [ "$ART" = lv2 ]; then
      INSTR_ARGS=(--lv2 https://surge-synthesizer.github.io/lv2/surge-xt --lv2-pfad "$HOME/.local/lib/cypherdj/lv2"
                  --aktiv "$HOME/.config/cypherdj$SFX/klang-$G.fxp")
    elif [ "$ART" = vst3:rb338 ]; then
      INSTR_ARGS=(--vst3 "$RB338_VST3")
    elif [ "$ART" = vst3:baukasten ]; then
      INSTR_ARGS=(--vst3 "$BAUKASTEN_VST3")
    else
      INSTR_ARGS=(--sfz "$FLUEGEL_SFZ")
    fi
    # Der Graph des Baukastens liegt unter dem echten HOME (der Wirt läuft mit HOME=$WH): Pfad als Variable mitgeben, immer,
    # auch wenn die Datei noch fehlt; die Umgebung einer transienten Unit steht beim Anlegen fest, ein Neustart liest sie neu
    GRAPH_ENV=()
    # a plugin host runs with the real HOME (the plugin's own config, presets, licences) and the user's X session (D16); the unit's
    # environment is fixed at creation: DISPLAY and XAUTHORITY from here or the user manager
    HOME_ENV=(--setenv=HOME="$WH"); PLUG_ENV=()
    # Surge (lv2) keeps its private HOME but gets the same display: its own editor window (command `fenster`, plan 2026-11-11 task 9)
    # needs the user's X session; without DISPLAY the host answers keine_anzeige and shows nothing
    [ "$ART" = plugin ] && HOME_ENV=(--setenv=HOME="$HOME")
    if [ "$ART" = plugin ] || [ "$ART" = lv2 ]; then
      for v in DISPLAY XAUTHORITY; do
        w=${!v:-}
        [ -n "$w" ] || w=$(systemctl --user show-environment 2>/dev/null | sed -n "s/^$v=//p" | head -1)
        [ -n "$w" ] && PLUG_ENV+=("--setenv=$v=$w")
      done
    fi
    [ "$ART" = vst3:baukasten ] && GRAPH_ENV=(--setenv=CYPHERDJ_BAUKASTEN_GRAPH="$HOME/.config/cypherdj$SFX/baukasten-$G.json")
    systemd-run --user --quiet --collect --unit="$U" -p Restart=always -p RestartSec=2 -p RestartPreventExitStatus=2 \
      -p PartOf=cypherdj.target "${HOME_ENV[@]}" "${GRAPH_ENV[@]}" "${PLUG_ENV[@]}" \
      --setenv=PIPEWIRE_PROPS="{ node.async = true node.group = cypherdj$SFX node.lock-quantum = true }" \
      /usr/bin/pw-jack -p 256 /usr/bin/python3 "$DJK/hosts/carla/instrument_host.py" --name "$C" "${INSTR_ARGS[@]}" --status "$ST" \
      --sock "/dev/shm/cypherdj$SFX/wirt-$G.sock" \
      || fehler "wirt $G: systemd-run failed" "$U"
    for _ in $(seq 60); do
      grep -q '"bereit": true' "$ST" 2>/dev/null && break
      # a plugin host that ends by itself (exit 2: kein_instrument, nicht_ladbar) has written its reason to the status file
      [ "$ART" = plugin ] && [ -s "$ST" ] && ! aktiv "$U" && break
      sleep 0.5
    done
    if [ "$ART" = plugin ] && ! grep -q '"bereit": true' "$ST" 2>/dev/null && [ -s "$ST" ] && ! aktiv "$U"; then
      mapfile -t R < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); f=d.get("fehler") or []; print(1 if any(x in ("nicht_ladbar","kein_instrument") for x in f) else 0); print((f[-1] if f else "unknown") + ": " + str(d.get("grund") or ""))' "$ST" 2>/dev/null)
      systemctl --user reset-failed "$U.service" 2>/dev/null; rm -f "$ST" "/dev/shm/cypherdj$SFX/wirt-$G.sock"
      if [ "${R[0]:-0}" = 1 ]; then echo "djk-instrumente: wirt $G: plugin rejected: ${R[1]:-unknown}" >&2; exit 2; fi
      echo "djk-instrumente: wirt $G exited before ready: ${R[1]:-unknown}" >&2; exit 5
    fi
    grep -q '"bereit": true' "$ST" 2>/dev/null || fehler "wirt $G not ready ($ST)" "$U"
    echo "  wirt $G    started ($ART${PS:+ $PS})"
  fi
  # Kanten: verbinden (eine schon bestehende meldet pw-link als Fehler, deshalb vorher prüfen) und festhalten
  for k in "$KERN_CLIENT:$MIDI	$C:$W_IN" "$C:$W_OUT1	$KERN_CLIENT:${RUECK}_L" "$C:$W_OUT2	$KERN_CLIENT:${RUECK}_R"; do
    Q=${k%%	*}; Z=${k#*	}
    if ist_arr "$G"; then
      # eigene Ports des Wirts müssen nach "bereit" da sein; nur die Kern-Seite darf fehlen (Kern älter als K2b)
      for pp in "-o $Q" "-i $Z"; do
        case "${pp#* }" in "$C":*) port_warte ${pp%% *} "${pp#* }" || fehler "wirt $G: own port ${pp#* } missing after ready ($ST)" "$U";; esac
      done
    fi
    if ist_arr "$G" && ! { port_da -o "$Q" && port_da -i "$Z"; }; then
      case " $ARR_KERN_FEHLT " in *" $G "*) ;; *) ARR_KERN_FEHLT="$ARR_KERN_FEHLT $G";; esac
      echo "  wirt $G    $Q -> $Z: edge recorded in kanten, not linked (the running kern has no production ports, older than D1 K2b)"
    else
      pw-link -l | grep -A8 -x "$Q" | grep -q -- "|-> *$Z\$" || pw-link "$Q" "$Z" || fehler "wirt $G: link $Q -> $Z failed" "$U"
    fi
    # flock auf dem Ordner: dieselbe Sperre nimmt die Oberfläche, wenn sie ihre Vorhörer-Zeilen entfernt (prelisten.ts unterSperre);
    # sonst ginge eine hier angehängte Zeile zwischen Lesen und rename dort verloren (S7-Re-Review F3)
    flock -x -w 5 "$(dirname "$KANTEN_DATEI")" sh -c 'grep -qxF -- "$2" "$1" 2>/dev/null || printf "%s\n" "$2" >> "$1"' sh "$KANTEN_DATEI" "$k" || fehler "wirt $G: kanten lock failed" "$U"
  done
done
if [ "$ARR1$ARR2" != 00 ]; then
  for g in $ARR_GRUPPEN; do
    n=${g#arr}
    if [[ " $ARR_KERN_FEHLT " == *" $g "* ]]; then
      echo "production slot $n: wirt ready, edges recorded in $KANTEN_DATEI; the running kern is older than D1 K2b (no arr ports): restart the studio (djk-stop, djk-start) and the kern links them"
    else
      eval "SPEC=\$ARRSPEC_$n"; WAS=Surge; case "$SPEC" in plugin:*) WAS="plugin ${SPEC#plugin:}";; esac
      [ "$SPEC" = "" ] && [ "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("art",""))' "/dev/shm/cypherdj$SFX/wirt-$g.json" 2>/dev/null)" = plugin ] && WAS=plugin
      echo "production slot $n live: $KERN_CLIENT:arr_midi_$n -> $WAS -> arr_rueck_${n}_L/R (edges in $KANTEN_DATEI)"
    fi
  done
  exit 0
fi
[ "$NUR_WIRTE" = 1 ] && exit 0

# 3 Erzeuger 2/3 auf MIDI umsetzen: Befehlszeile aus der laufenden Unit (sie ist die Wahrheit über Kit, Ports, Pfade).
for e in 2:1 3:2; do
  N=${e%%:*}; P=${e#*:}; U="cypherdj-erzeuger$N$SFX"; ZIEL="midi:$P:1"
  if ! aktiv "$U"; then echo "  erzeuger$N  not running, skipped (start the studio with --strudel)"; continue; fi
  ARGV=$(systemctl --user show -p ExecStart --value "$U.service" | sed -n 's/.*argv\[\]=\([^;]*\) ;.*/\1/p' | head -1)
  [ -n "$ARGV" ] || fehler "erzeuger$N: cannot read its command line" "$U"
  if [[ " $ARGV " == *" --ziel $ZIEL "* ]]; then echo "  erzeuger$N  already on $ZIEL"; continue; fi
  read -r -a A <<< "$ARGV"
  [[ " $ARGV " == *" --ziel "* ]] && fehler "erzeuger$N runs with a different --ziel ($ARGV); not touched" ""
  ABO=""; for ((j = 0; j < ${#A[@]}; j++)); do [ "${A[j]}" = --abo-port ] && ABO=${A[j+1]}; done
  systemctl --user stop "$U.service" || fehler "erzeuger$N: stop failed" "$U"
  for _ in $(seq 50); do systemctl --user list-units --all --no-legend --plain "$U.service" | grep -q . || break; sleep 0.1; done
  systemd-run --user --quiet --collect --unit="$U" ${I:+--setenv=CYPHERDJ_INSTANZ=$I} \
    -p Restart=always -p RestartSec=1 -p RestartPreventExitStatus=2 -p PartOf=cypherdj.target \
    "${A[@]}" --ziel "$ZIEL" || fehler "erzeuger$N: restart failed" "$U"
  if [ -n "$ABO" ]; then
    for _ in $(seq 100); do [ -n "$(ss -Hlnu "sport = :$ABO" 2>/dev/null)" ] && break; sleep 0.1; done
    [ -n "$(ss -Hlnu "sport = :$ABO" 2>/dev/null)" ] || fehler "erzeuger$N does not listen on udp $ABO after restart" "$U"
  fi
  echo "  erzeuger$N  now plays into $ZIEL (pattern kept)"
done
echo "instruments live: bass midi_aus_1 -> erz/2, melody midi_aus_2 -> erz/3 · sounds: djk/hosts/carla/djk-klang${I:+ --instanz $I} bass|melodie lade NAME"
