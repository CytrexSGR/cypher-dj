#!/usr/bin/env -S python3 -I
"""djk-bericht: entry of `cypher-dj report` (see report.py). Run with -I, so the package path is added here, from this file's place."""
import os
import sys

HIER = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HIER)
sys.path.insert(0, os.path.dirname(HIER))

import report as bericht  # noqa: E402

if __name__ == "__main__":
    sys.exit(bericht.main(sys.argv[1:]))
